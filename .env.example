# API của hoavan-hsk-server (Go). Chỉ cần host + port, không có /api/v1.
# Có giá trị: form đăng ký tư vấn POST lên {PUBLIC_API_BASE}/api/v1/leads.
# Bỏ trống: form mở sẵn email gửi về hộp thư của trung tâm.
#
# Vì landing build tĩnh, biến này được nhúng lúc build — đổi giá trị thì phải
# build lại. Origin của landing cũng phải nằm trong CORS_ORIGINS của server.
PUBLIC_API_BASE=http://localhost:9909

# Ghi đè endpoint nhận đăng ký (tuỳ chọn). Chỉ dùng khi cần trỏ sang một URL
# khác hẳn PUBLIC_API_BASE, ví dụ staging hoặc một form service ngoài.
PUBLIC_REGISTER_ENDPOINT=

# API nội dung của trang quản trị (hoavan-hsk-admin).
# Có giá trị: lúc build sẽ lấy nội dung thư viện từ cơ sở dữ liệu của admin.
# Bỏ trống: dùng bản chụp trong content/site.json.
PUBLIC_CONTENT_API=http://localhost:3000/console

# Endpoint đăng nhập khu vực học viên (tuỳ chọn).
# Bỏ trống: form báo hệ thống chưa mở thay vì gửi đi.
PUBLIC_LOGIN_ENDPOINT=
