# API của hoavan-hsk-server (Go). Chỉ cần host + port, không có /api/v1.
# Có giá trị: form đăng ký tư vấn POST lên {PUBLIC_API_BASE}/api/v1/leads.
# Bỏ trống: form mở sẵn email gửi về hộp thư của trung tâm.
#
# Biến này chạy trong TRÌNH DUYỆT nên được nhúng lúc build — đổi giá trị thì phải
# build lại. Nếu API ở origin khác thì origin của landing phải nằm trong
# CORS_ORIGINS của server.
#
# Production dùng "/" (cùng origin, nginx của domain proxy /api/ về server Go)
# và đặt trong .env.production hoặc build-arg — xem README mục "Build production".
PUBLIC_API_BASE=http://localhost:9909

# Ghi đè endpoint nhận đăng ký (tuỳ chọn). Chỉ dùng khi cần trỏ sang một URL
# khác hẳn PUBLIC_API_BASE, ví dụ staging hoặc một form service ngoài.
PUBLIC_REGISTER_ENDPOINT=

# API nội dung — Go server (hoavan-hsk-server). Chỉ cần host + port.
#
# KHÔNG có tiền tố PUBLIC_: lời gọi này chạy ở phía server (Astro SSR) nên được đọc
# LÚC CHẠY, đổi giá trị chỉ cần restart chứ không phải build lại. Trên VPS nên trỏ
# thẳng 127.0.0.1:9909 cho khỏi đi vòng qua nginx.
#
# Có giá trị: trang lấy toàn bộ nội dung + các trang động từ trang quản trị, cache
#   60 giây (xem src/data/refresh.ts).
# Bỏ trống: dùng bản chụp trong content/site.json, bỏ qua các trang động.
CONTENT_API=http://localhost:9909

# Bản dự phòng CŨ của CONTENT_API, đọc lúc build. Giữ để cấu hình cũ vẫn chạy;
# cái mới dùng CONTENT_API ở trên.
PUBLIC_CONTENT_API=

# Endpoint đăng nhập khu vực học viên (tuỳ chọn).
# Bỏ trống: form báo hệ thống chưa mở thay vì gửi đi.
PUBLIC_LOGIN_ENDPOINT=
