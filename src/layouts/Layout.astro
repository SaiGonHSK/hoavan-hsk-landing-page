---
import "@/styles/global.css";
import Lightbox from "@/components/Lightbox.astro";
import { site, contact } from "@/data/site";
import { contentUpdatedAt } from "@/data/content";
import { keywordString } from "@/lib/seo";
import { canonicalUrl, enrollActionSchema, graph, speakable } from "@/lib/schema";
import classroom from "@/assets/facility/classroom.webp";
import facility1 from "@/assets/facility/facility-1.webp";
import facility2 from "@/assets/facility/facility-2.webp";

interface Props {
  title?: string;
  description?: string;

  image?: string;

  ogType?: string;

  noindex?: boolean;

  schemas?: Record<string, unknown>[];

  preloadImage?: string;

  /** Từ khoá riêng của trang, xếp trước bộ từ khoá chung. */
  keywords?: string;
}

const {
  title = `Trung tâm tiếng Trung TPHCM — luyện thi HSK | SaigonHSK`,
  description = site.description,
  // JPEG 1200×630 sinh bởi `yarn gen:og` — Zalo và Facebook đều đọc được.
  image = "/images/og-default.jpg",
  ogType = "website",
  noindex = false,
  schemas = [],
  preloadImage,
  keywords,
} = Astro.props;

// Quy tắc bỏ dấu `/` cuối nằm trong `canonicalUrl` để `@id` của các node loại trang
// (ContactPage, AboutPage…) trỏ đúng vào node `WebPage` sinh ở dưới.
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["EducationalOrganization", "LocalBusiness"],
  "@id": `${canonical.origin}/#organization`,
  name: site.fullName,
  // Người học gõ tên trung tâm theo rất nhiều cách; khai báo hết để Google gộp
  // về cùng một thực thể thay vì coi là các thương hiệu khác nhau.
  alternateName: [
    site.shortName,
    "Hoa văn SaigonHSK",
    "SaigonHSK",
    "Trung tâm tiếng Trung SaigonHSK",
    "Saigon HSK",
    // Không dấu — phủ cách gõ phổ biến trên mobile và Cốc Cốc
    "trung tam hoc tieng trung tphcm",
    "trung tam tieng trung sai gon",
  ],
  slogan: `${site.slogan} — ${site.sloganVi}`,
  description: site.description,
  url: canonical.origin,
  logo: {
    "@type": "ImageObject",
    url: new URL("/favicon.png", Astro.site).href,
    width: 192,
    height: 192,
  },
  /*
    Google Business Profile/Local ưu tiên nhiều ảnh thật của cơ sở.

    Lấy `.src` của ảnh import thay vì gõ tay đường dẫn public/: ảnh cơ sở đã chuyển
    vào src/assets để Astro nén cho các chỗ hiển thị, nên đường dẫn public/ cũ không
    còn tồn tại. `.src` là URL có hash nội dung — chỉ đổi khi ảnh thật sự đổi.
  */
  image: [classroom, facility1, facility2].map(
    (asset) => new URL(asset.src, Astro.site).href,
  ),
  email: contact.email,
  telephone: contact.phones,
  foundingDate: String(site.foundedYear),
  /*
    Giấy phép hoạt động khai bằng `hasCredential` + `recognizedBy`, không nhét vào
    `description`.

    "Trung tâm này có được cấp phép không, ai cấp" là câu hỏi AI trả lời bằng cách tìm
    một dữ kiện có nguồn, chứ không bằng cách trích một câu quảng cáo. `credentialCategory`
    là "license" (giấy phép hoạt động) — khác `degree` dùng cho bằng cấp giảng viên ở
    `personSchema` — và `recognizedBy` trỏ vào cơ quan cấp dưới dạng thực thể nhà nước,
    thứ mô hình nối được sang tri thức nó đã có.
  */
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    name: `Giấy phép hoạt động đào tạo — ${site.license.authority}`,
    description: site.license.text,
    credentialCategory: "license",
    recognizedBy: {
      "@type": "GovernmentOrganization",
      name: site.license.authority,
    },
  },
  priceRange: "$$",
  currenciesAccepted: "VND",
  address: {
    "@type": "PostalAddress",
    streetAddress: "384/8 Lý Thái Tổ, Phường Vườn Lài",
    addressLocality: "Thành phố Hồ Chí Minh",
    addressRegion: "TP.HCM",
    addressCountry: "VN",
  },
  hasMap: contact.mapsUrl,
  areaServed: [
    { "@type": "City", name: "Thành phố Hồ Chí Minh" },
    { "@type": "Country", name: "Việt Nam" },
  ],
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "Tư vấn khoá học và học phí",
      telephone: contact.phonePrimary,
      email: contact.email,
      areaServed: "VN",
      availableLanguage: ["vi", "zh-Hans"],
    },
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "08:00",
      closes: "21:00",
    },
  ],
  knowsLanguage: ["vi", "zh-Hans"],
  knowsAbout: [
    "Tiếng Trung Quốc",
    "Kỳ thi HSK",
    "Chuẩn HSK 3.0",
    "Tiếng Trung thương mại",
  ],
  // Danh mục dịch vụ giúp Google hiểu trung tâm dạy những gì, tăng khả năng
  // xuất hiện với các truy vấn dạng "trung tâm dạy tiếng Trung giao tiếp".
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Khoá học tiếng Trung tại SaigonHSK",
    itemListElement: [
      "Khoá tiếng Trung sơ cấp cho người mới bắt đầu",
      "Khoá tiếng Trung trung cấp và cao cấp",
      "Lớp luyện thi chứng chỉ HSK3, HSK4, HSK5",
      "Tiếng Trung giao tiếp cấp tốc",
      "Tiếng Trung công sở và doanh nghiệp",
      "Tiếng Trung cho trẻ em",
      "Lớp VIP 1 kèm 1",
    ].map((name) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Course", name, inLanguage: "vi-VN" },
    })),
  },
  sameAs: [contact.facebook, contact.zalo, contact.tiktok],
  // Lối đăng ký khai tường minh: AI trả lời "đăng ký thế nào" cần biết cả form,
  // hotline và Zalo, không chỉ URL trang chủ. Node đầy đủ nằm ở `#enroll`.
  potentialAction: { "@id": `${canonical.origin}/#enroll` },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${canonical.origin}/#website`,
  url: canonical.origin,
  name: site.fullName,
  alternateName: site.shortName,
  description: site.description,
  inLanguage: "vi-VN",
  publisher: { "@id": `${canonical.origin}/#organization` },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical.href}#webpage`,
  url: canonical.href,
  name: title,
  description,
  inLanguage: "vi-VN",
  isPartOf: { "@id": `${canonical.origin}/#website` },
  about: { "@id": `${canonical.origin}/#organization` },
  dateModified: contentUpdatedAt,
  primaryImageOfPage: { "@type": "ImageObject", url: ogImage },
  // Tiêu đề + đoạn mô tả dưới nó là câu trả lời gọn nhất của trang; xem `speakable`
  // trong src/lib/schema.ts.
  speakable,
};

/*
  Một tài liệu JSON-LD cho cả trang, không phải mỗi node một thẻ `<script>`.

  Các node ở đây trỏ vào nhau bằng `@id` (`WebPage` → `WebSite` → `Organization`,
  `Course.provider` → `#organization`). Khi chúng nằm chung một `@graph`, tham chiếu
  được nối ngay trong tài liệu; tách ra nhiều thẻ thì crawler phải tự suy luận rằng
  `#organization` ở thẻ này là cái tổ chức khai ở thẻ khác — Google làm được, nhưng
  các bot đọc AI khác thì không chắc.

  Trang truyền `schemas` có thể khai lại chính `@id` của `WebPage`
  (`contactPageSchema`, `aboutPageSchema`) để thêm loại trang; trùng `@id` trong một
  graph là cách JSON-LD gộp thuộc tính, không phải lỗi.
*/
const jsonLd = graph([
  organizationSchema,
  enrollActionSchema(canonical.origin, contact.phonePrimary),
  websiteSchema,
  webPageSchema,
  ...schemas,
]);

const metaKeywords = keywords ? `${keywords}, ${keywordString}` : keywordString;

/**
 * Google Ads (gtag.js) — mã theo dõi của tài khoản quảng cáo, gắn ở mọi trang.
 *
 * Đây là *layout duy nhất* của site: mọi trang, kể cả các trang đi qua `CatalogHub`
 * hay `LibraryHub`, cuối cùng đều render qua đây, nên đặt một chỗ này là đủ cho cả
 * site — không trang nào phải tự nhớ gắn thêm.
 *
 * Chỉ chạy ở bản build (`import.meta.env.PROD`): `yarn dev` mà cũng bắn thì mỗi lần
 * mở thử một trang trên máy lại thành một lượt xem trong tài khoản quảng cáo, và
 * chuyển đổi thử nghiệm lẫn vào số liệu thật. Muốn tag chạy cả lúc dev thì bỏ điều
 * kiện `import.meta.env.PROD` ở dưới.
 *
 * Mã tài khoản không phải secret — nó nằm sẵn trong HTML gửi cho trình duyệt — nên
 * viết thẳng ở đây thay vì thêm một biến môi trường phải nhớ đặt trên máy build.
 */
const GOOGLE_ADS_ID = "AW-18385026103";
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {
      /*
        `is:inline` cho cả hai thẻ: để nguyên thì Astro gom script thành module và
        hoãn tới sau khi phân tích xong tài liệu, còn `gtag()` phải tồn tại **trước**
        khi gtag.js tải xong — nó đọc `dataLayer` đã xếp sẵn. Đặt ngay đầu `<head>`
        cũng vì vậy, đúng như đoạn Google phát cho.
      */
      import.meta.env.PROD && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ADS_ID}`}
          />
          <script
            is:inline
            set:html={`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());

              gtag('config', '${GOOGLE_ADS_ID}');
            `}
          />
        </>
      )
    }

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? "noindex,nofollow"
        : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"}
    />
    {/* Cốc Cốc — công cụ tìm kiếm nội địa vẫn đọc meta keywords, Google thì bỏ qua. */}
    <meta name="keywords" content={metaKeywords} />
    <meta name="author" content={site.fullName} />
    <meta name="theme-color" content="#c8102e" />
    <meta name="geo.region" content="VN-SG" />
    <meta name="geo.placename" content="Thành phố Hồ Chí Minh" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[80] focus:rounded-lg focus:bg-brand-red-600 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white"
    >
      Bỏ qua điều hướng, tới nội dung chính
    </a>
    <slot />
    <Lightbox />

    {/* Bắt nguồn (fbclid/utm/referrer) ngay ở trang đáp: tới lúc submit form thì
        referrer đã là chính landing, không còn thấy Facebook nữa. */}
    <script>
      import { captureAttribution } from "@/lib/attribution";

      captureAttribution();
    </script>

    {}
    <script is:inline>
      (() => {
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        if (reduce || !("IntersectionObserver" in window)) return;

        const main = document.getElementById("main");
        if (!main) return;

        const stagger = (el) => {
          const grid = el.querySelector(
            ':scope > .container > [class*="grid-cols"], :scope > .container > .grid, :scope > [class*="grid-cols"]'
          );
          if (!grid) return;
          Array.from(grid.children)
            .slice(0, 8)
            .forEach((child, i) => {
              child.style.setProperty("--reveal-delay", `${i * 70}ms`);
              child.classList.add("reveal", "reveal-child");
            });
        };

        const targets = [];
        main.querySelectorAll(":scope > section").forEach((section) => {

          if (section.querySelector(".sticky")) {
            section
              .querySelectorAll(":scope > .container > *")
              .forEach((block) => targets.push(block));
          } else {
            targets.push(section);
            stagger(section);
          }
        });

        if (!targets.length) return;
        targets.forEach((el) => el.classList.add("reveal"));

        const show = (el) => {
          el.classList.add("reveal-in");
          el.querySelectorAll(".reveal-child").forEach((c) =>
            c.classList.add("reveal-in")
          );
        };

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              show(entry.target);
              io.unobserve(entry.target);
            });
          },

          { rootMargin: "0px 0px -12% 0px", threshold: [0, 0.08] }
        );

        requestAnimationFrame(() => {
          targets.forEach((el) => {
            const top = el.getBoundingClientRect().top;
            if (top < window.innerHeight * 0.9) show(el);
            else io.observe(el);
          });
        });
      })();
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;

    min-height: 100%;
  }
</style>
