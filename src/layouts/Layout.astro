---
import "@/styles/global.css";
import Lightbox from "@/components/Lightbox.astro";
import { site, contact } from "@/data/site";

interface Props {
  title?: string;
  description?: string;

  image?: string;

  ogType?: string;

  noindex?: boolean;

  schemas?: Record<string, unknown>[];

  preloadImage?: string;
}

const {
  title = `Trung tâm tiếng Trung SaigonHSK — Luyện thi HSK, TOCFL tại TP.HCM`,
  description = site.description,
  image = "/images/classroom.webp",
  ogType = "website",
  noindex = false,
  schemas = [],
  preloadImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site);
const ogImage = new URL(image, Astro.site).href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["EducationalOrganization", "LocalBusiness"],
  "@id": `${canonical.origin}/#organization`,
  name: site.fullName,
  alternateName: [site.shortName, "Hoa văn SaigonHSK", "SaigonHSK"],
  slogan: `${site.slogan} — ${site.sloganVi}`,
  description: site.description,
  url: canonical.origin,
  logo: new URL("/favicon.png", Astro.site).href,
  image: ogImage,
  email: contact.email,
  telephone: contact.phones,
  foundingDate: String(site.foundedYear),
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "384/8 Lý Thái Tổ, Phường Vườn Lài",
    addressLocality: "Thành phố Hồ Chí Minh",
    addressRegion: "TP.HCM",
    addressCountry: "VN",
  },
  areaServed: { "@type": "City", name: "Thành phố Hồ Chí Minh" },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "08:00",
      closes: "21:00",
    },
  ],
  knowsLanguage: ["vi", "zh-Hans"],
  sameAs: [contact.facebook],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${canonical.origin}/#website`,
  url: canonical.origin,
  name: site.fullName,
  inLanguage: "vi-VN",
  publisher: { "@id": `${canonical.origin}/#organization` },
};

const allSchemas = [organizationSchema, websiteSchema, ...schemas];
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? "noindex,nofollow"
        : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"}
    />
    <meta name="author" content={site.fullName} />
    <meta name="geo.region" content="VN-SG" />
    <meta name="geo.placename" content="Thành phố Hồ Chí Minh" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      allSchemas.map((schema) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[80] focus:rounded-lg focus:bg-brand-red-600 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white"
    >
      Bỏ qua điều hướng, tới nội dung chính
    </a>
    <slot />
    <Lightbox />

    {}
    <script is:inline>
      (() => {
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        if (reduce || !("IntersectionObserver" in window)) return;

        const main = document.getElementById("main");
        if (!main) return;

        const stagger = (el) => {
          const grid = el.querySelector(
            ':scope > .container > [class*="grid-cols"], :scope > .container > .grid, :scope > [class*="grid-cols"]'
          );
          if (!grid) return;
          Array.from(grid.children)
            .slice(0, 8)
            .forEach((child, i) => {
              child.style.setProperty("--reveal-delay", `${i * 70}ms`);
              child.classList.add("reveal", "reveal-child");
            });
        };

        const targets = [];
        main.querySelectorAll(":scope > section").forEach((section) => {

          if (section.querySelector(".sticky")) {
            section
              .querySelectorAll(":scope > .container > *")
              .forEach((block) => targets.push(block));
          } else {
            targets.push(section);
            stagger(section);
          }
        });

        if (!targets.length) return;
        targets.forEach((el) => el.classList.add("reveal"));

        const show = (el) => {
          el.classList.add("reveal-in");
          el.querySelectorAll(".reveal-child").forEach((c) =>
            c.classList.add("reveal-in")
          );
        };

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              show(entry.target);
              io.unobserve(entry.target);
            });
          },

          { rootMargin: "0px 0px -12% 0px", threshold: [0, 0.08] }
        );

        requestAnimationFrame(() => {
          targets.forEach((el) => {
            const top = el.getBoundingClientRect().top;
            if (top < window.innerHeight * 0.9) show(el);
            else io.observe(el);
          });
        });
      })();
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;

    min-height: 100%;
  }
</style>
