---
import { promotions, promotionNote } from "@/data/promotions";
import { ICONS } from "@/lib/icons";

/**
 * Băng thông báo ưu đãi: chạy hết bề ngang, dính sát đáy header, là dòng đầu tiên của hero.
 *
 * Trước đây nội dung này là `Promotions.astro` — một khối riêng dưới hero, ba tấm phiếu giảm
 * giá cỡ lớn. Nay nó về đúng vai trò của nó: một lời nhắn ngắn ở đầu trang. Ưu đãi là thứ để
 * người đọc BIẾT là có, không phải thứ chiếm một màn hình trước khi họ kịp xem trung tâm dạy
 * gì; và đặt trong hero thì nó nằm trong màn đầu — chỗ duy nhất chắc chắn ai cũng thấy.
 *
 * VÌ SAO LÀ MỘT BĂNG LIỀN CHỨ KHÔNG PHẢI MỘT VIÊN THUỐC BO TRÒN GIỮA TRANG. Bản trước là một
 * viên thuốc thả nổi ở đỉnh hero, và dưới nó một dòng chữ nhỏ về ưu đãi dịp lễ: hai mảnh rời
 * nhau, cùng trôi trên nền mây và lưới kẻ, không mảnh nào dính vào đâu. Băng chạy hết bề
 * ngang thì nó nối thẳng vào đáy header — mắt đọc ra "thanh thông báo của trang", tức một thứ
 * CÓ CHỖ ĐỨNG, và mọi thứ trôi nổi biến mất chỉ bằng cách cho nó một nét viền dưới.
 *
 * CẢ BA ƯU ĐÃI HIỆN CÙNG LÚC, không thay nhau. Bản đầu tiên cho ba dòng xoay vòng năm giây
 * một dòng: gọn đúng một dòng, nhưng hai phần ba nội dung luôn bị giấu và người đọc không
 * biết là có — mà "có mấy ưu đãi" chính là điều băng này cần nói.
 *
 * Mỗi ưu đãi rút về một cặp `notice.value`/`notice.label` soạn riêng trong `promotions.ts`;
 * `desc` và `tiers` là bản ghi đầy đủ, chờ một trang chi tiết.
 *
 * KHÔNG có nhãn "ƯU ĐÃI" ở đầu băng. Bản trước có một viên thuốc xanh đậm kèm hình ngôi sao,
 * để tuyên bố cả băng nói về chuyện gì — nhưng "Giảm 5%", "200.000đ", "Đến 200.000đ" đã tự
 * nói ra điều đó ngay từ chữ đầu tiên, nên cái nhãn chỉ lặp lại bằng một hình thức nữa. Bỏ nó
 * còn trả lại chừng 90px cho ba ưu đãi, tức chúng vào một hàng ngang sớm hơn một breakpoint.
 */
---

{/*
  Nền xanh lá tô đặc (xem chú thích màu ở `<style>` dưới). Bản trước để nền trong mờ cùng tông
  với hero: băng khi đó chỉ là hai nét viền bọc lấy một khoảng gần như không màu, và trên nền
  mây với lưới kẻ của hero thì nó không tách ra được. Một mảng màu chạy hết bề ngang thì mắt
  đọc ngay ra "đây là thanh thông báo", không cần nét viền nào phải cố gắng.

  KHÔNG có nút đóng. Bản trước có một dấu × ở mép phải, đóng băng cho hết phiên — nhưng ưu đãi
  là thứ trung tâm muốn người đọc thấy ở mọi trang họ ghé, mà một lần lỡ tay bấm là mất suốt
  lần ghé đó và không có cách nào gọi lại. Băng cao 46px, cuộn qua nó mất chưa tới một phần tư
  cú vuốt — rẻ hơn nhiều so với việc mất hẳn.
*/}
<div class="promo-band relative border-b">
  <div
    class="container mx-auto flex items-center justify-center gap-2 px-6 py-2.5 sm:gap-3 sm:py-4 lg:gap-4"
  >
    {/*
      Ba ô chia bởi hai nét dọc. Ở khổ hẹp mỗi ô xếp dọc (con số trên, điều kiện dưới) — xếp
      ngang thì ba ô cần chừng 470px, quá khổ máy; xếp dọc thì mỗi ô chỉ cần bề rộng của dòng
      dài hơn trong hai dòng.

      Ba ô về một hàng ngang từ `md` chứ không phải `sm`: ở 640px cả băng chỉ được 592px, đủ
      cho ba con số nhưng thiếu cho ba nhãn, nên "học phí khoá sau" gãy làm đôi trong khi con
      số bên cạnh vẫn một dòng — ô nào cũng cao hai dòng mà lại so le. 768px là mốc đầu tiên
      cả ba mệnh đề nằm trọn trên một dòng.
    */}
    <ul class="promo-band-list flex min-w-0 items-stretch divide-x">
      {
        promotions.map((p) => (
          <li class="flex min-w-0 flex-col items-center justify-center px-2 text-center sm:px-3 md:flex-row md:items-baseline md:gap-1.5 lg:px-4">
            <span class="promo-band-value text-[0.72rem] leading-tight font-black whitespace-nowrap sm:text-[0.8rem]">
              {p.notice.value}
            </span>
            <span class="promo-band-label text-[0.56rem] leading-tight sm:text-[0.72rem]">
              {p.notice.label}
            </span>
          </li>
        ))
      }
    </ul>

    {/*
      Ưu đãi theo dịp lễ, ngăn bởi một nét dọc như ba ô kia — nó là món thứ tư của cùng một
      băng, không phải một dòng riêng.

      Hiện từ `xl`: đo ra hàng này cần 76 (nhãn) + 580 (ba ưu đãi) + 484 (câu dịp lễ) + 48
      (bốn khoảng hở) + 48 (hai lề) = 1236px, vừa trong khung 1265px của `xl`. Hẹp hơn thì cả
      ba ưu đãi lẫn câu này cùng gãy làm hai dòng, tức băng cao gấp rưỡi. Đây là lời hẹn cho
      lần sau, không phải ưu đãi đang áp dụng, nên nó là thứ đầu tiên nhường chỗ.
    */}
    <span
      class="promo-band-rule hidden h-4 w-px shrink-0 xl:block"
      aria-hidden="true"></span>
    <p class="promo-band-note hidden items-center gap-1.5 text-[0.72rem] leading-tight whitespace-nowrap xl:flex">
      <span
        class="shrink-0 opacity-70 [&>svg]:size-3.5"
        aria-hidden="true"
        set:html={ICONS.calendar}
      />
      {promotionNote}
    </p>
  </div>

</div>

<style>
  /*
    BĂNG MỘT MÀU XANH LÁ, KHÔNG PHẢI BA MÀU NHẤN.

    Bản trước mỗi ưu đãi mang một màu riêng — lá, hổ phách, dương — thừa hưởng từ ba tấm phiếu
    của khối `Promotions` cũ. Ở đó ba tấm nằm rời nhau nên màu là thứ gom mỗi tấm thành một
    món. Trong một băng cao 38px thì ngược lại: ba màu chữ trên cùng một dải làm nó đọc ra như
    ba mẩu tin dán cạnh nhau. Nay hai nét dọc lo việc chia ô, còn màu chỉ còn một.

    Xanh lá chứ không phải đỏ thương hiệu, dù đỏ mới là màu của trung tâm: băng dính liền đáy
    header — mà header là một mảng đỏ đặc. Đỏ chồng đỏ thì hoặc băng biến mất vào header, hoặc
    thành hai sắc đỏ lệch nhau cạnh nhau, tệ hơn cả không tô. Xanh lá tách hẳn khỏi header, và
    nó vẫn là màu đã có trong bộ (`is-green` của ưu đãi học lên khoá sau).

    Bốn giá trị, đủ cho đúng bốn chỗ dùng — nền, viền, chữ đậm, chữ nhạt:

      nền     #eaf6ee → #e1f1e7  (dải dọc, đậm dần xuống đáy: mép dưới đậm hơn thì nó "đỡ" lấy
                                  phần hero bên dưới, thay vì tan dần ra)
      viền    #cbe4d4
      chữ đậm #14683a  (7.0:1 trên nền — con số là thứ phải đọc được trước tiên)
      chữ nhạt #3f6350 (5.6:1, vẫn đạt AA ở cỡ 0.56rem của nhãn dưới mobile)
  */
  .promo-band {
    background: linear-gradient(180deg, #eaf6ee 0%, #e1f1e7 100%);
    border-color: #cbe4d4;
  }

  .promo-band-value {
    color: #14683a;
  }

  .promo-band-label,
  .promo-band-note {
    color: #3f6350;
  }

  /* Nét chia mảnh hơn nét viền băng: nó chỉ ngăn ô này với ô kia bên trong một mảng màu, mà
     nét chia đậm bằng viền ngoài thì băng đọc ra là ba cái hộp ghép lại. */
  .promo-band-list,
  .promo-band-rule {
    --divider: #cfe6d8;
  }

  .promo-band-list > li + li {
    border-color: var(--divider);
  }

  .promo-band-rule {
    background: var(--divider);
  }
</style>
