---
import { Image } from "astro:assets";
import SectionHeading from "@/components/SectionHeading.astro";
import { honorPosters } from "@/data/achievements";
import { lightboxSrc } from "@/lib/images";

const posters = await Promise.all(
  honorPosters.map(async (p) => ({
    ...p,
    caption: `${p.title} — bạn ${p.name}`,
    full: await lightboxSrc(p.image),
  })),
);
---

<section
  id="achievements"
  class="relative overflow-hidden bg-background scroll-mt-24"
>
  <div class="container relative z-10 mx-auto px-6">
    <SectionHeading
      title="Thành tích"
      highlight="của học viên SaigonHSK"
      note="Bấm vào ảnh để xem bảng điểm"
    />

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        posters.map((p) => (
          <figure class="group">
            <button
              type="button"
              data-lightbox={p.full}
              data-caption={p.caption}
              class="block w-full cursor-zoom-in overflow-hidden rounded-2xl bg-brand-ink-50"
            >
              <Image
                src={p.image}
                alt={p.caption}
                width={420}
                densities={[1, 2]}
                format="webp"
                quality={78}
                loading="lazy"
                decoding="async"
                class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </button>

            <figcaption class="mt-4 px-1">
              <p class="text-lg font-black leading-tight text-brand-ink-900">
                Bạn {p.name}
              </p>
              <p class="mt-1.5 text-xs font-bold uppercase tracking-[0.08em] text-brand-red-600">
                {p.result}
              </p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
