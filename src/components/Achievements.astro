---
import { Image } from "astro:assets";
import SectionHeading from "@/components/SectionHeading.astro";
import { honorPosters } from "@/data/achievements";
import { lightboxSrc } from "@/lib/images";

const posters = await Promise.all(
  honorPosters.map(async (p) => ({
    ...p,
    caption: `${p.title} — bạn ${p.name}`,
    full: await lightboxSrc(p.image),
  })),
);
---

<section
  id="achievements"
  class="relative overflow-hidden bg-background scroll-mt-24"
>
  <div class="container relative z-10 mx-auto px-6">
    <SectionHeading
      title="Thành tích"
      highlight="của học viên SaigonHSK"
    />

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        posters.map((p) => (
          <figure>
            {/* group đặt ở button chứ không ở figure: gợi ý "xem bảng điểm" chỉ
                hiện khi hover đúng vào ảnh, không tính phần tên bên dưới. */}
            <button
              type="button"
              data-lightbox={p.full}
              data-caption={p.caption}
              class="group/img relative block w-full cursor-zoom-in overflow-hidden rounded-2xl bg-brand-ink-50"
            >
              <Image
                src={p.image}
                alt={p.caption}
                width={420}
                densities={[1, 2]}
                format="webp"
                quality={88}
                loading="lazy"
                decoding="async"
                class="aspect-square w-full object-cover transition-transform duration-500 group-hover/img:scale-[1.04]"
              />

              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 bg-linear-to-t from-brand-ink-950/80 via-brand-ink-950/25 to-transparent opacity-0 transition-opacity duration-300 group-hover/img:opacity-100 group-focus-visible/img:opacity-100"
              />

              {/* Máy cảm ứng không có hover nên để nhãn hiện sẵn, khỏi mất gợi ý. */}
              <span
                class="pointer-events-none absolute inset-x-3 bottom-3 block translate-y-2 rounded-full bg-white/95 px-3 py-2 text-center text-xs font-bold text-brand-ink-900 opacity-0 shadow-[0_10px_24px_-14px_rgb(17_24_39/0.7)] transition duration-300 group-hover/img:translate-y-0 group-hover/img:opacity-100 group-focus-visible/img:translate-y-0 group-focus-visible/img:opacity-100 [@media(hover:none)]:translate-y-0 [@media(hover:none)]:opacity-100"
              >
                Xem bảng điểm
              </span>
            </button>

            <figcaption class="mt-4 px-1">
              <p class="text-lg font-black leading-tight text-brand-ink-900">
                Bạn {p.name}
              </p>
              <p class="mt-1.5 text-xs font-bold uppercase tracking-[0.08em] text-brand-red-600">
                {p.result}
              </p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
