---
import SectionHeading from "@/components/SectionHeading.astro";
import { achievements } from "@/data/achievements";

interface Props {
  /** Số thẻ hiện ngay từ đầu, phần còn lại mở bằng nút "Xem thêm" */
  limit?: number;
}

const { limit = 8 } = Astro.props;

const hasMore = achievements.length > limit;
const placeholders = achievements.length === 0 ? 8 : 0;
---

<section
  id="achievements"
  class="relative overflow-hidden bg-background scroll-mt-24"
>
  <div class="container relative z-10 mx-auto px-6">
    <SectionHeading
      title="Thành tích"
      highlight="của học viên SaigonHSK"
      description="Chứng chỉ HSK, TOCFL và những cột mốc học viên đạt được sau mỗi khoá học tại trung tâm."
    />

    <div
      data-achievement-grid
      class="mt-12 grid gap-5 grid-cols-2 lg:grid-cols-4 lg:gap-6"
    >
      {
        achievements.map((a, i) => (
          <article
            data-achievement-card
            hidden={i >= limit}
            class="group relative rounded-lg border border-border bg-background p-3 transition-shadow hover:shadow-[0_18px_40px_-24px_rgb(17_24_39/0.35)]"
          >
            <button
              type="button"
              data-lightbox={a.image}
              data-caption={`${a.name} — ${a.exam} ${a.score}`}
              class="block w-full cursor-zoom-in overflow-hidden rounded-lg bg-brand-ink-50"
            >
              <img
                src={a.image}
                alt={`Học viên ${a.name} đạt ${a.exam} ${a.score}`}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </button>

            <div
              aria-hidden="true"
              class="pointer-events-none absolute right-5 top-0 w-14 bg-brand-red-600 pb-5 pt-2.5 text-center text-white lg:w-16 lg:pb-6 lg:pt-3 [clip-path:polygon(0_0,100%_0,100%_100%,50%_80%,0_100%)]"
            >
              <span class="block text-lg font-black leading-none lg:text-2xl">
                {a.score}
              </span>
              <span class="mt-1 block text-[0.5rem] font-bold uppercase tracking-[0.12em] lg:text-[0.625rem]">
                {a.exam}
              </span>
            </div>

            <div class="px-2 pb-2 pt-4 lg:px-3 lg:pt-5">
              <p class="text-lg font-black leading-tight text-brand-ink-900 lg:text-xl">
                {a.name}
              </p>
              <p class="mt-2 truncate text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-muted-foreground lg:text-xs">
                {a.school}
              </p>
            </div>
          </article>
        ))
      }

      {
        Array.from({ length: placeholders }).map(() => (
          <div class="rounded-lg border-2 border-dashed border-border bg-brand-ink-50/60 p-3">
            <div class="grid aspect-[4/3] place-items-center rounded-lg bg-brand-ink-50 px-4 text-center">
              <span class="text-xs font-semibold text-muted-foreground">
                Ảnh chứng chỉ học viên — sắp cập nhật
              </span>
            </div>
            <div class="px-2 pb-2 pt-4">
              <div class="h-4 w-2/3 rounded-full bg-brand-ink-100" />
              <div class="mt-3 h-3 w-full rounded-full bg-brand-ink-100/70" />
            </div>
          </div>
        ))
      }
    </div>

    {
      hasMore && (
        <div class="mt-12 text-center">
          <button
            type="button"
            data-achievement-more
            class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-border bg-background px-8 py-4 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
          >
            Xem thêm học viên xuất sắc
          </button>
        </div>
      )
    }
  </div>
</section>

<script>
  const grid = document.querySelector<HTMLElement>("[data-achievement-grid]");
  const more = document.querySelector<HTMLButtonElement>(
    "[data-achievement-more]",
  );

  more?.addEventListener("click", () => {
    grid
      ?.querySelectorAll<HTMLElement>("[data-achievement-card][hidden]")
      .forEach((card) => card.removeAttribute("hidden"));
    more.remove();
  });
</script>
