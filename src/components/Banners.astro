---
/**
 * Bộ poster giới thiệu của trung tâm — bố cục dán ảnh nghiêng như hero.
 * Bấm vào ảnh để xem cỡ lớn (lightbox khai báo ở Layout).
 */
import { banners } from "@/data/teachers";

/** Giáo vụ có thể xoá hết poster trong admin — khi đó bỏ luôn cả khối. */
const [featured, ...rest] = banners;
---

{featured && (
<section
  id="banners"
  class="relative overflow-hidden bg-background scroll-mt-24"
>
  <div class="container relative z-10 mx-auto px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2
        class="text-[2rem] font-black leading-[1.05] tracking-tight text-brand-ink-900 md:text-5xl"
      >
        Lịch khai giảng
        <span class="block text-brand-red-600">
          &amp; thông tin trung tâm
        </span>
      </h2>
      <p class="mt-5 text-sm leading-relaxed text-muted-foreground md:text-base">
        Lớp offline và online mở liên tục hằng tháng theo chuẩn HSK 3.0.
      </p>
    </div>

    {/*
      Poster chính — khung rộng đúng bằng dải nội dung của header và cao theo
      `aspect-[16/9]` nên banner thấp lại. `object-contain` giữ trọn tỉ lệ ảnh:
      không méo, không cắt dòng nào của bảng lịch. Vì ảnh hiển thị nhỏ hơn cỡ
      gốc 1200×868 nên không bao giờ bị phóng lên → luôn nét.
      Đổi `16/9` để chỉnh chiều cao: số sau càng lớn thì banner càng cao.
    */}
    <div class="mt-12">
      <button
        type="button"
        data-lightbox={featured.image}
        data-caption={featured.title}
        class="group block w-full cursor-zoom-in text-left transition-transform duration-300 hover:-translate-y-1.5"
      >
        <img
          src={featured.image}
          alt={featured.title}
          width="1200"
          height="868"
          loading="eager"
          decoding="async"
          class="block aspect-video w-full rounded-3xl object-contain"
        />
      </button>
    </div>
  </div>
</section>
)}
