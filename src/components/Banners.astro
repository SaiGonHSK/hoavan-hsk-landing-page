---
import { banners } from "@/data/teachers";

const [featured, ...rest] = banners;
---

{featured && (
<section
  id="banners"
  class="relative overflow-hidden bg-background scroll-mt-24"
>
  <div class="container relative z-10 mx-auto px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2
        class="text-[2rem] font-black leading-[1.05] tracking-tight text-brand-ink-900 md:text-5xl"
      >
        Lịch khai giảng
        <span class="block text-brand-red-600">
          &amp; thông tin trung tâm
        </span>
      </h2>
      <p class="mt-5 text-sm leading-relaxed text-muted-foreground md:text-base">
        Lớp offline và online mở liên tục hằng tháng theo chuẩn HSK 3.0.
      </p>
    </div>

    <div class="mt-12">
      <button
        type="button"
        data-lightbox={featured.image}
        data-caption={featured.title}
        class="group block w-full cursor-zoom-in text-left transition-transform duration-300 hover:-translate-y-1.5"
      >
        <img
          src={featured.image}
          alt={featured.title}
          width="1200"
          height="868"
          loading="eager"
          decoding="async"
          class="block aspect-video w-full rounded-3xl object-contain"
        />
      </button>
    </div>
  </div>
</section>
)}
