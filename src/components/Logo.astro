---
/**
 * Logo dạng Astro thuần — không cần React/framer-motion, hiệu ứng hover bằng CSS.
 */
import markUrl from "@/assets/logo-mark.png";
import { site } from "@/data/site";

interface Props {
  /** Chỉ hiện con dấu, ẩn phần chữ (khi chật chỗ). */
  markOnly?: boolean;
  class?: string;
}
const { markOnly = false, class: className = "" } = Astro.props;
---

<a
  href="/"
  aria-label={`${site.fullName} — Trang chủ`}
  class:list={[
    "flex select-none items-center gap-2.5 leading-none transition-transform duration-200 hover:scale-[1.03]",
    className,
  ]}
>
  <img
    src={markUrl.src}
    alt={`Logo ${site.fullName}`}
    width="192"
    height="192"
    class="size-10 shrink-0 object-contain md:size-11"
  />

  {
    !markOnly && (
      <span class="flex flex-col gap-0.5">
        <span class="font-bricolage text-sm font-extrabold uppercase tracking-[0.08em] text-foreground md:text-base">
          Hoa văn SaigonHSK
        </span>
        <span class="text-[11px] font-semibold tracking-[0.12em] text-brand-red-600 dark:text-brand-red-400">
          {site.slogan}
        </span>
      </span>
    )
  }
</a>
