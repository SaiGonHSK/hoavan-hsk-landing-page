---
/**
 * Logo dạng Astro thuần — không cần React/framer-motion, hiệu ứng hover bằng CSS.
 */
import markUrl from "@/assets/logo-mark.png";
import { site } from "@/data/site";

interface Props {
  /** Chỉ hiện con dấu, ẩn phần chữ (khi chật chỗ). */
  markOnly?: boolean;
  /** Đặt trên nền đậm (header đỏ): chữ trắng và con dấu nằm trên đĩa trắng. */
  onDark?: boolean;
  class?: string;
}
const { markOnly = false, onDark = false, class: className = "" } = Astro.props;
---

<a
  href="/"
  aria-label={`${site.fullName} — Trang chủ`}
  class:list={[
    "flex select-none items-center gap-2.5 leading-none transition-transform duration-200 hover:scale-[1.03]",
    className,
  ]}
>
  <img
    src={markUrl.src}
    alt={`Logo ${site.fullName}`}
    width="192"
    height="192"
    class:list={[
      "size-10 shrink-0 object-contain md:size-11",
      onDark && "rounded-full bg-white p-0.5",
    ]}
  />

  {
    !markOnly && (
      <span class="flex flex-col gap-0.5">
        <span
          class:list={[
            " text-sm font-extrabold uppercase tracking-[0.08em] md:text-base",
            onDark ? "text-white" : "text-foreground",
          ]}
        >
          Hoa văn SaigonHSK
        </span>
        <span
          class:list={[
            "text-[11px] font-semibold tracking-[0.12em]",
            onDark
              ? "text-white/75"
              : "text-brand-red-600",
          ]}
        >
          {site.slogan}
        </span>
      </span>
    )
  }
</a>
