---
import { Image } from "astro:assets";
import SectionHeading from "@/components/SectionHeading.astro";
import { valuePanels as slides } from "@/data/valuePanels";
---

<section id="why-us" class="relative overflow-hidden bg-background scroll-mt-24">
  <div class="container relative z-10 mx-auto px-6">
    <SectionHeading
      title="Vì sao học viên chọn"
      highlight="Hoa văn SaigonHSK?"
      description="SaigonHSK là trung tâm đào tạo tiếng Trung chất lượng cao, uy tín tại TP.HCM. Với những giá trị khác biệt, chúng tôi thực hiện sứ mệnh truyền đạt tinh hoa ngôn ngữ cho cộng đồng."
    />

    <div
      data-value-tabs
      class="mt-10 flex flex-col overflow-hidden rounded-[2rem] border border-border bg-background"
    >
      {
        slides.map((s, i) => (
          <div
            data-panel={i}
            role="tabpanel"
            id={`why-panel-${i}`}
            aria-labelledby={`why-tab-${i}`}
            hidden={i !== 0}
            class="grid lg:grid-cols-[1fr_1.05fr]"
          >
            <div class="flex flex-col justify-center p-8 sm:p-10 lg:p-14">
              <span class="inline-flex w-fit items-center rounded-full bg-brand-ink-900 px-4 py-2 text-[0.6875rem] font-bold uppercase tracking-widest text-white">
                {s.badge}
              </span>

              <h3 class="mt-6 max-w-md text-2xl font-black leading-tight text-brand-ink-900 sm:text-3xl">
                {s.title}
              </h3>

              <p class="mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">
                {s.desc}
              </p>

              <div class="mt-8 max-w-md border-t border-border pt-6">
                <p class="text-lg font-black leading-none text-brand-ink-900">
                  {s.strong}
                </p>
                <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                  {s.note}
                </p>
              </div>
            </div>

            <div
              class:list={[
                "relative order-first min-h-56 lg:order-0 lg:min-h-104",
                (s.contain || s.devices) && "bg-brand-ink-50 p-6 lg:p-10",
              ]}
            >
              {
                s.devices ? (
                  <div class="flex h-full items-center justify-center gap-3 sm:gap-5">
                    {s.devices.map((device, k) => (
                      <div
                        class:list={[
                          "w-1/2 max-w-52 overflow-hidden rounded-[1.5rem] border-[6px] border-brand-ink-900 bg-brand-ink-900 shadow-[0_28px_60px_-32px_rgb(17_24_39/0.6)]",
                          k === 0
                            ? "-rotate-6 translate-y-6"
                            : "rotate-3 -translate-y-2",
                        ]}
                      >
                        <Image
                          src={device}
                          alt={`Ứng dụng học tập SaigonHSK — màn hình ${k + 1}`}
                          width={430}
                          densities={[1, 2]}
                          format="webp"
                          quality={80}
                          loading="lazy"
                          decoding="async"
                          class="block w-full"
                        />
                      </div>
                    ))}
                  </div>
                ) : typeof s.image === "string" ? (
                  <img
                    src={s.image}
                    alt={s.title}
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                    class="absolute inset-0 size-full object-cover"
                  />
                ) : (
                  <Image
                    src={s.image}
                    alt={`${s.title} — ${s.note}`}
                    width={720}
                    densities={[1, 2]}
                    format="webp"
                    quality={78}
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                    class="size-full rounded-2xl object-contain"
                  />
                )
              }

              {
                !s.contain && (
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-0 hidden bg-linear-to-r from-background via-background/25 to-transparent lg:block"
                  />
                )
              }
            </div>
          </div>
        ))
      }

      {/*
        Dưới lg dải tab nằm TRÊN panel và cuộn ngang: xếp dọc 4 tab chiếm gần hết
        màn hình, còn để dưới panel thì bấm tab xong nội dung nhảy khỏi khung nhìn.
      */}
      <div
        role="tablist"
        aria-label="Giá trị khác biệt của SaigonHSK"
        class="why-tabs order-first flex snap-x snap-mandatory gap-px overflow-x-auto border-b border-border bg-border sm:grid sm:grid-cols-2 sm:overflow-visible lg:order-0 lg:grid-cols-4 lg:border-b-0 lg:border-t"
      >
        {
          slides.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`why-tab-${i}`}
              data-tab={i}
              data-active={i === 0 ? "true" : "false"}
              aria-controls={`why-panel-${i}`}
              aria-selected={i === 0}
              class="group relative shrink-0 snap-start cursor-pointer bg-background px-5 py-4 text-center transition-colors data-[active=true]:bg-brand-ink-50/60 sm:px-6 sm:py-5"
            >
              <span
                aria-hidden="true"
                class="absolute inset-x-0 bottom-0 h-0.5 bg-brand-red-600 opacity-0 transition-opacity group-data-[active=true]:opacity-100 lg:bottom-auto lg:top-0"
              />
              <span class="block whitespace-nowrap text-sm font-bold text-muted-foreground transition-colors group-hover:text-brand-ink-900 group-data-[active=true]:text-brand-ink-900 sm:whitespace-normal">
                {s.tab}
              </span>
              <span class="mt-1 block whitespace-nowrap text-xs text-muted-foreground sm:whitespace-normal">
                {s.tabNote}
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-value-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];

    const show = (index: number) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.dataset.active = String(active);
        tab.setAttribute("aria-selected", String(active));
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });

      // Trên mobile dải tab cuộn ngang nên tab vừa bấm có thể đang bị cắt ở mép.
      tabs[index]?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "nearest" });
    };

    tabs.forEach((tab, i) => tab.addEventListener("click", () => show(i)));
  });
</script>

<style>
  .why-tabs {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .why-tabs::-webkit-scrollbar {
    display: none;
  }
</style>
