---
import { Image } from "astro:assets";
import SectionHeading from "@/components/SectionHeading.astro";
import { valuePanels as slides } from "@/data/valuePanels";
---

<section id="why-us" class="relative overflow-hidden bg-background scroll-mt-24">
  <div class="container relative z-10 mx-auto px-6">
    <SectionHeading
      title="Vì sao học viên chọn"
      highlight="Hoa văn SaigonHSK?"
      description="SaigonHSK là trung tâm đào tạo tiếng Trung chất lượng cao, uy tín tại TP.HCM. Với những giá trị khác biệt, chúng tôi thực hiện sứ mệnh truyền đạt tinh hoa ngôn ngữ cho cộng đồng."
    />

    <div
      data-value-tabs
      class="mt-10 flex flex-col overflow-hidden rounded-[2rem] border border-border bg-background"
    >
      {
        /*
          Sàn `min-h` chỉ đặt từ `lg` — nơi dải tab nằm DƯỚI panel, nên panel cao thấp
          khác nhau là bốn tab xê dịch mỗi lần đổi tab.

          Dưới `lg` tab nằm TRÊN panel: đổi tab thì phần trên đứng yên, chỉ nội dung
          bên dưới dài ngắn khác nhau — đúng như mọi khối tab trên mobile. Ép sàn theo
          panel cao nhất ("Ứng dụng luyện đề", ~708px ở khổ 430) thì ba panel còn lại
          phải độn thêm 100–200px trống giữa ảnh và chữ, đổi một mảng trống thấy rõ
          lấy một thứ không ai thấy.
        */
        slides.map((s, i) => (
          <div
            data-panel={i}
            role="tabpanel"
            id={`why-panel-${i}`}
            aria-labelledby={`why-tab-${i}`}
            hidden={i !== 0}
            class="grid lg:min-h-128 lg:grid-cols-[1fr_1.05fr]"
          >
            <div class="flex flex-col justify-center p-6 sm:p-10 lg:p-14">
              <span class="inline-flex w-fit items-center rounded-full bg-brand-ink-900 px-4 py-2 text-[0.6875rem] font-bold uppercase tracking-widest text-white">
                {s.badge}
              </span>

              <h3 class="mt-6 max-w-md text-2xl font-black leading-tight text-brand-ink-900 sm:text-3xl">
                {s.title}
              </h3>

              <p class="mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">
                {s.desc}
              </p>

              <div class="mt-8 max-w-md border-t border-border pt-6">
                <p class="text-lg font-black leading-none text-brand-ink-900">
                  {s.strong}
                </p>
                <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                  {s.note}
                </p>
              </div>
            </div>

            {/*
              Mọi minh hoạ đều nằm tuyệt đối trong cột này, kể cả loại `contain`.

              Bốn panel có bốn tỉ lệ ảnh khác hẳn nhau — poster vuông, ảnh ghép ngang,
              hai khung điện thoại dọc, ảnh chụp lớp. Để ảnh nằm trong luồng thì mỗi
              panel cao một kiểu, mà tại một thời điểm chỉ một panel ở trong luồng, nên
              bấm đổi tab là cả khung giật lên giật xuống. Tách ảnh khỏi luồng rồi chốt
              `min-h` ở panel thì bốn tab cao bằng nhau, đổi tab không xê dịch gì.
            */}
            <div
              class:list={[
                "relative order-first min-h-64 sm:min-h-96 lg:order-0 lg:min-h-0",
                (s.contain || s.devices) && "bg-brand-ink-50",
              ]}
            >
              {
                s.devices ? (
                  /*
                    Khung điện thoại lấy kích thước theo CHIỀU CAO của ô ảnh, không theo
                    chiều ngang.

                    Trước đây mỗi khung là `w-1/2 max-w-52` rồi để ảnh tự suy ra chiều cao.
                    Ảnh chụp app tỉ lệ 1206×2622, tức cao gấp 2,17 lần bề ngang: dưới `lg`
                    khung rộng ~160px thành ra cao ~334px, trong khi ô ảnh chỉ cao 224px.
                    Phần thừa tràn ngược lên trên và đè thẳng lên dải tab — bấm sang tab
                    "Ứng dụng luyện đề" là hai cái điện thoại phủ mất chữ trên tab.

                    Buộc chiều cao (`h-[88%]`) rồi để bề ngang tự suy ra thì khung không
                    bao giờ cao hơn ô chứa nó, ở mọi khổ màn. 12% còn lại cộng với `p-6`
                    là chỗ trống dành cho độ nghiêng và độ lệch của hai khung.
                  */
                  <div class="absolute inset-0 flex items-center justify-center gap-3 p-6 sm:gap-5 lg:p-10">
                    {s.devices.map((device, k) => (
                      <div
                        class:list={[
                          "h-[88%] shrink-0 overflow-hidden rounded-[1.5rem] border-[6px] border-brand-ink-900 bg-brand-ink-900 shadow-[0_28px_60px_-32px_rgb(17_24_39/0.6)]",
                          k === 0
                            ? "-rotate-6 translate-y-[4%]"
                            : "rotate-3 -translate-y-[3%]",
                        ]}
                      >
                        <Image
                          src={device}
                          alt={`Ứng dụng học tập SaigonHSK — màn hình ${k + 1}`}
                          width={430}
                          densities={[1, 2]}
                          format="webp"
                          quality={88}
                          loading="lazy"
                          decoding="async"
                          class="block h-full w-auto max-w-none"
                        />
                      </div>
                    ))}
                  </div>
                ) : s.contain ? (
                  /*
                    Hai ảnh đi qua nhánh này (ảnh ghép đội ngũ giảng viên và poster thành tích)
                    đều có CHỮ nướng sẵn trong ảnh — tên, học vị, tên trường, điểm thi.

                    Vì vậy phát một bản duy nhất khoảng 2x thay vì cặp 1x/2x qua `densities`:
                    ô ảnh thật rộng ~550px, cặp 720w/1440w làm máy dpr=1 nhận bản 720w, tức
                    1,3 điểm ảnh cho mỗi px CSS — ảnh thường thì không sao, ảnh có chữ thì nhoè
                    rõ. Triệu chứng đúng như báo lại: phải zoom vào rồi zoom ra mới hết mờ, vì
                    zoom đẩy dpr lên, trình duyệt mới đổi sang bản 1440w rồi giữ bản đó.

                    1200w phủ cả dpr=1 và dpr=2 cho ô 550px (550 × 2 = 1100 ≤ 1200), và ảnh
                    ghép phần lớn là nền phẳng nên 1200w q82 chỉ ~43 KB — nhẹ hơn cả cặp cũ.
                  */
                  /*
                    Chỉ từ `lg` ảnh mới nằm tuyệt đối và bị bó theo chiều cao ô.

                    Dưới `lg` ô ảnh chỉ cao 256–384px, mà ba ảnh đi qua nhánh này đều
                    cao hơn rộng: bó theo chiều cao thì ảnh co lại còn ~200px ngang, nằm
                    lọt thỏm giữa một mảng xám rộng gần gấp đôi. Ở khổ đó cho ảnh chạy
                    theo *bề ngang* (tối đa 24rem, canh giữa) rồi để ô cao theo ảnh —
                    `min-h` là sàn nên ô tự giãn, và dưới `lg` panel vốn được phép cao
                    thấp khác nhau.
                  */
                  <div class="p-4 sm:p-6 lg:absolute lg:inset-0 lg:p-10">
                    <Image
                      src={s.image}
                      alt={`${s.title} — ${s.note}`}
                      width={1200}
                      format="webp"
                      quality={82}
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                      class="mx-auto h-auto w-full max-w-96 rounded-2xl object-contain lg:size-full lg:max-w-none"
                    />
                  </div>
                ) : (
                  /*
                    Ảnh chụp lớp học phủ kín nửa panel — cắt cạnh thay vì hiện trọn.

                    Có bản 1600px vì `sizes` khai 50vw: màn 1440 rộng thì ô ảnh đã là 720px
                    CSS, màn Retina cần 1440px thật. Dừng ở 1024 như trước thì trình duyệt
                    phải kéo bản 1024 lên gấp rưỡi — đó là chỗ ảnh giáo trình bị nhoè.
                  */
                  <Image
                    src={s.image}
                    alt={s.title}
                    widths={[640, 1024, 1600]}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                    format="webp"
                    quality={88}
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                    class="absolute inset-0 size-full object-cover"
                  />
                )
              }

              {
                /* Vệt mờ nối ảnh phủ kín vào cột chữ — chỉ những panel không `contain`,
                   vì ảnh `contain` đã có lề xám bao quanh, phủ thêm vệt mờ lên đó chỉ
                   làm bẩn một góc nền. */
                !s.contain && (
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-0 hidden bg-linear-to-r from-background via-background/10 to-transparent lg:block"
                  />
                )
              }
            </div>
          </div>
        ))
      }

      {/*
        Dưới lg dải tab nằm TRÊN panel: để dưới thì bấm tab xong nội dung nhảy khỏi
        khung nhìn.

        Lưới 2×2 chứ không cuộn ngang. Cuộn ngang thì tab thứ ba luôn bị mép thẻ cắt
        ngang chữ ("Ứng dụ…") — trông như lỗi dựng trang chứ không như một gợi ý là
        còn tab bên phải, mà tab bị cắt thì cũng không đọc được để mà muốn cuộn. Hai
        hàng cao ~140px, đổi lại là thấy đủ bốn lựa chọn ngay.
      */}
      <div
        role="tablist"
        aria-label="Giá trị khác biệt của SaigonHSK"
        class="grid grid-cols-2 gap-px border-b border-border bg-border order-first lg:order-0 lg:grid-cols-4 lg:border-b-0 lg:border-t"
      >
        {
          slides.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`why-tab-${i}`}
              data-tab={i}
              data-active={i === 0 ? "true" : "false"}
              aria-controls={`why-panel-${i}`}
              aria-selected={i === 0}
              class="group relative cursor-pointer bg-background px-3 py-3.5 text-center transition-colors data-[active=true]:bg-brand-ink-50/60 sm:px-6 sm:py-5"
            >
              <span
                aria-hidden="true"
                class="absolute inset-x-0 bottom-0 h-0.5 bg-brand-red-600 opacity-0 transition-opacity group-data-[active=true]:opacity-100 lg:bottom-auto lg:top-0"
              />
              <span class="block text-[0.8125rem] font-bold leading-snug text-muted-foreground transition-colors group-hover:text-brand-ink-900 group-data-[active=true]:text-brand-ink-900 sm:text-sm">
                {s.tab}
              </span>
              <span class="mt-0.5 block text-[0.6875rem] leading-snug text-muted-foreground sm:mt-1 sm:text-xs">
                {s.tabNote}
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-value-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];

    const show = (index: number) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.dataset.active = String(active);
        tab.setAttribute("aria-selected", String(active));
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
    };

    tabs.forEach((tab, i) => tab.addEventListener("click", () => show(i)));
  });
</script>
