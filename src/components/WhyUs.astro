---
import SectionHeading from "@/components/SectionHeading.astro";
import ValueIllustration from "@/components/ValueIllustration.astro";
import { values, contact } from "@/data/site";
import { ICONS } from "@/lib/icons";
---

<section id="why-us" class="relative overflow-hidden bg-background scroll-mt-24">
  <div class="container relative z-10 mx-auto px-6">
    <SectionHeading
      title="Vì sao học viên chọn"
      highlight="Hoa văn SaigonHSK?"
      description="SaigonHSK là trung tâm đào tạo tiếng Hoa chất lượng cao, uy tín tại TP.HCM. Với những giá trị khác biệt, chúng tôi thực hiện sứ mệnh truyền đạt tinh hoa ngôn ngữ cho cộng đồng."
    />

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        values.map((v) => {
          return (
            <article
              class="group flex flex-col overflow-hidden rounded-[1.75rem] bg-brand-ink-50 transition-transform duration-300 hover:-translate-y-1"
            >
              <ValueIllustration
                name={v.id}
                alt={v.title}
                class="bg-brand-ink-100/60 transition-transform duration-500 group-hover:scale-105"
              />

              <div class="flex flex-1 flex-col p-7">
                <h3 class="text-xl font-extrabold text-brand-ink-900">
                  {v.title}
                </h3>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">{v.desc}</p>
              </div>
            </article>
          );
        })
      }
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-6 rounded-3xl bg-brand-ink-50 p-8 md:flex-row md:p-10"
    >
      <div>
        <p class="text-2xl font-black text-brand-ink-900 md:text-3xl">
          Học thử miễn phí một buổi
        </p>
        <p class="mt-2 max-w-xl text-base leading-relaxed text-muted-foreground">
          Ngồi học cùng lớp đang mở để cảm nhận cách giảng dạy trước khi quyết định
          đăng ký khóa học.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/register"
          class="group inline-flex items-center gap-2 rounded-full bg-brand-red-600 px-8 py-4 text-sm font-bold text-white shadow-lg shadow-brand-red-600/25 transition-all hover:-translate-y-0.5 hover:bg-brand-red-700"
        >
          Đăng ký học thử
          <span
            class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
            set:html={ICONS.arrow}
          />
        </a>
        <a
          href={`tel:${contact.phonePrimaryRaw}`}
          class="inline-flex items-center gap-2 rounded-full bg-background px-6 py-4 text-sm font-bold text-foreground transition-transform hover:-translate-y-0.5"
        >
          <span class="text-brand-red-600 [&>svg]:size-4" set:html={ICONS.phone} />
          {contact.phonePrimary}
        </a>
      </div>
    </div>
  </div>
</section>
