---
import { libraryCategories, type LibraryArticle } from "@/data/library";

/**
 * Hàng chip chuyên mục ở đầu Thư viện — "Tất cả 24 · Thành ngữ 3 · …".
 *
 * Chip là **link thật** chứ không phải nút lọc bằng JS: `/library` và
 * `/library/<chuyên-mục>` đã là hai route có sẵn, nên lọc bằng điều hướng cho mỗi
 * chuyên mục một URL riêng để Google index và người đọc gửi cho nhau — thứ mà bộ
 * lọc client-side không có. Đổi lại là một lượt tải trang cho mỗi lần đổi chip,
 * chấp nhận được với 12 chuyên mục tĩnh.
 *
 * Chuyên mục không có bài nào vẫn hiện, mờ đi và không bấm được: giấu chúng làm
 * hàng chip nhảy chỗ mỗi lần trung tâm đăng bài mới.
 */

interface Props {
  articles: LibraryArticle[];
  /** Khoá chuyên mục đang mở; rỗng = đang ở trang "Tất cả". */
  activeKey?: string;
}

const { articles, activeKey = "" } = Astro.props;

const counts = new Map<string, number>();
for (const article of articles) {
  counts.set(article.category.key, (counts.get(article.category.key) ?? 0) + 1);
}

const chips = [
  { key: "", label: "Tất cả", href: "/library", count: articles.length },
  ...libraryCategories.map((category) => ({
    key: category.key,
    label: category.label,
    href: category.slug,
    count: counts.get(category.key) ?? 0,
  })),
];
---

{/* `w-full` + `justify-center`: hero canh giữa dàn con theo cột, nên nếu không ép
    full width thì <nav> co lại bằng bề rộng nội dung và hàng chip ngắt dòng sớm. */}
<nav aria-label="Chuyên mục Thư viện" class="mt-8 w-full">
  <ul class="flex flex-wrap justify-center gap-2.5">
    {
      chips.map((chip) => {
        const active = chip.key === activeKey;
        const empty = chip.count === 0 && !active;

        return (
          <li>
            <a
              href={empty ? undefined : chip.href}
              aria-current={active ? "page" : undefined}
              aria-disabled={empty ? "true" : undefined}
              class:list={[
                "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold transition-colors",
                active
                  ? "border-brand-ink-900 bg-brand-ink-900 text-white"
                  : empty
                    ? "pointer-events-none border-border text-brand-ink-300"
                    : "border-border text-foreground hover:border-brand-ink-900 hover:bg-brand-ink-50",
              ]}
            >
              {chip.label}
              <span
                class:list={[
                  "rounded-full px-1.5 py-0.5 text-[0.6875rem] font-bold tabular-nums",
                  active ? "bg-white/15 text-white" : "bg-brand-ink-50 text-muted-foreground",
                ]}
              >
                {chip.count}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
