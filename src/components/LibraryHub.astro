---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import ArticleGrid from "@/components/ArticleGrid.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { site } from "@/data/site";
import { clampDescription, itemListSchema } from "@/lib/seo";
import { collectionPageSchema } from "@/lib/schema";
import type { LibraryArticle } from "@/data/library";

/**
 * Khung chung của `/library` và `/library/<chuyên-mục>`.
 *
 * Hai trang chỉ khác nhau ở tiêu đề và danh sách bài, nên chúng dùng chung một
 * khung. Chuyên mục chọn ở menu header (`/library/<chuyên-mục>`) chứ không còn ở
 * hàng chip trong hero: mỗi trang chỉ nạp và liệt kê đúng chuyên mục đang xem.
 *
 * Không có `EnrollCta`/`RegisterSection` ở cuối như các hub khác — Thư viện là tài
 * liệu đọc miễn phí, chèn lời mời ghi danh vào giữa đường đọc làm loãng nội dung.
 */

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  crumbs: { label: string; href?: string }[];
  glyph?: string;

  /** Bài hiện trong lưới; ở trang chuyên mục chỉ có bài của chuyên mục đó. */
  articles: LibraryArticle[];
  emptyMessage?: string;
}

const {
  title,
  metaTitle,
  description,
  crumbs,
  glyph = "书",
  articles,
  emptyMessage,
} = Astro.props;

const origin = Astro.site?.origin ?? "";
const schemas = [
  // Trang danh mục: `CollectionPage` gộp vào node `WebPage` của Layout để bot phân
  // biệt trang liệt kê với trang nội dung, thay vì coi mọi URL là WebPage như nhau.
  collectionPageSchema({ pathname: Astro.url.pathname, site: Astro.site }),
  itemListSchema(
    metaTitle ?? title,
    articles.map((article) => ({ title: article.title, href: article.slug })),
    origin,
  ),
];
---

<Layout
  title={`${metaTitle ?? title} | ${site.shortName}`}
  description={clampDescription(description)}
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col">
    <PageHero
      title={title}
      description={description}
      crumbs={crumbs}
      glyph={glyph}
      align="center"
    />

    <section class="bg-background pb-16 lg:pb-20">
      <div class="container mx-auto px-6">
        <ArticleGrid articles={articles} emptyMessage={emptyMessage} />
      </div>
    </section>
  </main>
  <Footer />
  <FloatingContact />
</Layout>
