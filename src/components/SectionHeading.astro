---
interface Props {
  title: string;

  highlight?: string;
  description?: string;
  align?: "center" | "left";
  className?: string;
}

const { title, highlight, description, align = "center", className = "" } = Astro.props;

const wrap =
  align === "center"
    ? "mx-auto max-w-3xl text-center items-center"
    : "max-w-3xl text-left items-start";
---

<div class:list={["flex flex-col", wrap, className]}>
  <h2
    class="text-[2rem] font-black leading-[1.05] tracking-tight text-balance text-brand-ink-900 md:text-5xl"
  >
    {title}
    {
      highlight && (
        <span class="mt-1 block text-[2rem] font-black leading-[1.05] tracking-tight text-brand-red-600 md:text-5xl">
          {highlight}
        </span>
      )
    }
  </h2>

  {
    description && (
      <p class="mt-6 max-w-2xl text-2xl leading-relaxed text-muted-foreground md:text-[1.0625rem]">
        {description}
      </p>
    )
  }
</div>
