---
interface Props {
  title: string;

  highlight?: string;
  /** true: highlight nằm cùng hàng với title (không xuống dòng) */
  inlineHighlight?: boolean;
  description?: string;
  align?: "center" | "left";
  className?: string;
}

const {
  title,
  highlight,
  inlineHighlight = false,
  description,
  align = "center",
  className = "",
} = Astro.props;

const wrap =
  align === "center"
    ? "mx-auto max-w-3xl text-center items-center"
    : "max-w-3xl text-left items-start";
---

<div class:list={["flex flex-col", wrap, className]}>
  <h2
    class="text-[2rem] font-black leading-[1.05] tracking-tight text-balance text-brand-ink-900 md:text-5xl"
  >
    {title}
    {inlineHighlight && " "}
    {
      highlight && (
        <span
          class:list={[
            "text-[2rem] font-black leading-[1.05] tracking-tight text-brand-red-600 md:text-5xl",
            inlineHighlight ? "inline whitespace-nowrap" : "mt-1 block",
          ]}
        >
          {highlight}
        </span>
      )
    }
  </h2>

  {
    description && (
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg">
        {description}
      </p>
    )
  }
</div>
