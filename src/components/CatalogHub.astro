---
/**
 * Khung trang tổng quan (hub) cho các nhóm mục: khóa học, ôn tập, thư viện…
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { ICONS } from "@/lib/icons";
import { site } from "@/data/site";
import { clampDescription, itemListSchema } from "@/lib/seo";

export type HubCard = { title: string; summary: string; href: string; tag?: string };
export type HubGroup = { title: string; desc?: string; cards: HubCard[] };

interface Props {
  title: string;
  description: string;
  metaTitle?: string;
  crumbs: { label: string; href?: string }[];
  glyph?: string;
  groups: HubGroup[];
  /** Số cột của lưới card. */
  columns?: 3 | 4;
}

const {
  title,
  description,
  metaTitle,
  crumbs,
  glyph = "课",
  groups,
  columns = 3,
} = Astro.props;

const origin = Astro.site?.origin ?? "";
const schemas = [
  itemListSchema(
    metaTitle ?? title,
    groups.flatMap((g) => g.cards.map((c) => ({ title: c.title, href: c.href }))),
    origin,
  ),
];

const gridClass =
  columns === 4
    ? "grid gap-5 sm:grid-cols-2 lg:grid-cols-4"
    : "grid gap-5 sm:grid-cols-2 lg:grid-cols-3";
---

<Layout
  title={`${metaTitle ?? title} | ${site.shortName}`}
  description={clampDescription(description)}
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <PageHero title={title} description={description} crumbs={crumbs} glyph={glyph} />

    <section class="bg-background">
      <div class="container mx-auto space-y-16 px-6">
        {
          groups.map((group) => (
            <div>
              <h2 class="font-bricolage text-2xl font-black text-brand-ink-900 md:text-3xl dark:text-white">
                {group.title}
              </h2>
              {group.desc && (
                <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground md:text-base">
                  {group.desc}
                </p>
              )}

              <div class:list={["mt-8", gridClass]}>
                {group.cards.map((card) => (
                  <a
                    href={card.href}
                    class="group flex flex-col rounded-3xl bg-brand-ink-50 p-6 transition-transform duration-300 hover:-translate-y-1.5 dark:bg-white/[0.04]"
                  >
                    {card.tag && (
                      <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand-red-600 dark:text-brand-red-400">
                        {card.tag}
                      </span>
                    )}
                    <h3 class="mt-1 font-bricolage text-lg font-extrabold leading-snug text-brand-ink-900 dark:text-white">
                      {card.title}
                    </h3>
                    <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                      {card.summary}
                    </p>
                    <span class="mt-auto flex items-center gap-2 pt-5 text-sm font-bold text-brand-red-600 dark:text-brand-red-400">
                      Xem chi tiết
                      <span
                        class="transition-transform group-hover:translate-x-1.5 [&>svg]:size-4"
                        set:html={ICONS.arrow}
                      />
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <RegisterSection />
    <CtaSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
