---
/**
 * Hoa văn vẽ tay dùng chung cho các section — cùng ngôn ngữ thị giác với hero.
 * Ví dụ: <Doodle name="asterisk" class="absolute left-6 top-10 size-12 text-brand-red-300" />
 */
interface Props {
  name: "asterisk" | "spiral" | "flower" | "wave" | "arrow" | "underline" | "star";
  class?: string;
}

const { name, class: className = "" } = Astro.props;

const PATHS: Record<Props["name"], { box: string; d: string; width?: number }> = {
  asterisk: { box: "0 0 48 48", d: "M24 6v36M9 12l30 24M39 12L9 36", width: 3 },
  spiral: {
    box: "0 0 40 40",
    d: "M20 6c-7 0-12 5-12 12s5 12 12 12 10-4 10-9-4-8-8-8-6 2-6 5 2 4 4 4",
    width: 3,
  },
  flower: {
    box: "0 0 48 48",
    d: "M24 8c5 0 6 7 2 9s-9-1-7-5m5 6c8 0 12 5 12 9s-6 7-9 3m-3-12c-8 0-13 4-13 9s7 8 10 3m3-12c-3 6-1 14 3 18m-6-18c3 6 1 14-3 18",
    width: 2.5,
  },
  wave: { box: "0 0 120 24", d: "M2 16c14-16 26 10 40-4s26 12 38-4 24 6 38-2", width: 2.5 },
  arrow: {
    box: "0 0 120 60",
    d: "M4 12c30 34 66 40 108 30m0 0-16-12m16 12-20 8",
    width: 2.5,
  },
  underline: { box: "0 0 200 14", d: "M3 9c44-6 110-8 194-3", width: 4 },
  star: { box: "0 0 40 40", d: "M20 4v32M6 12l28 16M34 12L6 28", width: 2.5 },
};

const { box, d, width = 2.5 } = PATHS[name];
---

<svg
  class:list={["pointer-events-none select-none", className]}
  viewBox={box}
  fill="none"
  aria-hidden="true"
>
  <path
    d={d}
    stroke="currentColor"
    stroke-width={width}
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
