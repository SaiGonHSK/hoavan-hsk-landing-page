---
import SectionHeading from "@/components/SectionHeading.astro";
import Doodle from "@/components/Doodle.astro";
import { courses, featuredCourses } from "@/data/courses";
import { ICONS } from "@/lib/icons";

interface Props {
  /** Tắt tiêu đề khi section được dùng bên trong trang đã có heading riêng. */
  showHeading?: boolean;
  /** Chỉ hiện N chương trình nổi bật (trang chủ) — bỏ trống là hiện đủ 10. */
  limit?: number;
}
const { showHeading = true, limit } = Astro.props;

const list = limit ? featuredCourses.slice(0, limit) : courses;
const hasMore = list.length < courses.length;
---

<section id="courses" class="relative overflow-hidden bg-background scroll-mt-24">
  <Doodle
    name="spiral"
    class="absolute left-[5%] top-32 hidden size-10 text-brand-red-400 lg:block"
  />

  <div class="container relative z-10 mx-auto px-6">
    {
      showHeading && (
        <SectionHeading
          title={hasMore ? "Chương trình" : "Mười chương trình cho"}
          highlight={hasMore ? "nổi bật nhất" : "mọi mục tiêu tiếng Hoa"}
          description="Từ lớp vỡ lòng đến lớp luyện thi cam kết đầu ra, từ giao tiếp cấp tốc đến lớp doanh nghiệp và VIP 1 kèm 1 — mỗi chương trình đều có lộ trình, thời lượng và chuẩn đầu ra rõ ràng."
        />
      )
    }

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        list.map((c) => (
          <a
            href={`/courses/programs/${c.slug}`}
            class={"group relative flex flex-col rounded-3xl bg-brand-ink-50 p-7 transition-transform duration-300 hover:-translate-y-1.5 dark:bg-white/[0.04]"}
          >
            {c.featured && (
              <span class="absolute -top-3 right-6 rounded-full bg-brand-red-600 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] leading-none text-white">
                Nổi bật
              </span>
            )}

            <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand-red-600 dark:text-brand-red-400">
              {c.goal}
            </span>

            <h3 class="mt-1 font-bricolage text-xl font-extrabold leading-snug text-brand-ink-900 dark:text-white">
              {c.title}
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
              {c.summary}
            </p>

            <p class="mt-5 text-xs leading-relaxed text-muted-foreground">
              <span class="font-bold text-foreground">Đầu vào:</span> {c.entry}
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              {c.tags.map((t) => (
                <span class="rounded-full bg-background px-3 py-1 text-[11px] font-medium text-muted-foreground dark:bg-white/[0.06]">
                  {t}
                </span>
              ))}
            </div>

            <span class="mt-auto flex items-center gap-2 pt-6 text-sm font-bold text-brand-red-600 dark:text-brand-red-400">
              Xem chi tiết
              <span
                class="transition-transform group-hover:translate-x-1.5 [&>svg]:size-4"
                set:html={ICONS.arrow}
              />
            </span>
          </a>
        ))
      }
    </div>

    {
      hasMore && (
        <div class="mt-12 text-center">
          <a
            href="/courses"
            class="group inline-flex items-center gap-2 rounded-full bg-brand-ink-900 px-7 py-4 text-sm font-bold text-white transition-transform hover:-translate-y-0.5 dark:bg-white/10"
          >
            Xem thêm {courses.length - list.length} chương trình khác
            <span
              class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
              set:html={ICONS.arrow}
            />
          </a>
        </div>
      )
    }
  </div>
</section>
