---
import SectionHeading from "@/components/SectionHeading.astro";
import CourseBadge from "@/components/CourseBadge.astro";
import { courses, featuredCourses } from "@/data/courses";
import { ICONS } from "@/lib/icons";

interface Props {

  showHeading?: boolean;

  limit?: number;
}
const { showHeading = true, limit } = Astro.props;

const list = limit ? featuredCourses.slice(0, limit) : courses;
const hasMore = list.length < courses.length;
---

<section id="courses" class="relative overflow-hidden bg-background scroll-mt-24">
  <div class="container relative z-10 mx-auto px-6">
    {
      showHeading && (
        <SectionHeading
          title={hasMore ? "Chương trình" : "Mười chương trình cho"}
          highlight={hasMore ? "nổi bật nhất" : "mọi mục tiêu tiếng Trung"}
          description="Từ lớp vỡ lòng đến lớp luyện thi cam kết đầu ra, từ giao tiếp cấp tốc đến lớp doanh nghiệp và VIP 1 kèm 1 — mỗi chương trình đều có lộ trình, thời lượng và chuẩn đầu ra rõ ràng."
        />
      )
    }

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        list.map((c) => (
          <a
            href={`/courses/programs/${c.slug}`}
            class={"group flex flex-col rounded-3xl bg-brand-ink-50 p-3 transition-transform duration-300 hover:-translate-y-1.5"}
          >

            <div class="relative h-40 overflow-hidden rounded-2xl">
              <CourseBadge
                title={c.title}
                class="transition-transform duration-300 group-hover:scale-105"
              />
            </div>

            <div class="flex flex-1 flex-col px-4 pb-3 pt-5">
              <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand-red-600">
                {c.goal}
              </span>

              <h3 class="mt-1 text-xl font-extrabold leading-snug text-brand-ink-900">
                {c.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                {c.summary}
              </p>

              <p class="mt-5 text-xs leading-relaxed text-muted-foreground">
                <span class="font-bold text-foreground">Đầu vào:</span> {c.entry}
              </p>

              <div class="mt-4 flex flex-wrap gap-2">
                {c.tags.map((t) => (
                  <span class="rounded-full bg-background px-3 py-1 text-[11px] font-medium text-muted-foreground">
                    {t}
                  </span>
                ))}
              </div>

              <span class="mt-auto flex items-center gap-2 pt-6 text-sm font-bold text-brand-red-600">
                Xem chi tiết<span class="sr-only"> khoá {c.title}</span>
                <span
                  class="transition-transform group-hover:translate-x-1.5 [&>svg]:size-4"
                  set:html={ICONS.arrow}
                />
              </span>
            </div>
          </a>
        ))
      }
    </div>

    {
      hasMore && (
        <div class="mt-12 text-center">
          <a
            href="/courses"
            class="group inline-flex items-center gap-2 rounded-full border border-border bg-background px-8 py-4 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
          >
            Xem thêm {courses.length - list.length} chương trình khác
            <span
              class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
              set:html={ICONS.arrow}
            />
          </a>
        </div>
      )
    }
  </div>
</section>
