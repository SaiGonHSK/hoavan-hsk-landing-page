---
import SectionHeading from "@/components/SectionHeading.astro";
import CourseIllustration from "@/components/CourseIllustration.astro";
import { courses, featuredCourses } from "@/data/courses";
import { ICONS } from "@/lib/icons";

/**
 * Thứ tự ưu tiên cho khung hình đầu thẻ: ảnh khoá học (`c.image`) → minh hoạ
 * vector (những slug dưới đây) → icon. Khoá nào đã có ảnh thì ảnh thắng.
 */
const COURSE_ART = new Set([
  "luyen-thi-hsk",
  "luyen-thi-tocfl",
  "tieng-hoa-so-cap",
  "tieng-hoa-trung-cap",
  "tieng-hoa-cao-cap",
  "tieng-hoa-giao-tiep-cap-toc",
  "tieng-hoa-doanh-nghiep",
  "tieng-hoa-vip",
  "tieng-hoa-thieu-nhi",
  "tieng-hoa-nguoi-lon-tuoi",
]);

interface Props {
  /** Tắt tiêu đề khi section được dùng bên trong trang đã có heading riêng. */
  showHeading?: boolean;
  /** Chỉ hiện N chương trình nổi bật (trang chủ) — bỏ trống là hiện đủ 10. */
  limit?: number;
}
const { showHeading = true, limit } = Astro.props;

const list = limit ? featuredCourses.slice(0, limit) : courses;
const hasMore = list.length < courses.length;
---

<section id="courses" class="relative overflow-hidden bg-background scroll-mt-24">
  <div class="container relative z-10 mx-auto px-6">
    {
      showHeading && (
        <SectionHeading
          title={hasMore ? "Chương trình" : "Mười chương trình cho"}
          highlight={hasMore ? "nổi bật nhất" : "mọi mục tiêu tiếng Hoa"}
          description="Từ lớp vỡ lòng đến lớp luyện thi cam kết đầu ra, từ giao tiếp cấp tốc đến lớp doanh nghiệp và VIP 1 kèm 1 — mỗi chương trình đều có lộ trình, thời lượng và chuẩn đầu ra rõ ràng."
        />
      )
    }

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        list.map((c) => (
          <a
            href={`/courses/programs/${c.slug}`}
            class={"group flex flex-col rounded-3xl bg-brand-ink-50 p-3 transition-transform duration-300 hover:-translate-y-1.5"}
          >
            {/* Khung hình đầu thẻ, chữ nghĩa xuống dưới */}
            <div
              class="relative grid h-40 place-items-center overflow-hidden rounded-2xl bg-gradient-to-br from-brand-red-50 to-brand-ink-100"
            >
              {c.image ? (
                <img
                  src={c.image}
                  alt={c.title}
                  loading="lazy"
                  width="3400"
                  height="2513"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              ) : COURSE_ART.has(c.slug) ? (
                <CourseIllustration
                  slug={c.slug}
                  alt={c.title}
                  class="transition-transform duration-300 group-hover:scale-105"
                />
              ) : (
                <span
                  class="relative text-brand-red-600 transition-transform duration-300 group-hover:scale-110 [&>svg]:size-14"
                  set:html={ICONS[c.icon as keyof typeof ICONS] ?? ICONS.book}
                />
              )}
            </div>

            <div class="flex flex-1 flex-col px-4 pb-3 pt-5">
              <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand-red-600">
                {c.goal}
              </span>

              <h3 class="mt-1 text-xl font-extrabold leading-snug text-brand-ink-900">
                {c.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                {c.summary}
              </p>

              <p class="mt-5 text-xs leading-relaxed text-muted-foreground">
                <span class="font-bold text-foreground">Đầu vào:</span> {c.entry}
              </p>

              <div class="mt-4 flex flex-wrap gap-2">
                {c.tags.map((t) => (
                  <span class="rounded-full bg-background px-3 py-1 text-[11px] font-medium text-muted-foreground">
                    {t}
                  </span>
                ))}
              </div>

              <span class="mt-auto flex items-center gap-2 pt-6 text-sm font-bold text-brand-red-600">
                Xem chi tiết
                <span
                  class="transition-transform group-hover:translate-x-1.5 [&>svg]:size-4"
                  set:html={ICONS.arrow}
                />
              </span>
            </div>
          </a>
        ))
      }
    </div>

    {
      hasMore && (
        <div class="mt-12 text-center">
          <a
            href="/courses"
            class="group inline-flex items-center gap-2 rounded-full bg-brand-ink-900 px-7 py-4 text-sm font-bold text-white transition-transform hover:-translate-y-0.5"
          >
            Xem thêm {courses.length - list.length} chương trình khác
            <span
              class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
              set:html={ICONS.arrow}
            />
          </a>
        </div>
      )
    }
  </div>
</section>
