---
import SectionHeading from "@/components/SectionHeading.astro";
import { teachers } from "@/data/teachers";
import { ICONS } from "@/lib/icons";

type Credential = { icon: string; value: string; label: string };

/**
 * Chữ cái đầu của tên, dùng khi giảng viên chưa có ảnh chân dung. Bỏ "Cô/Thầy" vì
 * mọi thẻ đều có, giữ lại tối đa 2 chữ cái để không bị chật.
 */
const initialsOf = (name: string) =>
  name
    .replace(/^(cô|thầy)\s+/i, "")
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();

/**
 * Thành tích lấy nguyên văn từ banner giới thiệu giảng viên (mảng `points`). Giảng
 * viên nào chưa có banner thì dựng tạm từ title + role như trước để thẻ không trống.
 */
const credentialsOf = (t: (typeof teachers)[number]): Credential[] => {
  const points = (t as { points?: readonly string[] }).points ?? [];
  if (points.length > 0) {
    return points.map((point, i) => ({
      // Dòng đầu là học vị; dòng "HSK6, HSKK cao cấp" là chứng chỉ, còn lại là quá trình.
      icon: i === 0 ? ICONS.cap : /^HSK/i.test(point) ? ICONS.target : ICONS.book,
      value: "",
      label: point,
    }));
  }

  const [degree, school = ""] = t.title.split("—").map((s) => s.trim());
  // Giảng viên chưa điền học vị thì bỏ hẳn dòng này thay vì hiện gạch đầu dòng rỗng.
  const lines: Credential[] = degree
    ? [{ icon: ICONS.cap, value: degree, label: school }]
    : [];

  const role = (t as { role?: string }).role;
  if (role) {
    role
      .split("·")
      .map((s) => s.trim())
      .filter(Boolean)
      .forEach((part, i) => {
        lines.push({
          icon: i === 0 ? ICONS.book : ICONS.target,
          value: "",
          label: part,
        });
      });
  }

  return lines;
};
---

<section id="teachers" class="relative overflow-hidden bg-background scroll-mt-24">
  <div class="container relative z-10 mx-auto px-6">
    <SectionHeading title="Đội ngũ" highlight="giảng viên" inlineHighlight />
<!-- 
    <div class="mt-12 flex items-center justify-between gap-6">
      <div class="hidden shrink-0 items-center gap-2 md:flex">
        <button
          type="button"
          data-rail="prev"
          aria-label="Xem giảng viên trước"
          class="inline-flex size-11 cursor-pointer items-center justify-center rounded-full bg-brand-ink-50 text-brand-ink-900 transition-colors hover:bg-brand-ink-100 disabled:cursor-default disabled:opacity-35 [&>svg]:size-4 [&>svg]:rotate-180"
          set:html={ICONS.arrow}
        />
        <button
          type="button"
          data-rail="next"
          aria-label="Xem giảng viên tiếp theo"
          class="inline-flex size-11 cursor-pointer items-center justify-center rounded-full bg-brand-ink-50 text-brand-ink-900 transition-colors hover:bg-brand-ink-100 disabled:cursor-default disabled:opacity-35 [&>svg]:size-4"
          set:html={ICONS.arrow}
        />
      </div>
    </div> -->

    <div
      data-rail="track"
      class="teacher-rail -mx-6 mt-16 flex snap-x snap-mandatory gap-6 overflow-x-auto px-6 pb-2"
    >
      {
        teachers.map((t) => (
          <button
            type="button"
            data-lightbox={t.image || undefined}
            data-caption={t.title ? `${t.name} — ${t.title}` : t.name}
            class:list={[
              "group w-[19rem] shrink-0 snap-start text-left transition-transform duration-300 hover:-translate-y-1.5 sm:w-[22rem] lg:w-[24rem]",
              t.image ? "cursor-zoom-in" : "cursor-default",
            ]}
          >
            <div class="relative overflow-hidden rounded-lg shadow-[0_24px_50px_-36px_rgba(15,23,42,0.5)]">
              {
                t.image ? (
                  <img
                    src={t.image}
                    alt={t.title ? `${t.name} — ${t.title}` : t.name}
                    loading="lazy"
                    width="1080"
                    height="1080"
                    class="aspect-square w-full object-cover"
                  />
                ) : (
                  <div
                    class="flex aspect-square w-full items-center justify-center bg-brand-ink-50"
                    role="img"
                    aria-label={t.name}
                  >
                    <span class="text-6xl font-black text-brand-ink-900/25">
                      {initialsOf(t.name)}
                    </span>
                  </div>
                )
              }

              <div class="absolute inset-0 flex flex-col justify-end gap-3.5 bg-gradient-to-t from-black/85 via-black/55 to-black/10 p-6 opacity-0 backdrop-blur-[3px] transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
                {credentialsOf(t).map((c, i) => (
                  <div
                    class="flex translate-y-4 items-start gap-3 text-white opacity-0 transition-[transform,opacity] duration-500 ease-out group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
                    style={`transition-delay: ${120 + i * 90}ms`}
                  >
                    <span
                      class="mt-0.5 shrink-0 text-white/80 [&>svg]:size-5"
                      set:html={c.icon}
                    />
                    {/*
                      Thành tích lấy từ banner nên có dòng rất dài; cho xuống hàng và
                      chặn ở 3 dòng thay vì truncate — truncate cắt mất gần hết câu.
                    */}
                    <p class="line-clamp-3 min-w-0 text-sm leading-snug">
                      {c.value && <span class="font-bold">{c.value} </span>}
                      <span class="text-white/85">{c.label}</span>
                    </p>
                  </div>
                ))}
              </div>
            </div>

            <p class="mt-4 px-1 text-base font-extrabold leading-snug text-brand-ink-900">
              {t.name}
            </p>
            {
              t.title && (
                <p class="mt-1 px-1 text-base leading-relaxed text-muted-foreground">
                  {t.title}
                </p>
              )
            }
          </button>
        ))
      }
    </div>
  </div>
</section>

<style>
  .teacher-rail {
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .teacher-rail::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-rail="track"]');
  const prev = document.querySelector<HTMLButtonElement>('[data-rail="prev"]');
  const next = document.querySelector<HTMLButtonElement>('[data-rail="next"]');

  if (track && prev && next) {

    const step = () => {
      const card = track.querySelector<HTMLElement>("button");
      const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 1;
      prev.disabled = track.scrollLeft <= 0;
      next.disabled = track.scrollLeft >= max;
    };

    prev.addEventListener("click", () => track.scrollBy({ left: -step() }));
    next.addEventListener("click", () => track.scrollBy({ left: step() }));
    track.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    sync();
  }
</script>
