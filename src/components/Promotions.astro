---
import HeroBackdrop from "@/components/HeroBackdrop.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { promotions, promotionNote } from "@/data/promotions";
import { ICONS } from "@/lib/icons";

/**
 * Ở bố cục hai cột (`md`), một danh sách lẻ để lại đúng một tấm phiếu đứng một mình nửa
 * hàng cuối — nó lại chính là tấm có nhiều nội dung nhất (hai mức của ưu đãi nhóm) nên nửa
 * hàng đó vừa trống một bên vừa cao gấp rưỡi hàng trên. Cho tấm cuối ăn hết hàng thì hàng
 * cuối kín và thấp xuống.
 *
 * Tính theo số phần tử chứ không viết cứng "tấm thứ ba": danh sách này còn được sửa mỗi khi
 * trung tâm đổi chương trình, và thêm một mục nữa là quy tắc tự đảo chiều.
 */
const lastSpansRow = promotions.length % 2 === 1;

/**
 * Ba chương trình ưu đãi cố định của trung tâm, vẽ thành ba tấm phiếu giảm giá.
 *
 * Vì sao là hình phiếu chứ không phải ba thẻ vuông như các khối khác của trang: cả trang
 * chủ đã có bốn khối dùng thẻ bo góc (`Courses`, `WhyUs`, `Testimonials`, `FAQ`), nên một
 * bộ thẻ nữa sẽ trôi qua mắt. Phiếu có hai nửa và một đường răng cưa ở giữa — đó là hình
 * mà người đọc nhận ra ngay là "cái để dùng", và nó tách con số ra một nửa riêng nên đọc
 * lướt cũng thấy được 5% / 200.000đ.
 *
 * Nền dùng lại `HeroBackdrop` ở dạng `band`: khối này nằm ngay dưới hero, cùng lưới kẻ và
 * cùng hai vệt sáng thì hai khối đọc ra một mạch, thay vì hero xong là rơi thẳng vào nền
 * trắng của phần còn lại.
 */
---

{/*
  `py` của riêng khối này — khác các section khác trên trang chủ (chúng không có `py`, chỉ
  ăn theo `gap` của `<main>`). Ở đây nền là một dải có màu, nên nó cần khoảng đệm nằm TRONG
  dải: không có `py` thì mảng xám ôm sát chữ và đọc ra là một cái hộp, không phải một dải.

  `isolate` + `overflow-hidden`: điều kiện bắt buộc của `HeroBackdrop` — xem chú thích ở
  đầu file đó.
*/}
<section
  id="promotions"
  class="promo-section relative isolate scroll-mt-24 overflow-hidden py-14 sm:py-16 lg:py-20"
>
  <HeroBackdrop variant="band" stickers="none" />

  <div class="container relative mx-auto px-6">
    <SectionHeading
      note="Ưu đãi cố định"
      title="Ưu đãi học phí"
      highlight="áp dụng quanh năm"
      description="Ba chương trình áp dụng cố định tại SaigonHSK, không giới hạn thời gian."
    />

    {/*
      Hai cột chỉ từ `md` chứ không từ `sm`: ở đúng 640px, hai cột cho mỗi tấm phiếu 286px,
      trừ nửa trái và hai lề còn 142px cho phần chữ — HẸP HƠN cả bản một cột trên điện thoại
      375px (183px). Một breakpoint làm chữ chật hơn khổ máy nhỏ hơn nó thì không nên có.
    */}
    <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:mt-12 lg:grid-cols-3 lg:gap-6">
      {
        promotions.map((p, i) => (
          <li
            class:list={[
              "promo-card relative",
              `is-${p.accent}`,
              lastSpansRow &&
                i === promotions.length - 1 &&
                "md:col-span-2 lg:col-span-1",
            ]}
          >
            {/*
              Ba lớp dựng nên hình cái phiếu, và cả ba đều nằm ngoài luồng nội dung:

                `promo-shadow` — chỉ để đổ bóng. Bóng phải ở một thẻ BỌC NGOÀI chứ không đặt
                  thẳng lên `promo-edge`: theo thứ tự vẽ của CSS thì `filter` chạy TRƯỚC
                  `mask`, nên bóng đặt cùng thẻ với mặt nạ sẽ bị chính mặt nạ đó cắt mất.
                `promo-edge` — nét viền: một mảng đặc màu `ink-200` phủ kín phiếu.
                `promo-face` — mặt phiếu, thụt vào 1px nên chỉ chừa lại đúng 1px của lớp
                  dưới làm nét viền.

              Vì sao phải hai lớp cho một cái viền: hai lỗ tròn ở đầu và cuối đường răng cưa
              là lỗ THẬT, khoét bằng `mask` để nhìn xuyên xuống nền. Mà `mask` cắt luôn cả
              `border` lẫn `box-shadow: inset`, nên viền vẽ bằng hai cách đó sẽ đứt ở đúng
              hai cung tròn. Cho lớp dưới rộng hơn lớp trên 1px thì nét viền chạy vòng theo
              cả hai cung.

              Vì sao phải là lỗ thật: nền của khối là một dải chuyển sắc, nên hai "lỗ" vẽ
              bằng hai chấm tròn tô màu sẽ lệch sắc so với nền ngay phía sau chúng.
            */}
            <div class="promo-shadow pointer-events-none absolute inset-0">
              <div class="promo-edge absolute inset-0" />
              <div class="promo-face absolute inset-px" />
            </div>

            {/* `h-full`: các thẻ trong cùng hàng cao bằng nhau (thẻ "Đăng ký theo nhóm" có
                thêm hai mức), nên hàng nội dung phải cao hết thẻ thì con số ở nửa trái mới
                nằm đúng giữa chiều cao của phiếu. */}
            <div class="relative flex h-full items-stretch">
              <div class="promo-stub flex shrink-0 flex-col items-center justify-center px-2 py-6 text-center">
                {/* Dùng `--accent-deep` chứ không phải `--accent-ink` như con số: chữ này
                    chỉ 0.6rem nên phải đạt 4.5:1, trong khi con số là chữ lớn nên 3:1 là
                    đủ. Trên nền tô nhạt của nửa trái, `--accent-ink` chỉ được 4.4–4.8:1
                    tuỳ màu — sát ngưỡng quá, và vàng là màu rơi xuống thấp nhất. */}
                {p.valuePrefix && (
                  <span class="promo-prefix mb-1 text-[0.6rem] font-bold tracking-[0.14em] uppercase">
                    {p.valuePrefix}
                  </span>
                )}

                {/*
                  Cỡ chữ theo độ dài con số, không phải một cỡ dùng chung. Nửa trái rộng cố
                  định (`--stub`) nên "200.000" đã chạm hai mép ở 1.35rem, trong khi "5%" ở
                  cùng cỡ đó chỉ chiếm một phần ba bề rộng và đọc ra là ưu đãi nhỏ hơn — dù
                  5% học phí không hề nhỏ hơn 200.000đ. Cho con số ngắn cỡ lớn hơn thì cả ba
                  tấm phiếu có nửa trái nặng ngang nhau.

                  Ngưỡng 4 ký tự vì đó là chỗ hai nhóm tách hẳn nhau: mọi giá trị phần trăm
                  đều dưới 4, mọi giá trị tiền đều từ 7 ký tự trở lên.
                */}
                <span
                  class:list={[
                    "promo-value block leading-none font-black tracking-[-0.02em] whitespace-nowrap",
                    p.value.length <= 4
                      ? "text-[1.8rem] xl:text-[2rem]"
                      : "text-[1.35rem] xl:text-[1.5rem]",
                  ]}
                >
                  {p.value}
                </span>

                <span class="mt-2 block text-[0.62rem] leading-snug font-semibold text-brand-ink-400">
                  {p.unit}
                </span>
              </div>

              {/* Đường răng cưa: một nét đứt chạy đúng chỗ giáp ranh hai nửa, dừng lại
                  trước hai lỗ tròn ở hai đầu. */}
              <div class="promo-perf pointer-events-none absolute" />

              <div class="flex min-w-0 flex-1 flex-col justify-center px-4 py-5 xl:px-5">
                <h3 class="text-[0.95rem] leading-snug font-black text-brand-ink-900 lg:text-base">
                  {p.title}
                </h3>

                <p class="mt-1.5 text-[0.8rem] leading-relaxed text-muted-foreground">
                  {p.desc}
                </p>

                {/* Các mức của ưu đãi bậc thang. `max-w-64`: hai dòng này dàn hai đầu, nên
                    trong tấm phiếu ăn hết hàng ở `md` (rộng ~700px) con số bị đẩy sang tận
                    mép phải, cách nhãn của nó cả gang tay. Chặn bề rộng thì cặp nhãn–số
                    luôn đọc được là một cặp. */}
                {p.tiers && (
                  <ul class="mt-3 max-w-64 space-y-1.5 border-t border-dashed border-brand-ink-200 pt-3">
                    {p.tiers.map((t) => (
                      <li class="flex items-baseline justify-between gap-3 text-[0.78rem]">
                        <span class="text-brand-ink-500">{t.label}</span>
                        <span class="promo-tier font-bold whitespace-nowrap">
                          {t.value}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    {/*
      Ưu đãi theo dịp lễ. Viền nét đứt để nó nối được với ba tấm phiếu ở trên mà không cần
      thêm một tấm phiếu thứ tư — nội dung ở đây là một lời hẹn, không phải một ưu đãi đang
      áp dụng, nên nó không được mang cùng hình dạng với ba cái trên.
    */}
    <p
      class="mx-auto mt-7 flex max-w-2xl items-center justify-center gap-2.5 rounded-full border border-dashed border-brand-ink-200 bg-background/70 px-5 py-3 text-center text-xs leading-relaxed text-muted-foreground sm:text-[0.8rem] lg:mt-8"
    >
      {/* Icon để màu mực chứ không lấy một trong ba màu nhấn: chọn màu nào cũng thành ra
          dòng này thuộc về một trong ba tấm phiếu, mà nó nói về chuyện thứ tư. */}
      <span
        class="shrink-0 text-brand-ink-400 [&>svg]:size-4"
        aria-hidden="true"
        set:html={ICONS.calendar}
      />
      {promotionNote}
    </p>
  </div>
</section>

<style>
  /*
    BA MÀU NHẤN CỦA BA TẤM PHIẾU.

    Mỗi tấm mang một màu gắn với nghĩa của chính ưu đãi đó — xem `accent` trong
    `promotions.ts` để biết màu nào đi với ưu đãi nào và vì sao.

    Mỗi màu chỉ có ba giá trị, không phải một thang mười một bậc: khối này dùng đúng ba
    chỗ, thêm bậc chỉ tạo ra chỗ để chọn sai.

      `--accent-tint` — nền tô nửa trái phiếu
      `--accent-ink`  — con số và hai mức của ưu đãi bậc thang
      `--accent-deep` — cái nhãn 0.6rem trên con số, đậm hơn một bậc vì cỡ chữ nhỏ cần
                        tương phản cao hơn (xem chú thích ở chỗ dùng)
      `--accent-perf` — đường răng cưa

    BA MÀU ĐƯỢC CÂN THEO ĐỘ SÁNG, KHÔNG PHẢI CHỌN THEO SẮC. Đây là điều kiện bắt buộc chứ
    không phải tinh chỉnh: ba tấm phiếu đứng cạnh nhau và cùng cỡ chữ, nên tấm nào có màu
    tối hơn sẽ đọc ra là ưu đãi lớn hơn. Cả ba `--accent-ink` đều rơi vào khoảng 4.9–5.3:1
    trên nền trắng (vàng 4.9, lá 5.0, dương 5.3) nên không tấm nào nặng hơn tấm nào.

    Vàng là màu khó nhất: vàng thuần không bao giờ đủ tối để làm chữ, nên phải kéo về phía
    hổ phách. #a16207 chính là `--sticker-gold-deep` đã dùng cho nét chữ trên cuốn sách dán
    ở hero — nên vàng này không phải màu lạ với trang.

    Đỏ thương hiệu KHÔNG có mặt trong ba tấm phiếu, nhưng vẫn giữ ở tiêu đề và cái nhãn
    viết tay của `SectionHeading` phía trên. Đó là chủ ý: phần đầu khối là tiếng nói của
    trung tâm nên nó mang màu của trung tâm, còn ba tấm phiếu là ba món khác nhau nên mỗi
    tấm một màu. Bỏ đỏ ở tiêu đề thì cả khối rời khỏi phần còn lại của trang.
  */
  .promo-card.is-green {
    --accent-tint: #edf8f1;
    --accent-ink: #15803d;
    --accent-deep: #0f5f2d;
    --accent-perf: #b4dcc4;
  }

  /* Nền vàng nhạt hơn hai màu kia một chút (lệch khỏi trắng ~23 đơn vị RGB so với ~25):
     màu ấm luôn tiến ra trước màu lạnh ở cùng độ nhạt, nên tô bằng nhau thì tấm giữa nổi
     lên trước hai tấm bên. */
  .promo-card.is-gold {
    --accent-tint: #fdf7ea;
    --accent-ink: #a16207;
    --accent-deep: #7c4a06;
    --accent-perf: #e8d09a;
  }

  .promo-card.is-blue {
    --accent-tint: #eaf2fd;
    --accent-ink: #1668d1;
    --accent-deep: #124f9e;
    --accent-perf: #b3cdf2;
  }

  .promo-value,
  .promo-tier {
    color: var(--accent-ink);
  }

  .promo-prefix {
    color: var(--accent-deep);
  }

  /*
    Ba số đo dựng nên hình phiếu, khai ở một chỗ vì cả mặt nạ, dải màu nửa trái và đường
    răng cưa đều phải khớp nhau đến từng pixel — lệch một cái là lỗ tròn không nằm trên
    đường răng cưa nữa.

    `--stub` là bề rộng nửa trái, tính từ mép trái phiếu; cũng chính là hoành độ của đường
    răng cưa và tâm hai lỗ tròn.
  */
  /*
    `--stub` phải vừa với khổ CHẬT NHẤT mà thẻ gặp phải, không phải khổ rộng nhất: đó là
    1024px — ba cột trong khung 64rem, mỗi thẻ 309px. Nới nửa trái ở đó là lấy chỗ của phần
    chữ, và phần chữ hết chỗ trước.
  */
  .promo-card {
    --stub: 6.75rem;
    --notch: 0.6rem;
    --radius: 1.125rem;
  }

  /* Chỉ nới ở `xl`: đó là mốc đầu tiên khung rộng ra 80rem nên mỗi thẻ được 394px, dư chỗ
     cho cả hai nửa. */
  @media (min-width: 1280px) {
    .promo-card {
      --stub: 7.25rem;
    }
  }

  .promo-shadow {
    filter: drop-shadow(0 14px 24px rgba(18, 19, 22, 0.08));
  }

  /*
    Hai lỗ tròn khoét ở mép trên và mép dưới, tâm nằm ngay trên đường răng cưa.

    `transparent 99%, #000 100%`: chuyển từ trong suốt sang đục trong 1% cuối bán kính —
    đủ gắt để ra một cái lỗ có mép rõ, mà vẫn còn một chút để mép cung không bị răng cưa.

    `mask-composite: intersect`: mỗi lớp gradient chỉ khoét MỘT lỗ và để nguyên phần còn
    lại, nên phải lấy giao của hai lớp thì cả hai lỗ mới cùng hiện. Mặc định là `add`, tức
    hợp của hai lớp — mà phần đục của lớp này phủ đúng lỗ của lớp kia, kết quả là không lỗ
    nào bị khoét cả.
  */
  .promo-edge {
    background: var(--brand-ink-200);
    border-radius: var(--radius);
    mask:
      radial-gradient(
        circle var(--notch) at var(--stub) 0,
        transparent 99%,
        #000 100%
      ),
      radial-gradient(
        circle var(--notch) at var(--stub) 100%,
        transparent 99%,
        #000 100%
      );
    mask-composite: intersect;
  }

  /*
    Mặt phiếu, thụt vào 1px so với `promo-edge`. Vì hệ toạ độ của nó lệch 1px so với lớp
    dưới, mọi con số ở đây phải trừ/cộng lại đúng 1px đó:

      - tâm hai lỗ: `(--stub - 1px, -1px)` và `(--stub - 1px, 100% + 1px)`
      - bán kính lỗ: `--notch + 1px`, để quanh cung tròn chừa lại đúng 1px của lớp dưới —
        bằng bề dày nét viền ở phần còn lại của phiếu
      - chỗ đổi màu của nửa trái: `--stub - 1px`

    Nửa trái tô `--accent-tint` bằng chính `background` của lớp này, không thêm một thẻ
    nữa: thẻ đó sẽ nằm chồng lên nửa trên của hai lỗ tròn nên lại phải khoét mặt nạ lần
    thứ ba.
  */
  .promo-face {
    background: linear-gradient(
      to right,
      var(--accent-tint) 0 calc(var(--stub) - 1px),
      var(--background) calc(var(--stub) - 1px) 100%
    );
    border-radius: calc(var(--radius) - 1px);
    mask:
      radial-gradient(
        circle calc(var(--notch) + 1px) at calc(var(--stub) - 1px) -1px,
        transparent 99%,
        #000 100%
      ),
      radial-gradient(
        circle calc(var(--notch) + 1px) at calc(var(--stub) - 1px)
          calc(100% + 1px),
        transparent 99%,
        #000 100%
      );
    mask-composite: intersect;
  }

  /*
    Nét đứt vẽ bằng `repeating-linear-gradient` chứ không phải `border-left: dashed`: kiểu
    `dashed` của trình duyệt tự chọn độ dài gạch theo bề dày nét, ở 1px nó ra một chuỗi
    chấm dày đặc trông như một đường liền mờ. Ở đây gạch 4px, hở 5px — thưa đủ để đọc ra là
    răng cưa.

    Hai đầu dừng cách mép `--notch + 0.3rem`, tức lùi vào một chút so với mép trong của hai
    lỗ tròn: dừng đúng ở mép lỗ thì gạch cuối cùng dính vào cung tròn.

    Đường này ăn màu nhấn, trong khi nét viền quanh phiếu vẫn là xám. Lý do: nó nằm đúng
    chỗ giáp ranh giữa nửa tô màu và nửa trắng, nên tô màu ở đó là kéo dài cái ranh giới
    vốn đã có. Còn viền quanh phiếu mà ăn màu thì cả tấm thành một khung có màu bao lấy
    một mảng trắng — mắt đọc ra ô nhập liệu, không phải phiếu.
  */
  .promo-perf {
    top: calc(var(--notch) + 0.3rem);
    bottom: calc(var(--notch) + 0.3rem);
    left: calc(var(--stub) - 1px);
    width: 1px;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--accent-perf) 0 4px,
      transparent 4px 9px
    );
  }

  .promo-stub {
    width: var(--stub);
  }
</style>
