---
/**
 * Nút kéo trái/phải cho các dải cuộn ngang (giảng viên, đánh giá, cơ sở vật chất).
 *
 * Cách dùng: bọc dải cuộn trong một thẻ `.group/rail.relative` có `data-rail`,
 * gắn `data-rail-track` lên chính phần tử cuộn, rồi đặt component này bên trong:
 *
 *   <div data-rail class="group/rail relative">
 *     <div data-rail-track class="flex overflow-x-auto ...">…</div>
 *     <RailArrows label="giảng viên" />
 *   </div>
 *
 * Nút chỉ hiện khi hover vào dải (hoặc khi focus bằng bàn phím) và tự ẩn khi đã
 * cuộn hết đầu/cuối. Trên mobile không có hover nên ẩn hẳn — người dùng swipe.
 */
import { ICONS } from "@/lib/icons";

interface Props {
  /** Danh từ ghép vào aria-label, ví dụ "giảng viên" → "Xem giảng viên trước". */
  label: string;
}

const { label } = Astro.props;

const arrowClass =
  "pointer-events-auto grid size-11 cursor-pointer place-items-center rounded-full border border-border bg-background/90 text-brand-ink-900 opacity-0 shadow-[0_18px_38px_-20px_rgba(15,23,42,0.55)] backdrop-blur transition duration-300 ease-out group-hover/rail:translate-x-0 group-hover/rail:opacity-100 hover:scale-105 hover:bg-background focus-visible:translate-x-0 focus-visible:opacity-100 [&>svg]:size-4";
---

<div
  class="pointer-events-none absolute inset-y-0 left-0 z-20 flex items-center max-md:hidden [@media(hover:none)]:hidden"
>
  <button
    type="button"
    data-rail-prev
    aria-label={`Xem ${label} trước`}
    class:list={[arrowClass, "-translate-x-3 [&>svg]:rotate-180"]}
    set:html={ICONS.arrow}
  />
</div>

<div
  class="pointer-events-none absolute inset-y-0 right-0 z-20 flex items-center max-md:hidden [@media(hover:none)]:hidden"
>
  <button
    type="button"
    data-rail-next
    aria-label={`Xem ${label} tiếp theo`}
    class:list={[arrowClass, "translate-x-3"]}
    set:html={ICONS.arrow}
  />
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-rail]").forEach((rail) => {
    const track = rail.querySelector<HTMLElement>("[data-rail-track]");
    const prev = rail.querySelector<HTMLButtonElement>("[data-rail-prev]");
    const next = rail.querySelector<HTMLButtonElement>("[data-rail-next]");
    if (!track || !prev || !next) return;

    /** Bước kéo = bề rộng một thẻ + gap, để mỗi lần bấm dừng đúng đầu thẻ kế tiếp. */
    const step = () => {
      const card = track.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0;
      return card ? card.offsetWidth + gap : Math.round(track.clientWidth * 0.9);
    };

    const toggle = (btn: HTMLButtonElement, on: boolean) => {
      btn.disabled = !on;
      // Ẩn bằng inline style vì biến thể group-hover của Tailwind sẽ thắng class thường.
      btn.style.opacity = on ? "" : "0";
      btn.style.pointerEvents = on ? "" : "none";
    };

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 1;
      toggle(prev, track.scrollLeft > 0);
      toggle(next, track.scrollLeft < max);
    };

    prev.addEventListener("click", () =>
      track.scrollBy({ left: -step(), behavior: "smooth" }),
    );
    next.addEventListener("click", () =>
      track.scrollBy({ left: step(), behavior: "smooth" }),
    );
    track.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    sync();
  });
</script>
