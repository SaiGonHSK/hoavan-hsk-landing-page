---
import { Image } from "astro:assets";
import { breadcrumbGraph } from "@/lib/schema";

/**
 * Hero riêng của trang lịch khai giảng: nền sáng, tiêu đề canh giữa có nét gạch vẽ tay,
 * bên dưới là giảng viên tách nền đứng trên một khối tròn đỏ, các chip thông tin bay hai
 * bên người.
 *
 * Vì sao không dùng `PageHero`: `PageHero` là hero hai cột dùng chung cho mọi trang phụ.
 * Trang lịch là trang đích của quảng cáo tuyển sinh nên đi theo bố cục riêng — một cột
 * canh giữa, ảnh người tách nền làm trung tâm, và những điều người xem cần biết trước khi
 * chọn lớp (số lớp đang mở, giờ học, sĩ số) nằm ngay quanh ảnh thay vì trong một đoạn văn.
 */
interface Props {
  title: string;

  /**
   * Mệnh đề cuối của tiêu đề, in trên dòng riêng và có nét gạch vẽ tay bên dưới.
   *
   * Tách khỏi `title` vì nét gạch phải bám đúng bề rộng của chữ được nhấn: gạch dưới cả
   * tiêu đề ba dòng thì nó thành cái gạch chân, không còn là nét khoanh tay.
   */
  titleAccent?: string;

  description?: string;

  /**
   * Chỉ dùng cho schema BreadcrumbList (JSON-LD) — breadcrumb không hiển thị trên trang,
   * nhưng vẫn khai báo cho Google hiểu cấu trúc site (giống `PageHero`).
   */
  crumbs?: { label: string; href?: string }[];

  /** Ảnh **đã tách nền**: bố cục này đặt người đứng trên khối tròn, ảnh có nền sẽ che mất khối. */
  image: ImageMetadata;
  imageAlt?: string;

  /**
   * Chip nổi quanh ảnh. Mỗi chip là một câu ngắn, không phải một đoạn.
   *
   * Dưới `lg` chúng xếp thành một hàng cuộn dòng phía trên ảnh; từ `lg` mới bay ra hai bên
   * theo vị trí định sẵn — đặt tuyệt đối ở màn hẹp thì chip nào cũng nằm trên mặt người.
   */
  chips?: string[];

}

const {
  title,
  titleAccent,
  description,
  crumbs = [],
  image,
  imageAlt = "",
  chips = [],
} = Astro.props;

/**
 * Bốn tông chip, lặp lại theo thứ tự. Concept gốc dùng bốn màu pastel không liên quan
 * nhau; ở đây bốn tông đều rút từ đỏ và mực của thương hiệu — vẫn phân biệt được chip
 * nào với chip nào mà không mang thêm màu lạ vào trang.
 */
const CHIP_TONES = [
  // Chip trắng cần viền: nền trang cũng trắng, chỉ có bóng thì nó đọc như chữ trôi nổi
  // chứ không ra hình cái thẻ.
  "border border-brand-ink-100 bg-white text-brand-ink-800 shadow-[0_16px_30px_-18px_rgb(17_24_39/0.35)]",
  "bg-brand-red-600 text-white",
  "bg-brand-red-50 text-brand-red-700",
  "bg-brand-ink-900 text-white",
];

/** Vị trí bay của từng chip (chỉ từ `lg`). Hai bên trái/phải, so le cao thấp. */
const CHIP_SPOTS = [
  "lg:left-0 lg:top-[14%]",
  "lg:left-[7%] lg:top-[48%]",
  "lg:right-0 lg:top-[18%]",
  "lg:right-[6%] lg:top-[54%]",
];

const breadcrumbSchema = breadcrumbGraph(crumbs, Astro.url.pathname, Astro.site);
---

<section class="relative overflow-hidden bg-background pt-12 lg:pt-16">
  <div class="container relative z-10 mx-auto px-6 text-center">
      <h1
        class="mx-auto max-w-3xl font-heading text-[2.125rem] font-black leading-[1.06] tracking-tight text-balance text-brand-ink-900 md:text-5xl lg:text-[3.5rem]"
      >
        {title}
        {
          titleAccent && (
            <span class="relative inline-block">
              {titleAccent}
              {/* Nét gạch vẽ tay: `preserveAspectRatio="none"` để nó giãn đúng bề rộng
                  chữ được nhấn, dù chữ dài ngắn khác nhau ở từng cỡ màn. */}
              <svg
                aria-hidden="true"
                viewBox="0 0 300 16"
                preserveAspectRatio="none"
                fill="none"
                class="absolute -bottom-3 left-0 h-2.5 w-full text-brand-red-500 md:-bottom-4 md:h-3.5"
              >
                <path
                  d="M3 11.5C58 5 152 3.5 297 8.5"
                  stroke="currentColor"
                  stroke-width="5"
                  stroke-linecap="round"
                />
              </svg>
            </span>
          )
        }
      </h1>

      {
        description && (
          <p class="mx-auto mt-7 max-w-xl text-sm leading-relaxed text-muted-foreground md:text-base">
            {description}
          </p>
        )
      }

      <slot />
    </div>

  <!--
      Sân khấu ảnh: khối tròn đỏ neo đáy, người tách nền đứng trên khối, chip bay hai bên.
      Ảnh chạm mép dưới hero (section không có đệm dưới) nên người như đứng trên đường ranh
      giữa hero và phần chọn lớp, không lửng lơ giữa một vùng trắng.
    -->
  <div class="container relative mx-auto mt-10 px-6 lg:mt-12">
      <div class="relative mx-auto w-full max-w-3xl">
        <span
          aria-hidden="true"
          class="absolute bottom-0 left-1/2 aspect-square w-[70%] max-w-80 -translate-x-1/2 rounded-full bg-brand-red-500 lg:max-w-96"
        ></span>

        {
          /*
            Chip đặt trước ảnh trong DOM: ở màn hẹp chúng là một hàng nằm trên ảnh, còn từ
            `lg` thì bay ra hai bên.

            Từ `lg` chính khung bọc mới là thứ `absolute inset-0` phủ đúng sân khấu; chip
            con định vị theo nó. Trước đây khung bọc chỉ `relative` và cao gần bằng 0 (con
            nó đều absolute), nên `top-14%` với `top-48%` cùng quy về một điểm và các chip
            nằm đè lên nhau.
          */
          chips.length > 0 && (
            <div class="relative z-20 mb-6 flex flex-wrap justify-center gap-2 lg:absolute lg:inset-0 lg:mb-0 lg:block">
              {chips.map((chip, i) => (
                <span
                  class:list={[
                    "inline-flex rounded-xl px-3.5 py-2 text-xs font-bold leading-snug lg:absolute lg:max-w-48 lg:text-sm",
                    CHIP_TONES[i % CHIP_TONES.length],
                    CHIP_SPOTS[i % CHIP_SPOTS.length],
                  ]}
                >
                  {chip}
                </span>
              ))}
            </div>
          )
        }

        {/* Trái tim vẽ tay — chi tiết duy nhất không mang thông tin, chỉ hiện từ lg. */}
        <svg
          aria-hidden="true"
          viewBox="0 0 40 38"
          fill="none"
          class="absolute left-[33%] top-[4%] z-20 hidden w-9 -rotate-12 text-brand-ink-900 lg:block"
        >
          <path
            d="M20 34.5C7 26 3.5 19.5 3.5 13.5 3.5 8 7.5 3.5 12.5 3.5c3.2 0 5.9 1.8 7.5 4.4 1.6-2.6 4.3-4.4 7.5-4.4 5 0 9 4.5 9 10 0 6-3.5 12.5-16.5 21z"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linejoin="round"
          />
        </svg>

        {/*
          `height={550}` + `densities` 1x/2x ⇒ hai bản 550px và 1100px. 1100 đúng bằng
          chiều cao ảnh gốc: bản 2x lấy hết chi tiết có thật mà không phóng to (phóng lên
          thì mờ), còn `quality` cao vì đây là ảnh tách nền — viền tóc là chỗ vỡ trước tiên.
        */}
        <Image
          src={image}
          alt={imageAlt}
          height={550}
          densities={[1, 2]}
          format="webp"
          quality={92}
          loading="eager"
          fetchpriority="high"
          class="relative z-10 mx-auto h-72 w-auto object-contain object-bottom mask-[linear-gradient(to_bottom,#000_86%,transparent)] sm:h-80 lg:h-104"
        />
      </div>
    </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
</section>
