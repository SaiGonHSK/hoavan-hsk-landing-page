---
import { Image } from "astro:assets";
import { hero } from "@/data/site";
import { ICONS } from "@/lib/icons";
import HeroBackdrop from "@/components/HeroBackdrop.astro";

import anhGiaoTrinh from "@/assets/hero/hoc-vien-hsk1-hsk4.webp";
import anhDungLop from "@/assets/daily/co-giao-ao-dai-giang-bai.webp";
import anhKemTungNguoi from "@/assets/daily/giang-vien-di-quanh-lop.webp";
import anhLamBai from "@/assets/daily/lop-lam-bai-tap.webp";
import anhTuVan from "@/assets/classes/tu-van-lo-trinh.webp";
import anhGiangSinh from "@/assets/daily/giang-sinh-lop-cam-bang.webp";

/**
 * Hero phương án 4 — chữ dồn hết vào giữa, bên dưới là một dây phơi ảnh: năm tấm ảnh kẹp trên
 * một sợi dây võng, mỗi tấm nghiêng một góc khác nhau. Nền dùng lại nguyên bộ của `HeroV3`
 * (`HeroBackdrop.astro`: dải chuyển sắc, vệt sáng, lưới kẻ, sticker sách–én–tia sáng, hai lớp
 * sóng ở đáy) nên hai phương án đứng cạnh nhau là so được đúng phần khác nhau.
 *
 * Khác `HeroV3` ở chỗ nào và vì sao:
 *
 * — `HeroV3` có đúng MỘT ảnh chân dung dàn dựng, đặt trong vòng tròn. Nó nói được "trung tâm
 *   trông chuyên nghiệp" nhưng không nói được lớp học thật ra sao. Phương án này đổi một ảnh
 *   thành năm: ảnh mẫu cầm giáo trình, giảng viên đang đứng lớp, và ba ảnh lớp thật. Đó là
 *   thứ `WhyUs` với `Achievements` phía dưới đang phải nói bằng chữ.
 *
 * — Vì có năm ảnh nên chữ không thể nằm một cột bên phải nữa: hai khối đều "nặng" thì không
 *   khối nào dẫn. Chữ dồn vào giữa, ảnh xếp thành một hàng ngang bên dưới — mắt đọc từ trên
 *   xuống, một luồng.
 *
 * — Không dựng hero cao đúng một màn hình như `HeroV3`. Ở đó chiều cao do `--hero-offset` đo
 *   bằng script để lớp sóng nằm ngay mép dưới màn đầu, và cách đó chỉ chạy được khi nội dung
 *   có chiều cao đoán trước được. Ở đây hàng ảnh cao theo tỉ lệ ảnh và theo bề rộng màn hình,
 *   nên ghim vào `100svh` sẽ vỡ ở đúng những cỡ máy trung gian: hoặc ảnh bị cắt, hoặc dưới nút
 *   đăng ký hở ra một khoảng trắng lớn.
 */

/**
 * Năm tấm ảnh trên dây, xếp theo đúng thứ tự trái → phải.
 *
 * `drop` là độ sâu tương đối của mỗi tấm trên sợi dây, KHÔNG phải số chọn cho đẹp mắt: sợi
 * dây là một Bézier bậc hai `M0 10 Q500 122 1000 10`, và trong hệ trục đó tung độ tại tâm mỗi
 * cột (10%, 30%, 50%, 70%, 90% bề rộng) rơi vào 0.36 / 0.84 / 1 / 0.84 / 0.36 của độ võng.
 * Nhờ vậy cái kẹp nằm đúng trên dây ở mọi bề rộng màn hình — xem `.hero4-card` trong `<style>`
 * để biết con số này vào công thức nào.
 *
 * `tilt` là góc nghiêng, năm giá trị lệch nhau và không đối xứng: nghiêng đều nhau hoặc đối
 * xứng thì hàng ảnh đọc ra là một hoa văn xếp, không phải mấy tấm ảnh treo.
 *
 * Nội dung nhãn: mỗi cặp chữ ở đây đều là một dữ kiện đã có trong `content/site.json`
 * (`stats`, `hero.noteBody`) hoặc trong bộ ba điểm mạnh của `HeroV3` — không thêm lời quảng bá
 * mới. Và không nhãn nào lặp lại "cam kết 100% đầu ra" của `hero.description` ngay phía trên:
 * cùng một câu hiện hai lần trong một khung nhìn là thứ dễ thấy nhất ở hero.
 */
/**
 * Tỉ lệ khung ảnh trên dây: 4:3, nằm ngang.
 *
 * Bản trước là 4:5 (dọc). Đổi vì hai lẽ, và cả hai đều đo được:
 *
 * — Chiều cao. Ô ảnh rộng chừng 190px thì khung 4:5 cao 238px, còn 4:3 cao 143px. Nhân với
 *   một hàng sáu tấm cộng độ võng, cả dải ảnh thấp đi gần 100px.
 *
 * — Độ nét. Bốn trong sáu ảnh nguồn là ảnh ngang (4:3 hoặc 3:2). Nhét ảnh 4:3 vào khung 4:5
 *   thì `object-cover` cắt mất 39% bề rộng, tức bản tải về phải rộng gấp 1.6 lần ô ảnh mới
 *   đủ nét — đúng chỗ ảnh lớp bị mờ. Khung 4:3 thì ảnh ngang vào vừa khít, không cắt gì.
 *
 * Con số này dùng ở hai nơi: class `aspect-[4/3]` của thẻ `<Image>` và công thức `sizes` ngay
 * dưới, nên để rời hai chỗ là lệch ngay.
 */
const BOX_ASPECT = 4 / 3;

/**
 * Bề rộng ô ảnh, khai theo đúng cách bố cục chia: ở mobile dải cuộn rộng cố định 60rem chia
 * sáu cột, tức mỗi ô ~138px; từ 640px trở lên sáu cột chia hết bề rộng màn hình nên mỗi ô xấp
 * xỉ 16vw.
 */
const SLOT_MOBILE_PX = 138;
const SLOT_DESKTOP_VW = 16;

/**
 * `sizes` cho một ảnh, có bù phần bị `object-cover` cắt mất.
 *
 * Vì sao phải bù: `sizes` là bề rộng Ô ẢNH, còn trình duyệt lấy `sizes × DPR` để chọn bản
 * trong `srcset`. Nhưng một ảnh nguồn "ngang" hơn khung thì `object-cover` phóng ảnh theo
 * chiều cao rồi cắt hai bên, nên chỉ một phần bề rộng bản tải về là còn nhìn thấy. Khai đúng
 * bề rộng ô thì trình duyệt lấy bản vừa đủ cho ô, và phần thấy được hụt đi đúng bằng phần
 * bị cắt.
 *
 * Hệ số bù là `tỉ lệ nguồn ÷ tỉ lệ khung`, chỉ áp dụng khi ảnh nguồn ngang hơn khung. Ảnh dọc
 * hơn khung thì `object-cover` cắt trên–dưới, bề rộng dùng hết, không cần bù gì.
 *
 * Với khung 4:3 hiện tại, hệ số này là 1 cho bốn ảnh 4:3, khoảng 1.13 cho hai ảnh 3:2, và 1
 * cho ba ảnh dọc. Nó gần như không làm gì — nhưng đó là kết quả của việc chọn đúng tỉ lệ
 * khung, không phải lý do để bỏ công thức: đổi `BOX_ASPECT` một lần nữa là nó lại có việc.
 */
const sizesFor = (src: { width: number; height: number }) => {
  const overshoot = Math.max(1, src.width / src.height / BOX_ASPECT);
  const mobile = Math.round(SLOT_MOBILE_PX * overshoot);
  const desktop = Math.round(SLOT_DESKTOP_VW * overshoot);
  return `(min-width: 640px) ${desktop}vw, ${mobile}px`;
};

/**
 * Sáu tấm ảnh trên dây, xếp theo đúng thứ tự trái → phải.
 *
 * `tilt` là góc nghiêng, sáu giá trị lệch nhau và không đối xứng: nghiêng đều nhau hoặc đối
 * xứng thì hàng ảnh đọc ra là một hoa văn xếp, không phải mấy tấm ảnh treo.
 *
 * `pos` là `object-position`. Hai ảnh dọc bị khung 4:3 cắt trên–dưới nên phải chỉ định cửa sổ
 * crop; xem chú thích tại chỗ của từng tấm. Bốn ảnh ngang dùng `center`.
 *
 * Nội dung nhãn: mỗi cặp chữ đều là một dữ kiện đã có trong `content/site.json` (`stats`,
 * `hero.noteBody`) hoặc trong bộ ba điểm mạnh của `HeroV3` — không thêm lời quảng bá mới. Và
 * không nhãn nào lặp lại "cam kết 100% đầu ra" của `hero.description` ngay phía trên: cùng
 * một câu hiện hai lần trong một khung nhìn là thứ dễ thấy nhất ở hero.
 */
const cards = [
  {
    src: anhDungLop,
    alt: "Giảng viên Hoa văn SaigonHSK mặc áo dài đang giảng bài trước lớp",
    title: "Giảng viên đứng lớp",
    desc: "Thạc sĩ, tiến sĩ tốt nghiệp tại Trung Quốc",
    tilt: -3,
    pos: "object-[center_35%]",
  },
  {
    src: anhKemTungNguoi,
    alt: "Giảng viên Hoa văn SaigonHSK đi quanh lớp xem bài của từng học viên",
    title: "Lớp 10–15 học viên",
    desc: "Giảng viên kèm từng người",
    tilt: 2,
    pos: "object-center",
  },
  {
    src: anhTuVan,
    alt: "Nhân viên Hoa văn SaigonHSK tư vấn lộ trình học cho một học viên tại quầy",
    title: "Tư vấn lộ trình",
    desc: "Test trình độ miễn phí, xếp đúng lớp",
    tilt: -1.5,
    pos: "object-center",
  },
  {
    src: anhGiaoTrinh,
    alt: "Hai học viên Hoa văn SaigonHSK cầm giáo trình HSK1 và HSK4",
    title: "Giáo trình HSK",
    desc: "Trọn lộ trình HSK1 – HSK6",
    tilt: -1,
    /*
      44% chứ không phải 18% như bản trước. Ảnh nguồn cao 1402px, khung 4:3 chỉ thấy được
      842px, tức cửa sổ crop trượt được 560px. Trong ảnh: đỉnh đầu bạn nam ở y≈240, mép dưới
      hai cuốn giáo trình ở y≈1090 — cần đúng 850px, gần hết cả 842px thấy được. Ở 18% cửa sổ
      mở tại 100–942 nên nó cắt mất một phần ba dưới của hai cuốn sách, đúng cái mà nhãn
      "Giáo trình HSK" đang chỉ vào. Ở 44% cửa sổ mở tại 246–1088: cả hai cuốn vào trọn, chỉ
      hớt vài px tóc bạn nam.
    */
    pos: "object-[center_44%]",
  },
  {
    src: anhLamBai,
    alt: "Học viên lớp luyện thi HSK tại Hoa văn SaigonHSK đang làm đề trên lớp",
    title: "Luyện đề trên lớp",
    desc: "Học lại miễn phí nếu chưa đạt",
    tilt: 2.5,
    pos: "object-center",
  },
  {
    src: anhGiangSinh,
    alt: "Học viên Hoa văn SaigonHSK cầm bảng chúc Giáng sinh trong lớp",
    title: "Hoạt động cùng lớp",
    desc: "Giáng sinh, Tết, Trung thu tại trung tâm",
    tilt: 3,
    pos: "object-center",
  },
];

/**
 * Độ sâu của từng tấm trên sợi dây, tính ra từ chính hình dạng sợi dây chứ không viết tay.
 *
 * Sợi dây là Bézier bậc hai `M0 12 Q500 188 1000 12`. Điểm điều khiển nằm đúng giữa theo trục
 * ngang nên hoành độ tuyến tính theo tham số, và đường cong rút về một parabol `4x(1-x)` tính
 * theo độ võng. Tâm cột thứ `i` trong `n` cột nằm ở `(2i+1) / 2n` bề rộng, thay vào là ra.
 *
 * Vì sao tính chứ không viết cứng như bản trước: bản trước có bảy con số viết tay, và bỏ một
 * tấm ảnh là cả bảy sai — sai kiểu không báo lỗi, kẹp chỉ rời khỏi dây vài px, phải nhìn mới
 * thấy. Nay bỏ hay thêm ảnh thì độ sâu tự tính lại.
 *
 * Sáu cột nên hai tấm giữa cùng độ sâu (0.972), khác với bảy cột trước đây có đúng một tấm ở
 * đáy. Ảnh mẫu cầm giáo trình là một trong hai tấm đó, và nó vẫn dẫn cả hàng vì là tấm duy
 * nhất chụp dàn dựng giữa sáu tấm ảnh lớp thật.
 */
const drops = cards.map((_, i) => {
  const x = (2 * i + 1) / (2 * cards.length);
  return 4 * x * (1 - x);
});
---

<section
  id="hero"
  class="hero4 relative isolate overflow-hidden pt-8 pb-24 sm:pt-12 sm:pb-28 lg:pt-16 lg:pb-32"
>
  {/* `stickers="wide"`: ở V4 chữ nằm giữa và ăn hết bề rộng, nên hai sticker trên cùng phải
      lên khỏi tầm tiêu đề ở màn hẹp — xem `variant` trong `HeroStickers.astro`. */}
  <HeroBackdrop stickers="wide" />

  <div class="relative mx-auto w-full max-w-5xl px-6 text-center">
    {/* Nhãn không có icon, giống hệt nhãn của V3: chữ đã nói đủ "Lộ trình chuẩn HSK 3.0",
        thêm một tia sáng đỏ vào trước thì nó chỉ là một vệt màu đứng cạnh chữ. */}
    <span
      class="hero4-rise inline-flex items-center rounded-full border border-border bg-background/80 px-5 py-2.5 text-xs font-bold tracking-[0.16em] text-muted-foreground uppercase backdrop-blur-sm"
    >
      {hero.noteTitle}
    </span>

    <h1 class="hero4-rise mt-6 text-balance" style="--hero-delay: 80ms">
      <span
        class="block text-[8.6vw] leading-[1.05] font-black tracking-[-0.02em] text-brand-ink-900 uppercase sm:text-[3.4rem] lg:text-[4rem] xl:text-[4.6rem]"
      >
        {hero.titleLine1}
      </span>
      <span
        class="block text-[8.6vw] leading-[1.05] font-black tracking-[-0.02em] text-brand-red-600 uppercase sm:text-[3.4rem] lg:text-[4rem] xl:text-[4.6rem]"
      >
        {hero.titleLine2}
      </span>
    </h1>

    <p
      class="hero4-rise mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base"
      style="--hero-delay: 150ms"
    >
      {hero.description}
    </p>

    {/* Câu tóm tắt cho trợ lý giọng nói — giữ nguyên như hai phương án hero trước để đổi
        phương án không làm mất dữ kiện địa danh của trang chủ. */}
    <p class="sr-only" data-speakable>
      Trung tâm Hoa văn SaigonHSK — dạy tiếng Trung và luyện thi HSK tại TP.HCM
      (Sài Gòn), cam kết 100% đầu ra.
    </p>

    <div
      class="hero4-rise mt-7 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center"
      style="--hero-delay: 230ms"
    >
      <a
        href="/register"
        class="group inline-flex items-center justify-center gap-2 rounded-full bg-brand-red-600 px-8 py-3.5 text-sm font-bold text-white shadow-lg shadow-brand-red-600/25 transition-all hover:-translate-y-0.5 hover:bg-brand-red-700 sm:py-4"
      >
        Đăng ký giữ chỗ ngay
        <span
          class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
          set:html={ICONS.arrow}
        />
      </a>

      {/* Nút phụ chỉ hiện từ 640px, như `HeroV3`: ở mobile nó là một nút to nữa chồng ngay
          dưới nút chính, và nó lặp lại một mục đã có trong menu đầu trang. */}
      <a
        href="/schedule"
        class="group hidden items-center justify-center gap-2 rounded-full border border-border bg-background/70 px-8 py-3.5 text-sm font-bold text-brand-ink-900 transition-all hover:-translate-y-0.5 hover:border-brand-ink-300 hover:bg-brand-ink-50 sm:inline-flex sm:py-4"
      >
        Xem lịch khai giảng
        <span
          class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 [&>svg]:size-4"
          set:html={ICONS.arrowUpRight}
        />
      </a>
    </div>
  </div>

  {/*
    Dây phơi ảnh.

    Ở mobile cả khối là một dải cuộn ngang (`overflow-x-auto` + `min-w`), không phải sáu cột
    nén lại: ở 390px mỗi cột chỉ còn chừng 53px, ảnh nhỏ đến mức không đọc ra lớp học và nhãn
    thì vỡ dòng từng chữ. Cuộn ngang giữ ảnh ở cỡ đọc được và vẫn cho xem hết sáu tấm.

    Sợi dây nằm TRONG dải cuộn: nhờ vậy nó cuộn cùng mấy tấm ảnh, cái kẹp không bao giờ rời
    khỏi dây. Đặt dây ngoài dải cuộn thì kéo ngang một cái là ảnh trôi đi còn dây đứng lại.

    `-mx-6 px-6`: dải cuộn ăn hết bề rộng màn hình nhưng vẫn giữ lề 1.5rem ở hai đầu hành
    trình cuộn, nên tấm đầu và tấm cuối không dính mép kính.
  */}
  <div
    class="hero4-rack relative -mx-6 mt-12 overflow-x-auto px-6 pb-2 sm:mt-14 sm:overflow-x-visible lg:mt-16"
  >
    {/*
      Dải ảnh ăn hết bề rộng màn hình, KHÔNG bó vào `max-w` của phần chữ. Hai lý do:

      — Sợi dây phải chạy ra tận hai mép màn hình. Bó vào giữa thì hai đầu dây dừng lơ lửng
        giữa nền, và một sợi dây có hai đầu nhìn thấy được thì đọc ra là một nét vẽ, không
        phải sợi dây căng giữa hai điểm ngoài khung hình.

      — Sáu tấm ảnh chia trong 64rem thì mỗi tấm rộng chừng 9.5rem, ở cỡ đó không nhìn ra lớp
        học trong ảnh nữa. Ăn hết bề rộng thì mỗi tấm rộng chừng 14rem ở 1440px.

      `max-w-[100rem]`: trên màn siêu rộng, sáu tấm ảnh giãn ra quá cỡ thì chúng lấn vai trò
      của tiêu đề, vốn là thứ phải đọc trước.
    */}
    <div class="relative mx-auto min-w-[52rem] sm:min-w-0 sm:max-w-[100rem]">
      {/*
        Sợi dây: một Bézier bậc hai võng xuống 88 đơn vị trong hệ trục cao 120, kéo giãn theo
        bề rộng (`preserveAspectRatio="none"`) nhưng cao cố định 7.5rem — nhờ vậy độ võng tính
        theo px không đổi, và `--drop` của từng tấm ảnh khớp với dây ở mọi bề rộng.

        Độ võng nay là 5.5rem, trước là 3.5rem. Cung sâu hơn thì cả hàng ảnh xếp thành một
        đường cong đọc ra ngay; ở 3.5rem chia cho sáu cột, hai tấm cạnh nhau chỉ lệch nhau vài
        px và cả hàng gần như thành một đường thẳng.

        `vector-effect="non-scaling-stroke"` là bắt buộc ở đây: với `preserveAspectRatio="none"`
        thì nét vẽ bị kéo giãn theo hai trục khác nhau, nên một sợi dây mảnh sẽ dày mỏng khác
        nhau tuỳ chỗ và tuỳ cỡ màn hình.
      */}
      <svg
        class="pointer-events-none absolute inset-x-0 top-0 h-30 w-full"
        viewBox="0 0 1000 120"
        preserveAspectRatio="none"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M0 12Q500 188 1000 12"
          stroke="var(--brand-ink-300)"
          stroke-width="1.6"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"></path>
      </svg>

      <ul class="grid grid-cols-6 items-start gap-2 sm:gap-3 lg:gap-4">
        {
          cards.map((c, i) => (
            <li
              class="hero4-card"
              style={`--drop: ${drops[i]}; --tilt: ${c.tilt}deg; --hero-delay: ${300 + i * 90}ms`}
            >
              {/*
                Cái kẹp: một thanh dọc bo góc, nửa trên nằm trên dây nửa dưới nằm dưới dây
                (`-top-2.5` với chiều cao `h-5`). Nó KHÔNG nghiêng theo ảnh — kẹp thì cắn vào
                dây nên nó đứng, còn tấm ảnh treo dưới nó thì đổ nghiêng.
              */}
              <span class="hero4-peg" aria-hidden="true">
                <span class="hero4-peg-spring" />
              </span>

              <figure class="hero4-frame">
                {/*
                  `widths` + `sizes` chứ không phải `width` + `densities`.

                  `densities` sinh ra `srcset` theo hệ số x, và trình duyệt chọn theo DPR chứ
                  không theo bề rộng thật của ô ảnh: máy DPR2 luôn lấy bản 2x kể cả khi ô ảnh ở
                  mobile chỉ rộng 130px. Vừa thừa dung lượng ở mobile, vừa thiếu độ nét ở
                  desktop nếu con số `width` đặt hụt. `sizes` thì do `sizesFor()` tính — xem
                  chú thích của nó ở đầu file.

                  Đây là chỗ đã làm hai ảnh lớp nhìn mờ ở bản trước, và cách sửa gồm ba việc:
                  khung ảnh đổi từ 4:5 sang 4:3 để ảnh ngang không bị cắt mất 39% bề rộng, hai
                  ảnh nguồn 1024px (`classes/lop-hoc-nho.webp`, `classes/lop-luyen-thi-hsk.webp`)
                  đổi sang hai ảnh nguồn 2048px, và `sizes` khai theo bề rộng ô thật thay cho
                  hệ số DPR.
                */}
                <Image
                  src={c.src}
                  alt={c.alt}
                  widths={[200, 400, 600, 800, 1000]}
                  sizes={sizesFor(c.src)}
                  format="webp"
                  quality={88}
                  loading={i === 3 ? "eager" : "lazy"}
                  fetchpriority={i === 3 ? "high" : undefined}
                  class:list={[
                    "aspect-[4/3] w-full rounded-lg object-cover",
                    c.pos,
                  ]}
                />

                <figcaption class="px-0.5 pt-2 text-left sm:pt-2.5">
                  <p class="text-[0.62rem] font-bold text-brand-ink-900 sm:text-xs lg:text-sm">
                    {c.title}
                  </p>
                  <p class="mt-0.5 text-[0.56rem] leading-snug text-muted-foreground sm:text-[0.68rem] lg:text-xs">
                    {c.desc}
                  </p>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /*
    Dải cuộn ngang ở mobile: ẩn thanh cuộn. Ở đây thanh cuộn không mang thông tin nào mà bản
    thân nó đã có — năm tấm ảnh nghiêng, tấm ngoài cùng bị mép kính cắt, cả hai đều nói "còn
    nữa, kéo sang đi" rõ hơn một vạch xám.
  */
  .hero4-rack {
    scrollbar-width: none;
  }

  .hero4-rack::-webkit-scrollbar {
    display: none;
  }

  /*
    Chỗ treo của từng tấm ảnh.

    Công thức: dây có điểm cao nhất ở tung độ 12 và võng thêm 88 trong hệ trục cao 120, mà thẻ
    `<svg>` cao đúng 7.5rem nên 1 đơn vị = 1/16 rem. Vậy dây tại tâm cột này nằm ở
    `0.75rem + drop × 5.5rem` tính từ đỉnh khối. Cái kẹp cao 1.25rem và đặt `-top-2.5`
    (-0.625rem) so với thẻ, tức tâm kẹp trùng đỉnh thẻ — nên chỉ cần đẩy thẻ xuống đúng tung
    độ của dây là kẹp cắn vào dây.

    Viết bằng `--drop` thay vì bốn giá trị `margin-top` cứng: cùng một con số đó vừa là chỗ
    treo vừa là thứ phải khớp với đường cong trong `<svg>`, để rời hai nơi thì sửa dây mà quên
    sửa ảnh là lệch ngay.
  */
  .hero4-card {
    margin-top: calc(0.75rem + var(--drop) * 5.5rem);
  }

  .hero4-peg {
    position: absolute;
    top: -0.625rem;
    left: 50%;
    z-index: 1;
    width: 0.625rem;
    height: 1.25rem;
    translate: -50% 0;
    border-radius: 0.1875rem;
    background: var(--brand-red-600);
    box-shadow: 0 2px 4px rgba(18, 19, 22, 0.18);
  }

  /* Vạch sáng dọc giữa kẹp, chỗ cái lẫy: không có nó thì kẹp chỉ là một viên thuốc đỏ. */
  .hero4-peg-spring {
    position: absolute;
    inset: 0.5rem 0.1875rem 0.25rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.4);
  }

  /*
    Khung ảnh: nền trắng, đệm đều bốn phía, ảnh bo góc bên trong — đúng kiểu một tấm ảnh in có
    mép trắng. Bóng đổ mềm và lệch xuống để tấm ảnh nổi khỏi nền xám.

    `transform-origin: top center` cho `rotate`: tấm ảnh treo trên một cái kẹp thì nó quay
    quanh chỗ bị kẹp, không quay quanh tâm mình. Quay quanh tâm thì mép trên tấm ảnh trôi khỏi
    kẹp và cả hàng trông như ảnh dán lệch.

    Dùng thuộc tính `rotate` chứ không phải `transform`: animation vào của thẻ (`hero4-rise`)
    dùng `translate`, hai thuộc tính riêng thì cộng vào nhau, còn viết chung trong `transform`
    thì cái sau xoá cái trước.
  */
  .hero4-frame {
    position: relative;
    padding: 0.3125rem;
    border-radius: 0.75rem;
    background: #ffffff;
    rotate: var(--tilt);
    transform-origin: top center;
    box-shadow:
      0 1px 2px rgba(18, 19, 22, 0.06),
      0 12px 24px -12px rgba(18, 19, 22, 0.28);
  }

  @media (min-width: 640px) {
    .hero4-frame {
      padding: 0.4375rem;
      border-radius: 0.875rem;
    }
  }

  .hero4-card {
    position: relative;
  }

  /*
    Trạng thái mặc định của mọi phần tử là *đã hiện đủ*, animation chỉ thêm vào khi người xem
    không tắt hiệu ứng chuyển động — giống `HeroV3`. Ai tắt thì thấy hero tĩnh hoàn chỉnh,
    không phải một vùng trắng chờ animation không bao giờ chạy.
  */
  @media (prefers-reduced-motion: no-preference) {
    .hero4-rise {
      animation: hero4-rise 0.62s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--hero-delay, 0ms);
    }

    /* Ảnh vào bằng cách rơi xuống rồi dừng, không trôi lên như khối chữ: chúng treo trên dây
       nên chiều vào phải là chiều của trọng lực. */
    .hero4-card {
      animation: hero4-hang 0.72s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--hero-delay, 0ms);
    }
  }

  @keyframes hero4-rise {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }

  @keyframes hero4-hang {
    from {
      opacity: 0;
      translate: 0 -18px;
    }
  }
</style>
