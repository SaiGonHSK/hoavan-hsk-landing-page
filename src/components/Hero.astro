---
import { hero, stats } from "@/data/site";
import HeroIllustration from "@/components/HeroIllustration.astro";
import { ICONS } from "@/lib/icons";
---

<section id="hero" class="relative overflow-hidden bg-background pt-10 lg:pt-14">
  <div class="container relative z-10 mx-auto px-6 text-center">

    <span
      class="inline-flex items-center rounded-full border border-border bg-background px-6 py-2.5 text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground"
    >
      {hero.noteTitle}
    </span>

    <h1 class="mt-6 text-balance">
      <span class="block text-[6.2vw] font-black uppercase leading-[1.05] tracking-[-0.02em] text-brand-ink-900 lg:text-[3.1rem]">
        {hero.titleLine1}
      </span>
      <span class="block text-[6.2vw] font-black uppercase leading-[1.05] tracking-[-0.02em] text-brand-red-600 lg:text-[3.1rem]">
        {hero.titleLine2}
      </span>
    </h1>
    {/* `data-speakable`: trang chủ không dùng PageHero nên câu tóm tắt của nó nằm ở
        đây. `sr-only` vẫn là nội dung thật trong DOM, bot đọc được bình thường. */}
    <p class="sr-only" data-speakable>
      Trung tâm Hoa văn SaigonHSK — dạy tiếng Trung và luyện thi HSK
      tại TP.HCM (Sài Gòn), cam kết 100% đầu ra.
    </p>

    <ul class="mx-auto mt-9 grid max-w-4xl grid-cols-1 items-start sm:grid-cols-3">
      {
        stats.map((s, i) => (
          <li
            class:list={[
              "px-3 sm:px-6 lg:px-10",
              i > 0 &&
                "mt-5 border-t border-border pt-5 sm:mt-0 sm:border-l sm:border-t-0 sm:pt-0",
            ]}
          >
            <p class="text-2xl font-black leading-none text-brand-ink-900 sm:text-3xl lg:text-[2.25rem]">
              {s.value}
            </p>
            <p class="mt-2 text-[0.62rem] font-semibold uppercase tracking-[0.12em] text-muted-foreground sm:text-[0.7rem] sm:tracking-[0.14em] lg:whitespace-nowrap">
              {s.label}
            </p>
          </li>
        ))
      }
    </ul>

    <div class="mt-9">
      <a
        href="/register"
        class="group inline-flex items-center gap-2 rounded-full bg-brand-red-600 px-9 py-4 text-sm font-bold text-white shadow-lg shadow-brand-red-600/25 transition-all hover:-translate-y-0.5 hover:bg-brand-red-700"
      >
        Đăng ký giữ chỗ ngay
        <span
          class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
          set:html={ICONS.arrow}
        />
      </a>
    </div>
  </div>

  <div class="relative z-20 mt-8 hidden md:block lg:mt-10">
    <HeroIllustration class="mx-auto w-full max-w-3xl" />
  </div>
</section>
