---
import { contact } from "@/data/site";
import { ICONS } from "@/lib/icons";
---

<div class="fixed bottom-5 right-5 z-40 flex flex-col items-center gap-3 print:hidden">
  <button
    type="button"
    data-scroll-top
    aria-label="Lên đầu trang"
    class="group pointer-events-none relative flex size-13 translate-y-2 cursor-pointer items-center justify-center rounded-full border border-border bg-background text-brand-ink-900 opacity-0 shadow-lg shadow-black/10 transition-[opacity,transform] duration-300 hover:scale-105 data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
  >
    <span class="[&>svg]:size-5 [&>svg]:-rotate-90" set:html={ICONS.arrow} />
    <span
      class="pointer-events-none absolute right-full mr-3 whitespace-nowrap rounded-md bg-foreground px-2.5 py-1.5 text-xs font-medium text-background opacity-0 transition-opacity group-hover:opacity-100"
    >
      Lên đầu trang
    </span>
  </button>

  <a
    href={contact.zalo}
    target="_blank"
    rel="noopener"
    aria-label="Nhắn SaiGonHSK qua Zalo"
    class="group relative flex size-13 items-center justify-center transition-transform hover:scale-105"
  >
    <span class="relative [&>svg]:size-13" set:html={ICONS.zalo} />
    <span
      class="pointer-events-none absolute right-full mr-3 whitespace-nowrap rounded-md bg-foreground px-2.5 py-1.5 text-xs font-medium text-background opacity-0 transition-opacity group-hover:opacity-100"
    >
      Nhắn SaiGonHSK qua Zalo
    </span>
  </a>

  <a
    href={contact.tiktok}
    target="_blank"
    rel="noopener"
    aria-label="Xem SaiGonHSK trên TikTok"
    class="group relative flex size-13 items-center justify-center rounded-full bg-brand-ink-950 text-white shadow-lg shadow-black/20 transition-transform hover:scale-105"
  >
    <span class="[&>svg]:size-6" set:html={ICONS.tiktok} />
    <span
      class="pointer-events-none absolute right-full mr-3 whitespace-nowrap rounded-md bg-foreground px-2.5 py-1.5 text-xs font-medium text-background opacity-0 transition-opacity group-hover:opacity-100"
    >
      Xem SaiGonHSK trên TikTok
    </span>
  </a>

  <a
    href={`tel:${contact.phonePrimaryRaw}`}
    aria-label={`Gọi ${contact.phonePrimary}`}
    class="group relative flex size-13 items-center justify-center rounded-full bg-brand-red-600 text-white shadow-lg shadow-black/20 transition-transform hover:scale-105"
  >
    <span class="[&>svg]:size-6" set:html={ICONS.phone} />
    <span
      class="pointer-events-none absolute right-full mr-3 whitespace-nowrap rounded-md bg-foreground px-2.5 py-1.5 text-xs font-medium text-background opacity-0 transition-opacity group-hover:opacity-100"
    >
      {contact.phonePrimary}
    </span>
  </a>
</div>

<script>
  const top = document.querySelector<HTMLButtonElement>("[data-scroll-top]");

  if (top) {
    const sync = () => {
      top.dataset.visible = String(window.scrollY > 480);
    };

    top.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" }),
    );
    window.addEventListener("scroll", sync, { passive: true });
    sync();
  }
</script>
