---
import SectionHeading from "@/components/SectionHeading.astro";
import RoadmapIllustration from "@/components/RoadmapIllustration.astro";
import { roadmap } from "@/data/courses";
import { ICONS } from "@/lib/icons";

/** Mỗi chặng một tông màu riêng cho dễ phân biệt khi các thẻ xếp chồng lên nhau. */
const STEP_ART = [
  {
    card: "bg-brand-red-50",
    panel: "bg-brand-red-100/70",
  },
  {
    card: "bg-amber-50",
    panel: "bg-amber-100/70",
  },
  {
    card: "bg-emerald-50",
    panel: "bg-emerald-100/70",
  },
  {
    card: "bg-sky-50",
    panel: "bg-sky-100/70",
  },
] as const;
---

{/* Không đặt `overflow-hidden` ở đây: nó sẽ vô hiệu hoá `sticky` của các thẻ bên trong. */}
<section id="roadmap" class="relative bg-background scroll-mt-24">
  <div class="container relative z-10 mx-auto px-6">
    <SectionHeading
      title="Bốn chặng rõ ràng từ"
      highlight="vỡ lòng đến HSK6"
      description="Mỗi chặng có chuẩn đầu ra cụ thể về từ vựng, ngữ pháp và kỹ năng. Học viên được test năng lực trước khi vào lớp để không học lại phần đã biết."
    />

    {/*
      Các chặng xếp chồng khi cuộn: mỗi thẻ `sticky` với mốc `top` lệch dần, nên
      thẻ sau trượt lên đè thẻ trước và vẫn ló ra một dải để thấy được thứ tự.
      Thuần CSS, không cần JS.
    */}
    <ol class="mt-16 space-y-6">
      {
        roadmap.map((s, i) => {
          const art = STEP_ART[i % STEP_ART.length];

          return (
            <li
              class:list={[
                "sticky overflow-hidden rounded-[2rem] p-8 md:p-12",
                art.card,
              ]}
              style={`top: ${5 + i * 1.25}rem`}
            >
              <div class="grid items-center gap-8 md:grid-cols-[1.05fr_0.95fr]">
                <div>
                  <span class="text-xs font-bold uppercase tracking-[0.16em] text-brand-ink-500">
                    Chặng {s.step} · {s.code}
                  </span>

                  <h3 class="mt-4 text-3xl font-black leading-[1.1] text-brand-ink-900 md:text-4xl">
                    {s.title}
                  </h3>
                  <p class="mt-3 text-sm font-bold text-brand-red-600">
                    {s.result}
                  </p>
                  <p class="mt-4 max-w-md text-base leading-relaxed text-brand-ink-700 md:text-base">
                    {s.desc}
                  </p>

                  <a
                    href="/register"
                    class="group mt-8 inline-flex items-center gap-2 rounded-full border border-brand-ink-900/25 px-6 py-3 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-900 hover:text-white"
                  >
                    Đăng ký test miễn phí
                    <span
                      class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
                      set:html={ICONS.arrow}
                    />
                  </a>
                </div>

                <div
                  class:list={[
                    "grid h-56 place-items-center overflow-hidden rounded-3xl md:h-72",
                    art.panel,
                  ]}
                >
                  <RoadmapIllustration
                    step={s.step}
                    alt={`Minh hoạ chặng ${s.step} — ${s.title}`}
                    class="p-3 md:p-5"
                  />
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>

    <div
      class="mt-14 flex flex-col items-center justify-between gap-6 rounded-3xl bg-brand-ink-50 p-8 md:flex-row md:p-10"
    >
      <div>
        <p class="text-2xl font-black text-brand-ink-900 md:text-3xl">
          Không chắc mình đang ở chặng nào?
        </p>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted-foreground">
          Trung tâm test năng lực đầu vào miễn phí dựa trên vốn từ, giáo trình bạn đã
          học và ngữ pháp bạn đã nắm.
        </p>
      </div>
      <a
        href="/register"
        class="group inline-flex shrink-0 items-center gap-2 rounded-full bg-brand-red-600 px-6 py-3.5 text-sm font-bold text-white transition-transform hover:-translate-y-0.5"
      >
        Đăng ký test miễn phí
        <span
          class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
          set:html={ICONS.arrow}
        />
      </a>
    </div>
  </div>
</section>
