---
import SectionHeading from "@/components/SectionHeading.astro";
import Doodle from "@/components/Doodle.astro";
import { roadmap } from "@/data/courses";
import { ICONS } from "@/lib/icons";
---

<section id="roadmap" class="relative overflow-hidden bg-background scroll-mt-24">
  <Doodle
    name="star"
    class="absolute right-[8%] top-28 hidden size-12 text-amber-400 lg:block"
  />

  <div class="container relative z-10 mx-auto px-6">
    <SectionHeading
      title="Bốn chặng rõ ràng từ"
      highlight="vỡ lòng đến HSK6"
      description="Mỗi chặng có chuẩn đầu ra cụ thể về từ vựng, ngữ pháp và kỹ năng. Học viên được test năng lực trước khi vào lớp để không học lại phần đã biết."
    />

    <div class="relative mt-16">
      {/* Nét vẽ tay nối các chặng */}
      <svg
        class="pointer-events-none absolute inset-x-0 top-10 hidden h-16 w-full text-brand-red-200 lg:block dark:text-brand-red-900"
        viewBox="0 0 1200 60"
        fill="none"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M20 40C180 4 320 56 470 26s280 34 430 4 260 6 280 6"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-dasharray="10 12"></path>
      </svg>

      <ol class="grid gap-10 lg:grid-cols-4 lg:gap-6">
        {
          roadmap.map((s, i) => (
            <li
              class={"relative rounded-3xl bg-brand-ink-50 p-7 dark:bg-white/[0.04]"}
            >
              <span class="font-bricolage text-4xl font-black leading-none text-brand-red-500 dark:text-brand-red-400">
                {s.step}
              </span>

              <h3 class="mt-3 font-bricolage text-xl font-extrabold text-brand-ink-900 dark:text-white">
                {s.title}
              </h3>
              <p class="mt-1 text-xs font-bold uppercase tracking-[0.1em] text-muted-foreground">
                {s.code} · {s.result}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{s.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div
      class="mt-14 flex flex-col items-center justify-between gap-6 rounded-3xl bg-brand-ink-50 p-8 md:flex-row md:p-10 dark:bg-white/[0.04]"
    >
      <div>
        <p class="font-bricolage text-2xl font-black text-brand-ink-900 md:text-3xl dark:text-white">
          Không chắc mình đang ở chặng nào?
        </p>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted-foreground">
          Trung tâm test năng lực đầu vào miễn phí dựa trên vốn từ, giáo trình bạn đã
          học và ngữ pháp bạn đã nắm.
        </p>
      </div>
      <a
        href="/register"
        class="group inline-flex shrink-0 items-center gap-2 rounded-full bg-brand-red-600 px-6 py-3.5 text-sm font-bold text-white transition-transform hover:-translate-y-0.5"
      >
        Đăng ký test miễn phí
        <span
          class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
          set:html={ICONS.arrow}
        />
      </a>
    </div>
  </div>
</section>
