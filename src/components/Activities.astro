---
import { Image, getImage } from "astro:assets";
import BrandHeading from "@/components/BrandHeading.astro";
import RailHint from "@/components/RailHint.astro";
import { activityPosters } from "@/data/activities";

/*
  Lightbox nhận URL dạng chuỗi nên phải tạo sẵn bản phóng to đã nén —
  nếu trỏ thẳng vào ảnh gốc 2526px thì mỗi lần mở phải tải ~1,5MB.
*/
const posters = await Promise.all(
  activityPosters.map(async (p) => ({
    ...p,
    full: (
      await getImage({
        src: p.image,
        width: 1200,
        format: "webp",
        quality: 78,
      })
    ).src,
  })),
);
---

{
  posters.length > 0 && (
    <section
      id="activities"
      class="relative overflow-hidden bg-background scroll-mt-24"
    >
      <div class="container relative z-10 mx-auto px-6">
        <BrandHeading
          title="Hoạt động học viên "
          highlight="SaigonHSK"
          note="Minigame Check-in Tết 2026"
        />

        <div data-rail class="group/rail relative mt-12">
          <div
            data-rail-track
            class="activity-rail -mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-3 lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-5 lg:overflow-visible lg:px-0 lg:pb-0"
          >
          {posters.map((p) => (
            <button
              type="button"
              data-lightbox={p.full}
              data-caption={p.caption}
              class="group relative block w-[78vw] max-w-80 shrink-0 snap-start cursor-zoom-in overflow-hidden rounded-3xl bg-brand-ink-50 sm:w-80 lg:w-auto lg:max-w-none"
            >
              <Image
                src={p.image}
                alt={p.caption}
                width={480}
                densities={[1, 2]}
                format="webp"
                quality={76}
                loading="lazy"
                decoding="async"
                class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />

              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-linear-to-t from-brand-ink-950/85 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              />

              <span class="pointer-events-none absolute inset-x-0 bottom-0 p-5 text-left text-[15px] font-extrabold leading-snug text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                {p.caption}
              </span>
            </button>
          ))}

            <span
              aria-hidden="true"
              class="pointer-events-none absolute -right-2 top-1/2 hidden size-20 -translate-y-1/2 rotate-6 place-items-center rounded-full bg-brand-red-600 text-center text-xs font-bold leading-tight text-white shadow-[0_18px_40px_-20px_rgba(178,24,43,0.8)] lg:grid"
            >
              为你的
              <br />
              成功
            </span>
          </div>

          <RailHint label="hoạt động" hideFrom="lg" />
        </div>
      </div>
    </section>
  )
}

<style>
  .activity-rail {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .activity-rail::-webkit-scrollbar {
    display: none;
  }
</style>
