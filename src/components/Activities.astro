---
import { Image, getImage } from "astro:assets";
import BrandHeading from "@/components/BrandHeading.astro";
import RailHint from "@/components/RailHint.astro";
import { activityPosters } from "@/data/activities";

/**
 * Bề rộng ô ảnh lớn nhất trên desktop: lưới 4 cột trong `container` (rộng nhất
 * 96rem = 1536px), trừ `px-6` hai bên và 3 khoảng `gap-5` → (1536-48-60)/4 ≈ 357px.
 * Lấy 360 cho chẵn — ô hẹp hơn thì trình duyệt thu nhỏ xuống, chỉ nét thêm.
 */
const CARD = 360;

/*
  Lightbox nhận URL dạng chuỗi nên phải tạo sẵn bản phóng to đã nén —
  nếu trỏ thẳng vào ảnh gốc 2526px thì mỗi lần mở phải tải cả MB.
*/
const posters = await Promise.all(
  activityPosters.map(async (p) => {
    /*
      Ô ảnh là hình vuông (`aspect-square` + `object-cover`), mà ảnh chụp phần lớn là
      ảnh ngang. Chỉ đưa `width` thì Astro giữ nguyên tỉ lệ: ảnh 2048×1366 ra bản
      480×320, rồi CSS kéo bản 320px cao đó lên cho đầy ô vuông 480px — nhìn mờ hẳn,
      trong khi mấy poster Tết vốn vuông 2526×2526 thì lại nét. Nên phải xin sharp
      cắt vuông sẵn (`width` = `height` + `fit: "cover"`), trình duyệt không còn phải
      phóng to gì nữa.

      Chiều ngắn hơn của ảnh gốc là giới hạn thật: cắt vuông 800px từ ảnh
      2048×1366 chỉ cần 1366px, nhưng từ ảnh 414×414 thì phải nội suy. Ảnh nhỏ lấy
      đúng cỡ nó có, còn nét ở 1x, thay vì mờ ở 2x.
    */
    const shortest = Math.min(p.image.width, p.image.height);
    const card = Math.min(CARD, shortest);

    /*
      Trước đây chỗ này là `shortest >= CARD * 2 ? [1, 2] : [1]` — được ăn cả ngã về
      không. Ảnh gốc thiếu dù chỉ một chút so với mốc 2x là rơi thẳng xuống 1x, màn
      Retina phóng đôi lên nên mờ hẳn; phóng to/thu nhỏ trình duyệt thì đỡ vì lúc đó
      ô thu lại, bản 1x mới đủ điểm ảnh.

      Giờ lấy đúng mức ảnh gốc gánh được, tối đa 2x: 1.5x vẫn nét hơn 1x nhiều, và
      srcset chấp nhận bội số lẻ. Dưới 1.05x thì bỏ — thêm một file tải về mà mắt
      không phân biệt nổi.
    */
    const density = Math.min(2, shortest / card);

    return {
      ...p,
      card,
      densities: density >= 1.05 ? [1, Number(density.toFixed(2))] : [1],
      full: (
        await getImage({
          src: p.image,
          width: Math.min(1400, p.image.width),
          format: "webp",
          quality: 90,
        })
      ).src,
    };
  }),
);
---

{
  posters.length > 0 && (
    <section
      id="activities"
      class="relative overflow-hidden bg-background scroll-mt-24"
    >
      <div class="container relative z-10 mx-auto px-6">
        <BrandHeading
          title="Sự kiện tại "
          highlight="SaigonHSK"
          note="Tết · Trung thu · Giáng sinh · 20/11"
        />

        <div data-rail class="group/rail relative mt-12">
          <div
            data-rail-track
            class="activity-rail -mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-3 lg:mx-0 lg:grid lg:grid-cols-4 lg:gap-5 lg:overflow-visible lg:px-0 lg:pb-0"
          >
          {posters.map((p) => (
            <button
              type="button"
              data-lightbox={p.full}
              data-caption={p.caption}
              class="group relative block w-[78vw] max-w-80 shrink-0 snap-start cursor-zoom-in overflow-hidden rounded-3xl bg-brand-ink-50 sm:w-80 lg:w-auto lg:max-w-none"
            >
              <Image
                src={p.image}
                alt={p.caption}
                width={p.card}
                height={p.card}
                fit="cover"
                densities={p.densities}
                format="webp"
                quality={90}
                loading="lazy"
                decoding="async"
                class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />

              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-linear-to-t from-brand-ink-950/85 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              />

              <span class="pointer-events-none absolute inset-x-0 bottom-0 p-5 text-left text-[15px] font-extrabold leading-snug text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                {p.caption}
              </span>
            </button>
          ))}

            <span
              aria-hidden="true"
              class="pointer-events-none absolute -right-2 top-1/2 hidden size-20 -translate-y-1/2 rotate-6 place-items-center rounded-full bg-brand-red-600 text-center text-xs font-bold leading-tight text-white shadow-[0_18px_40px_-20px_rgba(178,24,43,0.8)] lg:grid"
            >
              为你的
              <br />
              成功
            </span>
          </div>

          <RailHint label="hoạt động" hideFrom="lg" />
        </div>
      </div>
    </section>
  )
}

<style>
  .activity-rail {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .activity-rail::-webkit-scrollbar {
    display: none;
  }
</style>
