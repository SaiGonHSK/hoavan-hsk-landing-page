---
import SectionHeading from "@/components/SectionHeading.astro";
import { testimonials } from "@/data/testimonials";
import { ICONS } from "@/lib/icons";

const initials = (name: string) =>
  name
    .split(" ")
    .slice(-2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();

const list = [...testimonials].sort(
  (a, b) =>
    Number(Boolean((b as { image?: string }).image)) -
    Number(Boolean((a as { image?: string }).image))
);

const badgeOf = (quote: string) => {
  const text = quote.replace(/<[^>]+>/g, "");
  const hsk = text.match(/HSK\s?[1-6]/i)?.[0].replace(/\s+/, "");
  const tocfl = text.match(/TOCFL(\s+Band\s+[A-C]\d?)?/i)?.[0];
  if (hsk && tocfl) return `${hsk.toUpperCase()} · TOCFL`;
  return hsk?.toUpperCase() ?? tocfl ?? "Học viên SaigonHSK";
};
---

<section id="reviews" class="overflow-hidden bg-background scroll-mt-24">
  <div class="container mx-auto px-6">
    <SectionHeading
      title="Học viên nói gì"
      highlight="về Hoa văn SaigonHSK"
      description="Phản hồi từ sinh viên và học viên đã đồng hành cùng trung tâm trên chặng đường chinh phục HSK và TOCFL."
    />

    <div class="mt-10 flex justify-center gap-3 lg:justify-end">
      <button
        type="button"
        data-review-prev
        aria-label="Cảm nhận trước"
        class="inline-flex size-12 cursor-pointer items-center justify-center rounded-full bg-brand-ink-900 text-white transition-all hover:-translate-y-0.5 disabled:cursor-default disabled:opacity-30 disabled:hover:translate-y-0 [&>svg]:size-4 [&>svg]:-scale-x-100"
        set:html={ICONS.arrow}
      />
      <button
        type="button"
        data-review-next
        aria-label="Cảm nhận tiếp theo"
        class="inline-flex size-12 cursor-pointer items-center justify-center rounded-full bg-brand-ink-900 text-white transition-all hover:-translate-y-0.5 disabled:cursor-default disabled:opacity-30 disabled:hover:translate-y-0 [&>svg]:size-4"
        set:html={ICONS.arrow}
      />
    </div>

    <div
      data-review-track
      class="mt-6 flex snap-x snap-mandatory items-stretch gap-6 overflow-x-auto scroll-smooth pb-4 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        list.map((t) => {
          const image = (t as { image?: string }).image;

          return (
            <figure
              data-review-card
              class="flex w-[min(88vw,34rem)] shrink-0 snap-start flex-col overflow-hidden rounded-[2rem] border border-border bg-background lg:w-[calc((100%-1.5rem)/2)]"
            >
              <div class="flex flex-1 gap-6 p-7 md:p-8">
                <div class="flex flex-1 flex-col">
                  <span
                    aria-hidden="true"
                    class="font-serif text-6xl leading-[0.6] text-brand-ink-200"
                  >
                    &ldquo;
                  </span>
                  <blockquote
                    class="rich mt-5 text-[0.95rem] leading-[1.85] text-brand-ink-700"
                    set:html={t.quote}
                  />
                </div>

                {image && (
                  <img
                    src={image}
                    alt={`Học viên ${t.name}`}
                    width="600"
                    height="800"
                    loading="lazy"
                    decoding="async"
                    class="hidden aspect-[3/4] w-36 shrink-0 self-start rounded-2xl object-cover object-top sm:block"
                  />
                )}
              </div>

              <figcaption class="mt-auto flex items-center justify-between gap-4 border-t border-border bg-brand-ink-50/70 px-7 py-5 md:px-8">
                <div class="flex min-w-0 items-center gap-3">
                  {image ? (
                    <img
                      src={image}
                      alt=""
                      width="96"
                      height="96"
                      loading="lazy"
                      decoding="async"
                      class="size-12 shrink-0 rounded-full object-cover object-top"
                    />
                  ) : (
                    <span class="grid size-12 shrink-0 place-items-center rounded-full bg-brand-red-100 text-sm font-black text-brand-red-700">
                      {initials(t.name)}
                    </span>
                  )}

                  <div class="min-w-0">
                    <p class="truncate font-bold text-brand-ink-900">{t.name}</p>
                    <p class="truncate text-sm text-muted-foreground">{t.role}</p>
                  </div>
                </div>

                <span class="shrink-0 rounded-full border border-border bg-background px-5 py-2.5 text-sm font-bold text-brand-ink-900">
                  {badgeOf(t.quote)}
                </span>
              </figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>("[data-review-track]");
  const prev = document.querySelector<HTMLButtonElement>("[data-review-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-review-next]");

  if (track && prev && next) {

    const step = () => {
      const card = track.querySelector<HTMLElement>("[data-review-card]");
      if (!card) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || "24");
      return card.offsetWidth + gap;
    };

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 1;
      prev.disabled = track.scrollLeft <= 0;
      next.disabled = track.scrollLeft >= max;
    };

    prev.addEventListener("click", () => track.scrollBy({ left: -step() }));
    next.addEventListener("click", () => track.scrollBy({ left: step() }));
    track.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    sync();
  }
</script>
