---
import SectionHeading from "@/components/SectionHeading.astro";
import RailHint from "@/components/RailHint.astro";
import { testimonials } from "@/data/testimonials";

const initials = (name: string) =>
  name
    .split(" ")
    .slice(-2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();

const list = [...testimonials].sort(
  (a, b) => Number(Boolean(b.image)) - Number(Boolean(a.image)),
);

// `quote` là chữ thuần nên không còn thẻ HTML để bỏ; vẫn dò trên chuỗi thô.
const badgeOf = (quote: string) => {
  const hsk = quote.match(/HSK\s?[1-6]/i)?.[0].replace(/\s+/, "");
  const tocfl = quote.match(/TOCFL(\s+Band\s+[A-C]\d?)?/i)?.[0];
  if (hsk && tocfl) return `${hsk.toUpperCase()} · TOCFL`;
  return hsk?.toUpperCase() ?? tocfl ?? "Học viên SaigonHSK";
};
---

<section id="reviews" class="overflow-hidden bg-background scroll-mt-24">
  <div class="container mx-auto px-6">
    <SectionHeading
      title="Học viên nói gì"
      highlight="về Hoa văn SaigonHSK"
    />

    <div data-rail class="group/rail relative mt-16">
      <div
        data-rail-track
        class="flex snap-x snap-mandatory items-stretch gap-6 overflow-x-auto scroll-smooth pb-4 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
        list.map((t) => {
          const image = t.image;

          return (
            <figure
              data-review-card
              class="flex w-[min(88vw,34rem)] shrink-0 snap-start flex-col overflow-hidden rounded-[2rem] border border-border bg-background lg:w-[calc((100%-1.5rem)/2)]"
            >
              <div class="flex flex-1 gap-6 p-7 md:p-8">
                <div class="flex flex-1 flex-col">
                  <span
                    aria-hidden="true"
                    class="font-serif text-6xl leading-[0.6] text-brand-ink-200"
                  >
                    &ldquo;
                  </span>
                  {/*
                    Nội suy chứ không `set:html`: `quote` là chữ thuần do người soạn
                    nhập, in như HTML thì dấu < và & của họ thành thẻ. `whitespace-pre-line`
                    để chỗ họ xuống dòng vẫn xuống dòng.
                  */}
                  <blockquote class="mt-5 whitespace-pre-line text-[0.95rem] leading-[1.85] text-brand-ink-700">
                    {t.quote}
                  </blockquote>
                </div>

                {image && (
                  <img
                    src={image}
                    alt={`Học viên ${t.name}`}
                    width="600"
                    height="800"
                    loading="lazy"
                    decoding="async"
                    class="hidden aspect-[3/4] w-36 shrink-0 self-start rounded-2xl object-cover object-top sm:block"
                  />
                )}
              </div>

              <figcaption class="mt-auto flex items-center justify-between gap-4 border-t border-border bg-brand-ink-50/70 px-7 py-5 md:px-8">
                <div class="flex min-w-0 items-center gap-3">
                  {image ? (
                    <img
                      src={image}
                      alt=""
                      width="96"
                      height="96"
                      loading="lazy"
                      decoding="async"
                      class="size-12 shrink-0 rounded-full object-cover object-top"
                    />
                  ) : (
                    <span class="grid size-12 shrink-0 place-items-center rounded-full bg-brand-red-100 text-sm font-black text-brand-red-700">
                      {initials(t.name)}
                    </span>
                  )}

                  <div class="min-w-0">
                    <p class="truncate font-bold text-brand-ink-900">
                      {t.name}
                    </p>
                    <p class="truncate text-sm text-muted-foreground">
                      {t.role}
                    </p>
                  </div>
                </div>

                {/*
                  Có link nguồn thì huy hiệu thành liên kết tới bài đăng gốc để người
                  xem tự kiểm chứng; không có thì vẫn là nhãn tĩnh như trước.
                */}
                {t.link ? (
                  <a
                    href={t.link}
                    target="_blank"
                    rel="noopener nofollow"
                    class="shrink-0 rounded-full border border-border bg-background px-5 py-2.5 text-sm font-bold text-brand-ink-900 transition-colors hover:border-brand-red-300 hover:text-brand-red-700"
                  >
                    {badgeOf(t.quote)}
                    <span class="sr-only"> — xem bài đăng gốc của {t.name}</span>
                  </a>
                ) : (
                  <span class="shrink-0 rounded-full border border-border bg-background px-5 py-2.5 text-sm font-bold text-brand-ink-900">
                    {badgeOf(t.quote)}
                  </span>
                )}
              </figcaption>
            </figure>
          );
        })
        }
      </div>

      <RailHint label="đánh giá" />
    </div>
  </div>
</section>
