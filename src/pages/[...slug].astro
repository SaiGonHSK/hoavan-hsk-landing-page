---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { findParent, getPageContents } from "@/data/pages";
import { site } from "@/data/site";

/**
 * Trang động: nội dung do giáo vụ soạn trong trang quản trị.
 *
 * Đây là phần duy nhất của landing lấy dữ liệu từ API — cấu trúc menu và mọi khối
 * nội dung khác đều nằm cứng trong repo. Astro ưu tiên các file route cố định
 * (/, /about, /courses…) nên route này chỉ nhận đường dẫn chưa có trang riêng.
 */
export async function getStaticPaths() {
  const pages = await getPageContents();

  return pages.map((page) => ({
    params: { slug: page.slug.replace(/^\/+/, "") },
    props: { page, parent: findParent(page.slug) },
  }));
}

const { page, parent } = Astro.props;

const crumbs = parent
  ? [{ label: parent.label, href: parent.slug }, { label: page.title }]
  : [{ label: page.title }];

/** Bài do giáo vụ soạn → khai báo là Article để Google hiểu đúng loại nội dung. */
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: page.title,
    description: page.summary,
    inLanguage: "vi-VN",
    author: { "@type": "Organization", name: site.fullName },
    publisher: { "@id": `${Astro.site?.origin ?? ""}/#organization` },
  },
];
---

<Layout
  title={`${page.title} | ${site.shortName}`}
  description={page.summary || page.intro || site.description}
  ogType="article"
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <PageHero title={page.title} description={page.intro} crumbs={crumbs} glyph="文" />

    <section class="bg-background">
      <div class="container mx-auto px-6">
        <article
          class="rich mx-auto max-w-3xl rounded-3xl bg-brand-ink-50 p-7 text-base leading-relaxed text-muted-foreground md:p-10"
          set:html={page.body}
        />
      </div>
    </section>

    {
      parent && parent.children.length > 1 && (
        <section class="bg-background">
          <div class="container mx-auto px-6">
            <h2 class="text-xl font-extrabold text-brand-ink-900">
              Cùng mục {parent.label}
            </h2>
            <div class="mt-5 flex flex-wrap gap-3">
              {parent.children
                .filter((child) => child.slug !== page.slug)
                .slice(0, 10)
                .map((child) => (
                  <a
                    href={child.slug}
                    class="rounded-full bg-brand-ink-50 px-5 py-2.5 text-sm font-semibold text-foreground transition-transform hover:-translate-y-0.5"
                  >
                    {child.label}
                  </a>
                ))}
            </div>
          </div>
        </section>
      )
    }

    <RegisterSection />
    <CtaSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
