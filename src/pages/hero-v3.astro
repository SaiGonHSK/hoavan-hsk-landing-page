---
/*
  Trang xem thử phương án hero 3, để so trực tiếp với hero đang chạy ở trang chủ mà không
  phải đổi qua đổi lại dòng import trong `index.astro`. `noindex` vì đây là trang nội bộ.

  Chốt xong phương án thì xoá file này.
*/
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import HeroV3 from "@/components/HeroV3.astro";
import Achievements from "@/components/Achievements.astro";
---

<Layout
  title="Xem thử HeroV3"
  description="Trang xem thử phương án hero 3."
  noindex
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <HeroV3 />
    <Achievements />
  </main>
</Layout>
