---
import CatalogDetail from "@/components/CatalogDetail.astro";
import { trialClasses } from "@/data/catalog";

export function getStaticPaths() {
  return trialClasses.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;

const related = trialClasses
  .filter((c) => c.slug !== item.slug)
  .map((c) => ({ label: c.title, href: `/trial/${c.slug}` }));
---

<CatalogDetail
  seoTitle={`${item.title} miễn phí tại TP.HCM | SaigonHSK`}
  courseSchema
  title={item.title}
  summary={item.summary}
  intro={item.intro}
  facts={item.facts}
  content={item.content}
  contentTitle="Buổi học thử gồm những gì"
  outcomes={item.outcomes}
  glyph="试"
  crumbs={[{ label: "Học thử trải nghiệm", href: "/trial" }, { label: item.title }]}
  related={related}
  relatedTitle="Cấp độ khác"
/>
