---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ScheduleHero from "@/components/ScheduleHero.astro";
import ScheduleCards from "@/components/ScheduleCards.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import EnrollCta from "@/components/EnrollCta.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { schedule, scheduleNote, scheduleTitle } from "@/data/schedule";
import { findProgram, visiblePrograms } from "@/data/programsApi";
import { contact, site } from "@/data/site";
import { ICONS } from "@/lib/icons";
// Ảnh tách nền cho hero.
import registerTeacher from "@/assets/register-teacher.webp";
import { openingScheduleSchema } from "@/lib/schema";

/**
 * Câu mở đầu, ghép từ tên đợt đang đăng.
 *
 * Trước đây câu này viết cứng "Lịch khai giảng dự kiến tháng 8/2026" — không có gì nối
 * nó với các lớp bên dưới, nên sang tháng 9 là trang tự mâu thuẫn với chính nó cho tới
 * khi có người nhớ ra. Giờ tên đợt đi kèm chính những lớp đó, và trung tâm đổi nó trong
 * console. Chưa đăng đợt nào thì bỏ luôn mệnh đề tháng thay vì in một chỗ trống.
 */
const heroDescription = [
  scheduleTitle ? `${scheduleTitle} cho cả lớp offline và online.` : "",
  // Ghi chú của đợt, do console soạn: "Lịch dự kiến — gọi hotline để giữ chỗ." Câu chốt
  // bên dưới không còn nhắc hotline nữa để hai câu khỏi nói cùng một việc.
  scheduleNote,
]
  .filter(Boolean)
  .join(" ") ||
  // Chưa đăng đợt nào thì hai câu trên đều rỗng — hero vẫn cần một câu, không để trống
  // dưới tiêu đề. Câu này nói việc trang làm, đúng cả khi lịch còn đang cập nhật.
  "Lớp mở hằng tháng cho cả hình thức offline tại trung tâm và online, có lớp buổi tối và cuối tuần.";

/** Số lớp dùng cho chip hero, đếm thẳng từ lịch để không lệch khi đổi đợt */
const opening = schedule.filter((row) => row.openDateISO);
const onlineCount = opening.filter((row) =>
  row.mode === "online",
).length;

const hasOpening = opening.length > 0;

/**
 * Chip nổi quanh ảnh hero — bốn câu quyết định người xem có bấm đăng ký hay không: đợt
 * này mở mấy lớp, có lớp ngoài giờ hành chính không, có lớp online không, lớp bao nhiêu
 * người.
 *
 * Ba câu đầu đọc từ lịch nên không bao giờ lệch với các lớp bên dưới. Chưa đăng đợt nào
 * thì hai chip đếm được đổi sang điều vẫn đúng lúc đó, thay vì in "0 lớp".
 */
const heroChips = [
  hasOpening ? `${opening.length} lớp đang mở đăng ký` : "Đang nhận đăng ký đợt tới",
  "Có lớp buổi tối và cuối tuần",
  onlineCount > 0 ? `${onlineCount} lớp học online` : "Test trình độ miễn phí",
  "Mỗi lớp 10–15 học viên",
];

/**
 * Thứ tự các khối trên trang = thứ tự chương trình người quản trị sắp trong console.
 *
 * Cần bảng này vì lịch đã được server sắp theo **ngày khai giảng**: gom nhóm theo thứ tự
 * gặp thì khối nào tình cờ có lớp khai giảng sớm nhất sẽ nhảy lên đầu trang, và thứ tự
 * đổi mỗi tháng theo lịch mở lớp. Trang giới thiệu phải đọc theo lộ trình (Sơ cấp →
 * Trung cấp → Cao cấp), không theo ngày.
 *
 * Lớp trong từng khối vẫn giữ thứ tự ngày khai giảng — đó là thứ người xem cần bên trong
 * một chương trình.
 */
const programRank = new Map(visiblePrograms().map((program, i) => [program.slug, i]));

/**
 * Gom lớp theo chương trình.
 *
 * Lớp của khoá chưa thuộc chương trình nào vẫn lên trang: nó đứng thành khối riêng mang
 * tên khoá, xếp sau mọi chương trình, chỉ không có nút "Xem chương trình". Giấu một lớp
 * đang tuyển sinh vì chưa ai khai chương trình cho khoá của nó là mất học viên, không
 * phải dữ liệu sạch.
 */
const groups = schedule
  .reduce<
    {
      /** Khoá gom nhóm, cũng là mã neo `#lich-…` của khối. */
      key: string;
      title: string;
      summary: string;
      /** `null` khi lớp chưa gom về chương trình nào — không dựng link chết. */
      href: string | null;
      /** Vị trí trong danh sách chương trình; khối không thuộc chương trình nào xuống cuối. */
      rank: number;
      rows: typeof schedule;
    }[]
  >((acc, row) => {
    const program = row.programSlug ? findProgram(row.programSlug) : undefined;
    const key = program?.slug ?? (row.courseCode || row.code);

    const found = acc.find((g) => g.key === key);
    if (found) {
      found.rows = [...found.rows, row];
      return acc;
    }

    acc.push({
      key,
      title: program?.title ?? row.courseTitle ?? row.name,
      summary: program?.summary ?? "",
      href: program ? `/courses/programs/${program.slug}` : null,
      rank: program ? (programRank.get(program.slug) ?? Number.MAX_SAFE_INTEGER) : Number.MAX_SAFE_INTEGER,
      rows: [row],
    });
    return acc;
  }, [])
  // `sort` sau `reduce`, không sắp sẵn `schedule`: gom nhóm cần thứ tự ngày để lớp trong
  // mỗi khối đúng thứ tự, còn thứ tự khối là chuyện của chương trình.
  .sort((a, b) => a.rank - b.rank);

/*
  Lịch khai giảng dạng dữ liệu có cấu trúc.

  Đây là thông tin "hết hạn" nhanh nhất trên site, và cũng là thứ AI hay trả lời bằng
  lịch cũ nó nhớ được. Khai `Course` kèm `CourseInstance` có `startDate` thật để bot
  đọc được ngày khai giảng của đợt đang đăng chứ không đoán.
*/
const scheduleSchemas = [
  openingScheduleSchema(schedule, Astro.site?.origin ?? "", {
    name: site.fullName,
    address: contact.address,
  }),
].filter(Boolean) as Record<string, unknown>[];
---

<Layout
  title="Lịch khai giảng lớp tiếng Trung TPHCM | SaigonHSK"
  description="Lịch khai giảng lớp tiếng Trung tại TP.HCM: sơ cấp, trung cấp, luyện thi HSK, giao tiếp cấp tốc, VIP 1 kèm 1. Có lớp buổi tối và cuối tuần, mở lớp hằng tháng."
  keywords="lịch khai giảng tiếng Trung TPHCM, lớp tiếng Trung buổi tối, lớp tiếng Trung cuối tuần, học phí tiếng Trung TPHCM"
  schemas={scheduleSchemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <ScheduleHero
      title="Học tiếng Trung ở TP.HCM:"
      titleAccent="chọn lớp khai giảng của bạn"
      description={heroDescription}
      crumbs={[{ label: "Lịch khai giảng" }]}
      image={registerTeacher}
      imageAlt="Giảng viên Hoa văn SaigonHSK giới thiệu lịch khai giảng các lớp tiếng Trung"
      chips={heroChips}
    >
      <div class="mt-8 flex flex-col items-center gap-4">
        <a
          href="/register"
          class="group inline-flex items-center gap-2 rounded-full bg-brand-red-600 px-8 py-4 text-sm font-bold text-white shadow-lg shadow-brand-red-600/25 transition-all hover:-translate-y-0.5 hover:bg-brand-red-700"
        >
          Đăng ký giữ chỗ
          <span
            class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 [&>svg]:size-4"
            set:html={ICONS.arrowUpRight}
          />
        </a>
      </div>
    </ScheduleHero>

    {
      /*
        Chưa đăng đợt nào — trạng thái có thật, không phải lỗi: giữa hai đợt trung tâm
        có thể chưa chốt lịch tháng sau. Nói thẳng và đưa số hotline, thay vì để lại một
        trang chỉ có ô tìm kiếm rỗng và ba con số 0. Ô tìm kiếm cùng các khối lớp bên
        dưới đều ẩn đi vì không có gì để tìm.
      */
      schedule.length === 0 && (
        <section>
          <div class="container mx-auto px-6">
            <div class="rounded-lg border-2 border-dashed border-border bg-brand-ink-50/60 p-10 text-center">
              <p class="text-lg font-black text-brand-ink-900">
                Trung tâm đang cập nhật lịch khai giảng
              </p>
              <p class="mt-2 text-sm text-muted-foreground">
                Lịch đợt tới sẽ được đăng tại đây. Gọi
                <a
                  href={`tel:${contact.phonePrimaryRaw}`}
                  class="font-bold text-brand-red-600 hover:underline"
                >
                  {contact.phonePrimary}
                </a>{" "}
                để được báo lịch sớm và giữ chỗ trước.
              </p>
            </div>
          </div>
        </section>
      )
    }

    <!-- Tìm lớp + điều hướng nhanh theo chương trình -->
    <section class:list={["scroll-mt-24", schedule.length === 0 && "hidden"]}>
      <div class="container mx-auto px-6">
        {/* Tiêu đề canh giữa mở phần chọn lớp: hero nói đợt này mở gì, từ đây trở xuống
            là việc của người xem — tìm và so lớp. */}
        <div class="mx-auto max-w-2xl text-center">
          <h2
            class="font-heading text-[1.75rem] font-black leading-tight tracking-tight text-balance text-brand-ink-900 md:text-[2.5rem]"
          >
            Chọn lớp theo trình độ và{" "}
            <span class="text-brand-red-600">giờ học của bạn</span>
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground md:text-base">
            Mỗi lớp bên dưới ghi rõ ngày khai giảng, các buổi học trong tuần, giờ
            học, thời lượng và nơi học — xem đủ rồi hãy đăng ký.
          </p>
        </div>

        <div
          class="mt-10 rounded-lg border border-border bg-background p-6 md:p-8"
        >
          <label
            for="schedule-search"
            class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-muted-foreground"
          >
            Tìm lớp bạn muốn học
          </label>

          <div class="relative mt-3">
            <span
              class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground [&>svg]:size-4"
              set:html={ICONS.search}
            />
            <input
              id="schedule-search"
              type="search"
              data-schedule-search
              placeholder="Nhập mã lớp hoặc tên lớp: HSK1, HSK5, giao tiếp…"
              class="w-full rounded-lg border border-border bg-brand-ink-50/60 py-3.5 pl-11 pr-4 text-sm font-medium text-foreground outline-none transition-colors placeholder:font-normal placeholder:text-muted-foreground focus:border-brand-red-400 focus:bg-background"
            />
          </div>

          <div class="mt-5 flex flex-wrap gap-2.5">
            {
              groups.map((g) => (
                <a
                  href={`#lich-${g.key}`}
                  class="group inline-flex items-center gap-2.5 rounded-lg border border-border bg-background px-4 py-2.5 text-sm font-bold text-brand-ink-900 transition-colors hover:border-brand-ink-300"
                >
                  {g.title}
                  <span class="rounded-md bg-brand-ink-50 px-2 py-0.5 text-[0.6875rem] font-bold text-muted-foreground">
                    {g.rows.length} lớp
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {
      groups.map((g) => (
        <section id={`lich-${g.key}`} data-group class="scroll-mt-24">
          <div class="container mx-auto px-6">
            <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
              <div>
                <p class="text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-brand-red-600">
                  Các lớp {g.title.toLowerCase()}
                </p>
                <h2 class="mt-3 text-[1.75rem] font-black leading-tight tracking-tight text-brand-ink-900 md:text-4xl">
                  Lịch học{" "}
                  <span class="text-brand-red-600">{g.title}</span>
                </h2>
                {g.summary && (
                  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground">
                    {g.summary}
                  </p>
                )}
              </div>

              {/* Khối của khoá chưa gom về chương trình nào thì không có trang để
                  dẫn tới — bỏ nút, không dựng link 404. */}
              {g.href && (
                <a
                  href={g.href}
                  class="group inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-6 py-3 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
                >
                  Xem chương trình
                  <span
                    class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
                    set:html={ICONS.arrow}
                  />
                </a>
              )}
            </div>

            <ScheduleCards rows={g.rows} class="mt-8" />
          </div>
        </section>
      ))
    }

    <section data-empty hidden>
      <div class="container mx-auto px-6">
        <div
          class="rounded-lg border-2 border-dashed border-border bg-brand-ink-50/60 p-10 text-center"
        >
          <p class="text-lg font-black text-brand-ink-900">
            Không tìm thấy lớp phù hợp
          </p>
          <p class="mt-2 text-sm text-muted-foreground">
            Thử từ khoá khác, hoặc gọi
            <a
              href={`tel:${contact.phonePrimaryRaw}`}
              class="font-bold text-brand-red-600 hover:underline"
              >{contact.phonePrimary}</a
            > để trung tâm tư vấn lớp đúng trình độ.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA ghi danh sớm -->
    <EnrollCta />

    <RegisterSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>(
    "[data-schedule-search]",
  );
  const groups = document.querySelectorAll<HTMLElement>("[data-group]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");

  if (input) {
    const normalize = (s: string) =>
      s
        .toLowerCase()
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .replace(/đ/g, "d")
        .trim();

    input.addEventListener("input", () => {
      const q = normalize(input.value);
      let total = 0;

      groups.forEach((group) => {
        let shown = 0;

        group
          .querySelectorAll<HTMLElement>("[data-class-card]")
          .forEach((card) => {
            const match = !q || (card.dataset.search ?? "").includes(q);
            card.hidden = !match;
            if (match) shown += 1;
          });

        group.hidden = shown === 0;
        total += shown;
      });

      if (empty) empty.hidden = total > 0;
    });
  }
</script>
