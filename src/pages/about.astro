---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import DailyLife from "@/components/DailyLife.astro";
import Milestones from "@/components/Milestones.astro";
import { mission, contact, about } from "@/data/site";
import { coreValues } from "@/data/coreValues";
import { ICONS } from "@/lib/icons";
import { aboutPageSchema } from "@/lib/schema";


const sections = [
  {
    title: "Điểm khác biệt của chúng tôi",
    desc: "Giáo trình riêng cho người Việt, giảng viên Thạc sĩ – Tiến sĩ, ứng dụng luyện đề của trung tâm và cam kết đầu ra HSK.",
    href: "/about/differences",
  },
  {
    title: "Đội ngũ giảng viên",
    desc: "Thạc sĩ, Tiến sĩ tốt nghiệp các đại học lớn của Trung Quốc, đang giảng dạy tại nhiều trường đại học TP.HCM.",
    href: "/about/teachers",
  },
  {
    title: "Học viên cảm nhận và đánh giá",
    desc: "Phản hồi thật của sinh viên và học viên sau khi hoàn thành khoá học tại trung tâm.",
    href: "/about/reviews",
  },
  {
    title: "Thành tích học viên",
    desc: "Chuẩn đầu ra cam kết theo từng nhóm lớp: 100% đậu HSK1, HSK2, HSK3, HSK4, HSK5.",
    href: "/about/achievements",
  },
  {
    title: "Cam kết",
    desc: "Ba cam kết áp dụng cho mọi khoá học, trong đó có học lại miễn phí nếu không đạt đầu ra.",
    href: "/about/commitments",
  },
];

/* Trang nhánh của mục Giới thiệu: khai `AboutPage` gộp vào node `WebPage` của Layout,
   `mainEntity` trỏ về `#organization` để AI biết trang này nói *về* trung tâm. */
const schemas = [aboutPageSchema({ pathname: Astro.url.pathname, site: Astro.site })];
---

<Layout
  title="Giới thiệu trung tâm tiếng Trung SaigonHSK TPHCM"
  description="Trung tâm Hoa văn SaigonHSK đào tạo tiếng Trung, luyện thi HSK tại TP.HCM từ năm 2019, có giấy phép của Sở Giáo dục. Giảng viên Thạc sĩ – Tiến sĩ, cam kết đầu ra."
  keywords="trung tâm tiếng Trung uy tín TPHCM, review trung tâm tiếng Trung, giới thiệu SaigonHSK, trung tâm tiếng Trung có cam kết đầu ra, trung tâm tiếng Trung có giấy phép Sở Giáo dục"
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <PageHero
      title="Trung tâm Hoa văn SaigonHSK"
      crumbs={[{ label: "Giới thiệu" }]}
      glyph="华"
    />

    <section class="bg-background">
      <div class="container mx-auto px-6">
        {/*
          Ba khối Sứ mệnh / Phương châm / Tầm nhìn xếp dọc *dưới* phần văn xuôi ở mọi
          khổ, không còn làm cột phải ở desktop.

          Đặt cạnh cột chữ thì ba thẻ màu nằm ngang tầm mắt với đoạn mở đầu và tranh
          chú ý với nó; đưa xuống dưới thì người đọc đi hết phần kể về trung tâm rồi
          mới gặp ba lời khẳng định — đúng thứ tự đọc.
        */}
        <div class="flex flex-col gap-12 lg:gap-16">
          <div>
            <div class="space-y-5 text-base leading-relaxed text-muted-foreground">
              {about.paragraphs.map((p) => <p>{p}</p>)}
            </div>

          </div>

          <div class="space-y-5">
            <div class="rounded-3xl bg-brand-red-600 p-7 text-white">
              <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-white/70">
                Sứ mệnh
              </p>
              <p class="mt-3 text-base leading-relaxed text-white/90">
                {mission.statement}
              </p>
            </div>
            <div class="rounded-3xl bg-brand-ink-50 p-7">
              <p
                class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-red-600"
              >
                Phương châm hoạt động
              </p>
              <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                {mission.motto}
              </p>
            </div>
            <div class="rounded-3xl border border-border p-7">
              <p
                class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-red-600"
              >
                Tầm nhìn
              </p>
              <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                {mission.vision}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-brand-ink-50 py-14 lg:py-20">
      <div class="container mx-auto px-6">
        <div
          class="grid gap-12 rounded-[2.5rem] bg-background px-7 py-12 shadow-[0_30px_60px_-45px_rgba(15,23,42,0.35)] md:px-14 md:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:items-center lg:gap-20 lg:px-20"
        >
          <div>
            <SectionHeading
              align="left"
              title="Giá trị"
              highlight="cốt lõi"
              inlineHighlight
              description="Năm giá trị định hướng mọi hoạt động đào tạo và dịch vụ của Hoa văn SaigonHSK."
            />
            <a
              href="/about/differences"
              class="group mt-8 inline-flex items-center gap-2 rounded-full bg-brand-red-600 px-7 py-3.5 text-sm font-bold text-white shadow-lg shadow-brand-red-600/25 transition-all hover:-translate-y-0.5 hover:bg-brand-red-700"
            >
              Tìm hiểu thêm
              <span
                class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
                set:html={ICONS.arrow}
              />
            </a>
          </div>

          <ul class="flex flex-col gap-5">
            {
              coreValues.map((v, i) => (
                <li class="flex items-start gap-4 sm:gap-5">
                  <Image
                    src={v.image}
                    alt={v.imageAlt}
                    width={176}
                    height={176}
                    loading={i === 0 ? "eager" : "lazy"}
                    class="size-18 shrink-0 rounded-xl object-cover sm:size-22"
                  />
                  <div class="pt-0.5">
                    <h2 class="text-base font-extrabold leading-snug text-brand-ink-900 sm:text-lg">
                      {v.title}
                    </h2>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                      {v.desc}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>



    {/* Ảnh lớp thật, thay cho khối Cơ sở vật chất cũ (3 ảnh phòng học tĩnh). */}
    <DailyLife />
    {/* Số liệu chốt lại phần giới thiệu, ngay trước lời mời đăng ký. */}
    <Milestones />

    <section class="bg-background">
      <div class="container mx-auto px-6">
        <SectionHeading
          title="Tìm hiểu thêm về"
          highlight="trung tâm"
          description="Mỗi mục dưới đây là một trang riêng, đi sâu vào từng khía cạnh của SaigonHSK."
        />

        {/*
          Năm mục gom trong **một** khối, phân cách bằng vạch mảnh — không phải năm hộp
          xám rời.

          Năm hộp riêng đặt cạnh nhau ở khổ hẹp (~230px) thì mỗi cặp thẻ có tới bốn mép
          liền nhau (padding + bo góc + khoảng cách + padding), nên chữ trông như bị ép
          vào giữa các viền. Gom lại thì chỉ còn một đường viền ngoài và bốn vạch một
          nét, chữ có chỗ thở mà khối vẫn gọn.

          Đây cũng là idiom site đang dùng cho dải bốn ô: hàng tiện nghi trong
          `Facility.astro` và dải số trong `Milestones.astro`.
        */}
        <div
          class="mt-12 grid overflow-hidden rounded-3xl border border-border bg-brand-ink-50/50 lg:grid-cols-5"
        >
          {
            sections.map((s) => (
              <a
                href={s.href}
                class:list={[
                  "group p-6 transition-colors hover:bg-background",
                  /*
                    Vạch ngang khi xếp dọc (mobile/tablet), vạch dọc khi thành một hàng
                    (desktop). Viết tường minh thay vì `divide-x`: `divide-x` đặt viền
                    trái cho mọi con từ thứ hai, nên khi lưới xuống hàng nó vẽ thêm một
                    vạch ở đầu hàng dưới — đúng chỗ không nên có vạch.
                  */
                  "border-t border-brand-ink-200 first:border-t-0",
                  "lg:border-t-0 lg:border-l lg:first:border-l-0",
                ]}
              >
                {/*
                  Không còn dòng "Xem chi tiết": cả ô đã là một `<a>` nên dòng đó là lời
                  mời thứ hai cho cùng một liên kết, nhân lên năm lần thì thành nhiễu. Dấu
                  hiệu bấm được chuyển sang hành vi: ô đổi nền, tiêu đề sang màu thương
                  hiệu.

                  `h3` chứ không `h2`: tiêu đề section này (`SectionHeading`) đã là `h2`.
                */}
                <h3 class="text-[15px] font-extrabold leading-snug text-brand-ink-900 transition-colors group-hover:text-brand-red-600">
                  {s.title}
                </h3>
                <p class="mt-2.5 text-[13px] leading-relaxed text-muted-foreground">
                  {s.desc}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>


    {/*
      Chỉ còn `CtaSection`, bỏ `RegisterSection`.

      Hai khối này nói cùng một việc: `RegisterSection` là form đầy đủ với tiêu đề "Nhận
      tư vấn lộ trình và test trình độ miễn phí", `CtaSection` là thẻ đỏ "Đăng ký tư vấn
      miễn phí" dẫn sang /register. Đặt liền nhau thì người đọc gặp hai lời mời giống
      nhau trong một màn hình, và trang có hai chỗ nhận cùng một loại thông tin.

      Giữ `CtaSection` vì trang này là trang giới thiệu, không phải trang chuyển đổi:
      việc của nó là kể trung tâm là ai rồi dẫn sang /register — nơi form là nội dung
      chính. Trang chủ cũng đang chọn đúng như vậy.
    */}
    <CtaSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
