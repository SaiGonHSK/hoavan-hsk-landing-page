---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { getLibrary } from "@/data/library";
import { site } from "@/data/site";

export async function getStaticPaths() {
  const library = await getLibrary();
  return library.map((item) => ({ params: { slug: item.key }, props: { item } }));
}

const { item } = Astro.props;

const others = (await getLibrary()).filter((entry) => entry.slug !== item.slug).slice(0, 8);

/** Bài viết trong thư viện là dạng article, khai báo schema tương ứng. */
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: item.title,
    description: item.summary,
    inLanguage: "vi-VN",
    author: { "@type": "Organization", name: site.fullName },
    publisher: { "@id": `${Astro.site?.origin ?? ""}/#organization` },
  },
];
---

<Layout
  title={`${item.title} | ${site.shortName}`}
  description={item.summary}
  ogType="article"
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <PageHero
      title={item.title}
      description={item.intro}
      crumbs={[{ label: "Thư viện", href: "/library" }, { label: item.title }]}
      glyph="文"
    />

    <section class="bg-background">
      <div class="container mx-auto px-6">
        <article
          class="rich mx-auto max-w-3xl rounded-3xl bg-brand-ink-50 p-7 text-base leading-relaxed text-muted-foreground md:p-10"
          set:html={item.body}
        />
      </div>
    </section>

    {
      others.length > 0 && (
        <section class="bg-background">
          <div class="container mx-auto px-6">
            <h2 class="text-xl font-extrabold text-brand-ink-900">
              Chuyên mục khác
            </h2>
            <div class="mt-5 flex flex-wrap gap-3">
              {others.map((entry) => (
                <a
                  href={entry.slug}
                  class="rounded-full bg-brand-ink-50 px-5 py-2.5 text-sm font-semibold text-foreground transition-transform hover:-translate-y-0.5"
                >
                  {entry.title}
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <RegisterSection />
    <CtaSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
