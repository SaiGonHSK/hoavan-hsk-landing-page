---
import CatalogHub from "@/components/CatalogHub.astro";
import { library } from "@/data/catalog";
---

<CatalogHub
  title="Thư viện tiếng Trung"
  metaTitle="Thư viện tiếng Trung — từ vựng, ngữ pháp, thành ngữ"
  description="Kho tài liệu mở của SaigonHSK: từ vựng theo chủ đề, ngữ pháp, thành ngữ, văn hoá Trung Hoa và nhiều chuyên mục khác — học viên dùng miễn phí."
  crumbs={[{ label: "Thư viện" }]}
  glyph="书"
  groups={[
    {
      title: "Các chuyên mục",
      cards: library.map((c) => ({
        title: c.title,
        summary: c.summary,
        href: `/library/${c.slug}`,
      })),
    },
  ]}
/>
