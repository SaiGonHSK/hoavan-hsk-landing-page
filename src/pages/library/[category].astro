---
import LibraryHub from "@/components/LibraryHub.astro";
import { articlesInCategory, findLibraryCategory } from "@/data/library";

// Chuyên mục do trang quản trị soạn (bảng `library_categories`), nên danh sách đổi
// giữa hai lần xem là chuyện thường — tra theo params thay vì getStaticPaths.
const category = findLibraryCategory(Astro.params.category ?? "");
if (!category) return new Response(null, { status: 404 });

// Chỉ bài của chuyên mục đang xem: trang không còn hàng chip nên không cần biết
// các chuyên mục khác có bao nhiêu bài.
const articles = await articlesInCategory(category.key);
---

<LibraryHub
  title={category.label}
  metaTitle={`${category.label} — Thư viện SaigonHSK`}
  description={`Bài viết trong chuyên mục ${category.label} của Thư viện tiếng Trung SaigonHSK.`}
  crumbs={[{ label: "Thư viện", href: "/library" }, { label: category.label }]}
  glyph="文"
  articles={articles}
  emptyMessage={`Chuyên mục ${category.label} chưa có bài viết nào. Bạn chọn chuyên mục khác ở menu Thư viện nhé.`}
/>
