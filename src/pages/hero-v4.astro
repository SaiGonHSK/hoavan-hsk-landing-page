---
/*
  Trang xem thử phương án hero 4, cùng mục đích với `hero-v3.astro`: so trực tiếp với hero
  đang chạy ở trang chủ mà không phải đổi qua đổi lại dòng import trong `index.astro`.
  `noindex` vì đây là trang nội bộ.

  Chốt xong phương án thì xoá cả hai file xem thử.
*/
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import HeroV4 from "@/components/HeroV4.astro";
import Achievements from "@/components/Achievements.astro";
---

<Layout
  title="Xem thử HeroV4"
  description="Trang xem thử phương án hero 4 — dây phơi ảnh."
  noindex
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <HeroV4 />
    <Achievements />
  </main>
</Layout>
