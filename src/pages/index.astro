---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Banners from "@/components/Banners.astro";
import WhyUs from "@/components/WhyUs.astro";
import Courses from "@/components/Courses.astro";
import Roadmap from "@/components/Roadmap.astro";
import Teacher from "@/components/Teacher.astro";
import Activities from "@/components/Activities.astro";
import Achievements from "@/components/Achievements.astro";
import Testimonials from "@/components/Testimonials.astro";
import FAQ from "@/components/FAQ.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
---

<Layout
  title="Học tiếng Trung & luyện thi HSK tại TP.HCM | SaigonHSK"
  description="Học tiếng Trung từ con số 0 đến HSK6, luyện thi HSK – TOCFL tại TP.HCM. Lớp 10–15 học viên, giảng viên Thạc sĩ – Tiến sĩ, cam kết 100% đầu ra."
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <Hero />
    <!-- <Banners /> -->
    <Achievements />
    <WhyUs />
    <Courses limit={4} />
    <Roadmap />
    <Teacher />
    <Activities />
    <Testimonials />
    <FAQ limit={5} />
    <RegisterSection />
    <CtaSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
