---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import WhyUs from "@/components/WhyUs.astro";
import Courses from "@/components/Courses.astro";
import Roadmap from "@/components/Roadmap.astro";
import Teacher from "@/components/Teacher.astro";
import Facility from "@/components/Facility.astro";
import Activities from "@/components/Activities.astro";
import Achievements from "@/components/Achievements.astro";
import Testimonials from "@/components/Testimonials.astro";
import TrialCta from "@/components/TrialCta.astro";
import FAQ from "@/components/FAQ.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
---

<Layout
  title="Trung tâm tiếng Trung TPHCM — luyện thi HSK | SaigonHSK"
  description="Trung tâm tiếng Trung uy tín tại TP.HCM: học từ con số 0 đến HSK6, luyện thi HSK. Lớp 10–15 học viên, cam kết 100% đầu ra, học thử miễn phí."
  keywords="trung tâm tiếng Trung TPHCM, học tiếng Trung ở đâu tốt, trung tâm tiếng Trung Sài Gòn, luyện thi HSK TPHCM, học tiếng Trung cho người mới bắt đầu"
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <Hero />
    <Achievements />
    <WhyUs />
    <Courses limit={4} />
    <!-- <Roadmap /> -->
    <Teacher />
    <Activities />
    <Facility />
    <Testimonials />
    <TrialCta />
    <FAQ limit={5} />
    <RegisterSection />
    <CtaSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
