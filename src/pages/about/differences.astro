---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { values, model, mission } from "@/data/site";
---

<Layout
  title="05 khác biệt của trung tâm tiếng Trung SaigonHSK"
  description="Vì người học, giảng viên Thạc sĩ – Tiến sĩ, lộ trình tiết kiệm thời gian, hiệu quả cao và lớp nhỏ 10–15 học viên — năm điểm khác biệt của Hoa văn SaigonHSK."
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <PageHero
      title="05 khác biệt của chúng tôi"
      description={mission.motto}
      crumbs={[{ label: "Giới thiệu", href: "/about" }, { label: "05 khác biệt" }]}
      glyph="异"
    />

    <section class="bg-background">
      <div class="container mx-auto px-6">
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            values.map((v, i) => (
              <article class="rounded-3xl bg-brand-ink-50 p-7 transition-transform duration-300 hover:-translate-y-1">
                <span class="text-2xl font-black text-brand-red-500">
                  0{i + 1}
                </span>
                <h2 class="mt-2 text-xl font-extrabold text-brand-ink-900">
                  {v.title}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                  {v.desc}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-background">
      <div class="container mx-auto px-6">
        <SectionHeading
          title="Mô hình đào tạo"
          highlight="tám điều học viên nhận được"
          description="Áp dụng cho mọi khoá học tại trung tâm, không phân biệt lớp nhóm hay lớp VIP."
        />
        <ul class="mt-12 grid gap-4 sm:grid-cols-2">
          {
            model.map((m) => (
              <li class="rounded-2xl bg-brand-ink-50 p-5 text-sm font-medium leading-relaxed text-foreground/85">
                {m}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <RegisterSection />
    <CtaSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
