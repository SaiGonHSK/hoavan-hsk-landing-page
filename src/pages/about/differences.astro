---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { model, mission } from "@/data/site";
import { valuePanels } from "@/data/valuePanels";
import { ICONS } from "@/lib/icons";
---

<Layout
  title="Điểm khác biệt của trung tâm tiếng Trung SaigonHSK"
  description="Giáo trình biên soạn riêng cho người Việt, giảng viên Thạc sĩ – Tiến sĩ, ứng dụng luyện đề riêng của trung tâm và cam kết đầu ra HSK — những điểm khác biệt của Hoa văn SaigonHSK."
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <PageHero
      title="Điểm khác biệt của chúng tôi"
      description={mission.motto}
      crumbs={[{ label: "Giới thiệu", href: "/about" }, { label: "Điểm khác biệt" }]}
      glyph="异"
    />

    <section class="bg-background">
      <div class="container mx-auto px-6">
        <div class="flex flex-col gap-6">
          {
            valuePanels.map((v, i) => (
              <article class="grid overflow-hidden rounded-[2rem] border border-border bg-background lg:grid-cols-2">
                <div
                  class:list={[
                    "flex flex-col justify-center p-8 sm:p-10 lg:p-14",
                    i % 2 === 1 && "lg:order-last",
                  ]}
                >
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="inline-flex items-center rounded-full bg-brand-ink-900 px-4 py-2 text-[0.6875rem] font-bold uppercase tracking-widest text-white">
                      {v.badge}
                    </span>
                    <span class="text-[0.6875rem] font-bold uppercase tracking-widest text-muted-foreground">
                      0{i + 1}
                    </span>
                  </div>

                  <h2 class="mt-6 max-w-md text-2xl font-black leading-tight text-brand-ink-900 sm:text-3xl">
                    {v.title}
                  </h2>

                  <p class="mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">
                    {v.desc}
                  </p>

                  <div class="mt-8 max-w-md border-t border-border pt-6">
                    <p class="text-lg font-black leading-none text-brand-ink-900">
                      {v.strong}
                    </p>
                    <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                      {v.note}
                    </p>
                  </div>
                </div>

                <div
                  class:list={[
                    "relative order-first min-h-56 lg:order-0 lg:min-h-96",
                    (v.contain || v.devices) && "bg-brand-ink-50 p-6 lg:p-10",
                  ]}
                >
                  {v.devices ? (
                    <div class="flex h-full items-center justify-center gap-3 sm:gap-5">
                      {v.devices.map((device, k) => (
                        <div
                          class:list={[
                            "w-1/2 max-w-52 overflow-hidden rounded-[1.5rem] border-[6px] border-brand-ink-900 bg-brand-ink-900 shadow-[0_28px_60px_-32px_rgb(17_24_39/0.6)]",
                            k === 0
                              ? "-rotate-6 translate-y-6"
                              : "rotate-3 -translate-y-2",
                          ]}
                        >
                          <Image
                            src={device}
                            alt={`Ứng dụng học tập SaigonHSK — màn hình ${k + 1}`}
                            width={430}
                            densities={[1, 2]}
                            format="webp"
                            quality={80}
                            loading="lazy"
                            decoding="async"
                            class="block w-full"
                          />
                        </div>
                      ))}
                    </div>
                  ) : typeof v.image === "string" ? (
                    <img
                      src={v.image}
                      alt={v.title}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 size-full object-cover"
                    />
                  ) : (
                    <Image
                      src={v.image}
                      alt={`${v.title} — ${v.note}`}
                      width={720}
                      densities={[1, 2]}
                      format="webp"
                      quality={78}
                      loading="lazy"
                      decoding="async"
                      class="size-full rounded-2xl object-contain"
                    />
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-background">
      <div class="container mx-auto px-6">
        <SectionHeading
          title="Mô hình đào tạo"
          highlight="tám điều học viên nhận được"
          description="Áp dụng cho mọi khoá học tại trung tâm, không phân biệt lớp nhóm hay lớp VIP."
        />

        <ul
          class="mt-10 grid gap-px overflow-hidden rounded-3xl border border-border bg-border sm:grid-cols-2"
        >
          {
            model.map((m) => (
              <li class="flex items-start gap-3 bg-background p-6">
                <span
                  class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-emerald-500 text-white [&>svg]:size-3.5"
                  set:html={ICONS.check}
                />
                <span class="text-sm font-medium leading-relaxed text-foreground/85">
                  {m}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <RegisterSection />
    <CtaSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
