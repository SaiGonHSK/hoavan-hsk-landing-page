---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import Testimonials from "@/components/Testimonials.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { testimonials } from "@/data/testimonials";

const origin = Astro.site?.origin ?? "";
/** Đánh dấu từng phản hồi là Review để Google hiểu đây là ý kiến học viên thật. */
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Cảm nhận của học viên Hoa văn SaigonHSK",
    numberOfItems: testimonials.length,
    itemListElement: testimonials.map((t, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Review",
        author: { "@type": "Person", name: t.name },
        reviewBody: t.quote,
        itemReviewed: { "@id": `${origin}/#organization` },
      },
    })),
  },
];
---

<Layout
  title="Học viên cảm nhận và đánh giá về SaigonHSK"
  description="Cảm nhận của sinh viên và học viên đã học tiếng Trung, luyện thi HSK và TOCFL tại Trung tâm Hoa văn SaigonHSK TP.HCM."
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <PageHero
      title="Học viên cảm nhận và đánh giá"
      description="Phản hồi được trung tâm ghi lại từ học viên các trường đại học tại TP.HCM sau khi hoàn thành khoá học."
      crumbs={[{ label: "Giới thiệu", href: "/about" }, { label: "Cảm nhận học viên" }]}
      glyph="评"
    />
    <Testimonials />
    <RegisterSection />
    <CtaSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
