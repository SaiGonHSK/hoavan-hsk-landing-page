---
import CatalogDetail from "@/components/CatalogDetail.astro";
import { textbookCourses } from "@/data/catalog";

export function getStaticPaths() {
  return textbookCourses.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;

const related = textbookCourses
  .filter((c) => c.slug !== item.slug)
  .map((c) => ({ label: c.title, href: `/courses/textbooks/${c.slug}` }));
---

<CatalogDetail
  courseSchema
  title={item.title}
  summary={item.summary}
  intro={item.intro}
  facts={item.facts}
  content={item.content}
  contentTitle="Nội dung khoá học"
  outcomes={item.outcomes}
  glyph="书"
  crumbs={[
    { label: "Các khoá học", href: "/courses" },
    { label: "Theo giáo trình", href: "/courses/textbooks" },
    { label: item.title },
  ]}
  related={related}
  relatedTitle="Giáo trình khác"
  cta="enroll"
/>
