---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import EnrollCta from "@/components/EnrollCta.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { courses } from "@/data/courses";
import { schedule } from "@/data/schedule";
import { teachers } from "@/data/teachers";
import { testimonials } from "@/data/testimonials";
import { content } from "@/data/content";
import { contact, site } from "@/data/site";
import { ICONS } from "@/lib/icons";
import {
  clampDescription,
  courseSchema,
  faqSchema,
  keywordsFor,
  pickTitle,
  toIsoDuration,
} from "@/lib/seo";

export function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;

const origin = Astro.site?.origin ?? "";
const url = `${origin}${Astro.url.pathname}`;

/**
 * Các trang này có dữ liệu chi tiết nhất trên site (thời lượng, giáo trình, chuẩn
 * đầu ra của từng cấp lớp) nhưng trước đây không phát ra structured data nào. Mỗi
 * cấp lớp trở thành một CourseInstance để Google hiểu khoá có nhiều lớp.
 */
const schemas: Record<string, unknown>[] = [
  {
    ...courseSchema({
      name: course.title,
      description: course.summary,
      url,
      origin,
      provider: { name: site.fullName, address: contact.address },
      workload: course.levels[0]?.duration?.[0],
      level: course.entry,
      credential: course.goal.match(/HSK\s?[1-6]/i)?.[0].replace(/\s+/g, ""),
    }),
    ...(course.levels.length
      ? {
          hasCourseInstance: course.levels.map((level) => {
            const workload = toIsoDuration(level.duration?.[0]);
            return {
              "@type": "CourseInstance",
              name: level.name,
              ...(level.code ? { courseCode: level.code } : {}),
              courseMode: ["Onsite", "Online"],
              ...(workload ? { courseWorkload: workload } : {}),
              location: {
                "@type": "Place",
                name: site.fullName,
                address: contact.address,
              },
            };
          }),
        }
      : {}),
  },
];

// FAQ lấy từ chính dữ liệu khoá học, trả lời đúng ba câu người học hỏi nhiều nhất:
// học bao lâu, đầu vào cần gì, học phí bao nhiêu.
const faqs = [
  ...(course.levels[0]?.duration?.length
    ? [
        {
          question: `Khoá ${course.title} học trong bao lâu?`,
          answer: `${course.levels[0].duration[0]} Khoá gồm ${course.levels.length} lớp theo cấp độ, học viên có thể vào đúng cấp của mình sau khi test trình độ.`,
        },
      ]
    : []),
  {
    question: `Cần trình độ gì để học ${course.title}?`,
    answer: `Đầu vào của khoá: ${course.entry}. Trung tâm test trình độ miễn phí trước khi xếp lớp để bạn không phải học lại phần đã biết.`,
  },
  {
    question: `Học phí khoá ${course.title} bao nhiêu?`,
    answer: `Học phí tuỳ hình thức lớp (lớp nhóm 10–15 học viên, VIP 1 kèm 1, lớp doanh nghiệp) và cấp lớp bạn vào. Gọi ${contact.phonePrimary} hoặc nhắn Zalo để nhận bảng học phí và lịch khai giảng mới nhất.`,
  },
];

schemas.push(faqSchema(faqs));

const blocks = [
  { key: "audience", label: "Đối tượng", icon: ICONS.users },
  { key: "goals", label: "Mục tiêu", icon: ICONS.target },
  { key: "duration", label: "Thời lượng", icon: ICONS.clock },
  { key: "content", label: "Nội dung học", icon: ICONS.book },
  { key: "materials", label: "Giáo trình", icon: ICONS.sparkle },
  { key: "outcomes", label: "Chuẩn đầu ra", icon: ICONS.shield },
] as const;

const others = courses.filter((c) => c.slug !== course.slug).slice(0, 4);

/* ---------- Dữ liệu suy ra cho các khối mới ---------- */

/** Tổng buổi/giờ của cả khoá, lấy từ chuỗi thời lượng của từng cấp lớp. */
const firstNumber = (text: string, re: RegExp) => {
  const m = text.match(re);
  return m ? Number(m[1]) : 0;
};
const parsed = course.levels.map((level) => {
  const text = (level.duration ?? []).join(" ");
  return {
    sessions: firstNumber(text, /(\d+)\s*buổi/i),
    hours: firstNumber(text, /(\d+)\s*giờ/i),
  };
});
const sum = (key: "sessions" | "hours") =>
  parsed.reduce((acc, p) => acc + p[key], 0);
/** Chỉ cộng khi mọi cấp lớp đều đọc được số — thiếu một lớp là tổng sai. */
const totals = {
  sessions: parsed.every((p) => p.sessions > 0) ? sum("sessions") : 0,
  hours: parsed.every((p) => p.hours > 0) ? sum("hours") : 0,
};
const totalsLabel = [
  totals.sessions > 0 ? `${totals.sessions} buổi` : "",
  totals.hours > 0 ? `${totals.hours} giờ học` : "",
]
  .filter(Boolean)
  .join(" · ");

/** "Bạn sẽ đạt được gì" — gom chuẩn đầu ra của mọi cấp lớp, bỏ trùng. */
const benefits = [
  ...new Set(course.levels.flatMap((level) => level.outcomes ?? [])),
].slice(0, 6);

/** Bốn thành phần của khoá, theo đúng dữ liệu khoá đang mở. */
const includes = [
  {
    icon: ICONS.cap,
    title:
      course.levels.length > 0
        ? `${course.levels.length} lớp theo cấp độ`
        : "Lộ trình riêng theo học viên",
    desc: "Test trình độ miễn phí trước khi xếp lớp, vào đúng cấp của bạn — không học lại phần đã biết.",
  },
  {
    icon: ICONS.clock,
    title:
      totalsLabel ||
      course.levels[0]?.duration?.[0] ||
      "Thời lượng linh hoạt",
    desc: "Lớp tối và cuối tuần, hình thức offline tại TP.HCM hoặc online — chọn nhịp học phù hợp lịch của bạn.",
  },
  {
    icon: ICONS.book,
    title: "Giáo trình biên soạn riêng",
    desc:
      course.levels[0]?.materials?.[0] ??
      "Giáo trình chuyên biệt do giảng viên trình độ Thạc sĩ, Tiến sĩ của trung tâm biên soạn lại.",
  },
  {
    icon: ICONS.shield,
    title: "Cam kết 100% đầu ra",
    desc: `Mục tiêu khoá: ${course.goal}. Chưa đạt đầu ra đã cam kết, học viên được học lại hoàn toàn miễn phí.`,
  },
];

/** Các lớp đang mở của đúng khoá này. */
const classes = schedule.filter((row) => row.courseSlug === course.slug);

/** Giảng viên: người phụ trách chuyên môn lên đầu. */
const isLead = (t: (typeof teachers)[number]) =>
  Number(Boolean((t as { lead?: boolean }).lead));
const staff = [...teachers].sort((a, b) => isLead(b) - isLead(a)).slice(0, 3);

/** Cảm nhận học viên: ưu tiên review nhắc đúng chứng chỉ của khoá. */
const keyword = course.goal.match(/HSK\s?[1-6]/i)?.[0] ?? "";
const reviews = [
  ...testimonials.filter((t) => keyword && t.quote.includes(keyword)),
  ...testimonials.filter((t) => !keyword || !t.quote.includes(keyword)),
].slice(0, 3);

const commitments = content.commitments;

const heroFacts = [
  { label: "Mục tiêu", value: course.goal },
  { label: "Đầu vào", value: course.entry },
  {
    label: "Hình thức",
    value: "Offline TP.HCM & Online",
  },
];
---

<Layout
  title={pickTitle(
    `Khoá ${course.title} tại TPHCM — ${course.goal} | ${site.shortName}`,
    `Khoá ${course.title} tại TPHCM | ${site.shortName}`,
    `${course.title} tại TPHCM | ${site.shortName}`,
    `${course.title} | ${site.shortName}`,
  )}
  description={clampDescription(
    `Khoá ${course.title} tại TP.HCM: ${course.summary} Mục tiêu ${course.goal.toLowerCase()}, đầu vào ${course.entry.toLowerCase()}. Lớp 10–15 học viên, cam kết đầu ra — gọi hotline nhận học phí.`,
  )}
  keywords={keywordsFor(
    `${course.title} TPHCM`,
    `học ${course.title.toLowerCase()}`,
    `học phí ${course.title.toLowerCase()}`,
  )}
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 pb-16 lg:gap-24 lg:pb-24">
    <PageHero
      title={course.title}
      description={course.summary}
      crumbs={[{ label: "Khóa học", href: "/courses" }, { label: course.title }]}
      glyph="课"
    >
      <div class="mt-7 flex flex-wrap gap-2.5">
        {
          course.tags.map((t) => (
            <span class="inline-flex items-center gap-2 rounded-lg border border-border bg-background px-3.5 py-2 text-xs font-bold text-brand-ink-900">
              <span
                class="text-brand-red-600 [&>svg]:size-3.5"
                set:html={ICONS.check}
              />
              {t}
            </span>
          ))
        }
      </div>

      <dl class="mt-8 grid max-w-3xl gap-4 sm:grid-cols-3">
        {
          heroFacts.map((f) => (
            <div class="rounded-lg border border-border bg-background p-4">
              <dt class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-muted-foreground">
                {f.label}
              </dt>
              <dd class="mt-1.5 text-sm font-bold leading-snug text-brand-ink-900">
                {f.value}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/register"
          class="group inline-flex items-center gap-2 rounded-full bg-brand-red-600 px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-brand-red-600/25 transition-all hover:-translate-y-0.5 hover:bg-brand-red-700"
        >
          Đăng ký khóa này
          <span
            class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
            set:html={ICONS.arrow}
          />
        </a>
        <a
          href={`tel:${contact.phonePrimaryRaw}`}
          class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-6 py-3.5 text-sm font-bold text-brand-ink-900 transition-all hover:-translate-y-0.5 hover:bg-brand-ink-50"
        >
          <span class="text-brand-red-600 [&>svg]:size-4" set:html={ICONS.phone} />
          {contact.phonePrimary}
        </a>
        <a
          href="#lop-dang-mo"
          class="inline-flex items-center gap-2 px-2 py-3.5 text-sm font-bold text-brand-ink-700 underline decoration-brand-ink-300 underline-offset-4 transition-colors hover:text-brand-red-600"
        >
          Xem lớp đang mở
        </a>
      </div>
    </PageHero>

    {/* 1 — Học xong bạn làm được gì */}
    {
      benefits.length > 0 && (
        <section id="dau-ra" class="scroll-mt-24">
          <div class="container mx-auto px-6">
            <p class="text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-brand-red-600">
              Chuẩn đầu ra
            </p>
            <h2 class="mt-3 max-w-3xl text-[1.75rem] font-black leading-tight tracking-tight text-brand-ink-900 md:text-4xl">
              Hoàn thành khoá {course.title.toLowerCase()}, bạn{" "}
              <span class="text-brand-red-600">làm được gì</span>
            </h2>

            <ul class="mt-8 grid gap-x-10 gap-y-4 md:grid-cols-2">
              {benefits.map((b) => (
                <li class="flex items-start gap-3">
                  <span
                    class="mt-0.5 shrink-0 rounded-md bg-brand-red-50 p-1.5 text-brand-red-600 [&>svg]:size-3.5"
                    set:html={ICONS.check}
                  />
                  <span class="text-sm leading-relaxed text-brand-ink-700">
                    {b}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {/* 2 — Khoá học gồm những gì */}
    <section id="gom-gi" class="scroll-mt-24">
      <div class="container mx-auto px-6">
        <p
          class="text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-brand-red-600"
        >
          Thành phần khoá học
        </p>
        <h2
          class="mt-3 text-[1.75rem] font-black leading-tight tracking-tight text-brand-ink-900 md:text-4xl"
        >
          Khoá học <span class="text-brand-red-600">gồm những gì</span>
        </h2>

        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            includes.map((item) => (
              <div class="flex flex-col rounded-lg border border-border bg-background p-6">
                <span
                  class="text-brand-red-600 [&>svg]:size-6"
                  set:html={item.icon}
                />
                <h3 class="mt-4 text-base font-black leading-snug text-brand-ink-900">
                  {item.title}
                </h3>
                <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* 3 — Nội dung chi tiết từng cấp lớp (accordion) */}
    <section id="noi-dung" class="scroll-mt-24">
      <div class="container mx-auto px-6">
        {
          course.levels.length === 0 ? (
            <div class="rounded-lg border border-border bg-background p-8 md:p-10">
              <h2 class="text-2xl font-black text-brand-ink-900">
                Thông tin khóa học
              </h2>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
                {course.note}
              </p>
              <div class="mt-7 flex flex-wrap gap-3">
                <a
                  href={`tel:${contact.phonePrimaryRaw}`}
                  class="inline-flex items-center gap-2 rounded-full bg-brand-red-600 px-6 py-3.5 text-sm font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-brand-red-700"
                >
                  <span class="[&>svg]:size-4" set:html={ICONS.phone} />
                  Gọi {contact.phonePrimary}
                </a>
                <a
                  href={contact.zalo}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-3.5 text-sm font-bold text-brand-ink-900 transition-all hover:-translate-y-0.5 hover:bg-brand-ink-50"
                >
                  Chat Zalo
                </a>
              </div>
            </div>
          ) : (
            <>
              <p class="text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-brand-red-600">
                Lộ trình học
              </p>
              <div class="mt-3 flex flex-col justify-between gap-4 md:flex-row md:items-end">
                <h2 class="text-[1.75rem] font-black leading-tight tracking-tight text-brand-ink-900 md:text-4xl">
                  Nội dung <span class="text-brand-red-600">chi tiết từng lớp</span>
                </h2>
                <p class="text-sm font-bold text-brand-ink-700">
                  {course.levels.length} lớp
                  {totalsLabel ? ` · ${totalsLabel}` : ""}
                </p>
              </div>

              <div class="mt-8 space-y-3">
                {course.levels.map((level, i) => (
                  <details
                    class="group overflow-hidden rounded-lg border border-border bg-background open:border-brand-ink-300"
                    open={i === 0}
                  >
                    <summary class="flex cursor-pointer list-none items-center gap-4 px-5 py-5 md:px-7">
                      <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-brand-red-600 text-sm font-black text-white">
                        {String(i + 1).padStart(2, "0")}
                      </span>

                      <div class="min-w-0 flex-1">
                        <h3 class="text-lg font-black leading-snug text-brand-ink-900">
                          {level.name}
                        </h3>
                        <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-medium text-muted-foreground">
                          {level.code && (
                            <span class="rounded-md bg-brand-red-50 px-2 py-0.5 font-mono font-bold text-brand-red-700">
                              {level.code}
                            </span>
                          )}
                          {level.duration?.[0] && <span>{level.duration[0]}</span>}
                        </p>
                      </div>

                      <span
                        class="shrink-0 text-brand-ink-400 [&>svg]:size-4 [&>svg]:transition-transform group-open:[&>svg]:rotate-180"
                        set:html={ICONS.chevron}
                      />
                    </summary>

                    <div class="grid gap-x-10 gap-y-8 border-t border-border px-5 py-7 md:grid-cols-2 md:px-7">
                      {blocks.map((b) => {
                        const items = level[b.key];
                        if (!items || items.length === 0) return null;
                        return (
                          <section>
                            <h4 class="flex items-center gap-2 text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-brand-red-700">
                              <span
                                class="[&>svg]:size-3.5"
                                set:html={b.icon}
                              />
                              {b.label}
                            </h4>
                            <ul class="mt-3.5 space-y-2.5">
                              {items.map((it) => (
                                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted-foreground">
                                  <span class="mt-[11px] h-px w-3 shrink-0 bg-border" />
                                  <span>{it}</span>
                                </li>
                              ))}
                            </ul>
                          </section>
                        );
                      })}
                    </div>
                  </details>
                ))}
              </div>
            </>
          )
        }
      </div>
    </section>

    {/* 4 — Giảng viên */}
    <section id="giang-vien" class="scroll-mt-24">
      <div class="container mx-auto px-6">
        <p
          class="text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-brand-red-600"
        >
          Đội ngũ
        </p>
        <h2
          class="mt-3 text-[1.75rem] font-black leading-tight tracking-tight text-brand-ink-900 md:text-4xl"
        >
          Ai dạy khoá <span class="text-brand-red-600">này</span>
        </h2>

        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            staff.map((t) => (
              <article class="flex gap-4 rounded-lg border border-border bg-background p-5">
                <img
                  src={t.image}
                  alt={t.name}
                  width="160"
                  height="160"
                  loading="lazy"
                  decoding="async"
                  class="size-20 shrink-0 rounded-lg object-cover"
                />
                <div class="min-w-0">
                  <h3 class="text-base font-black leading-snug text-brand-ink-900">
                    {t.name}
                  </h3>
                  <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                    {t.title}
                  </p>
                  {(t as { role?: string }).role && (
                    <p class="mt-2 text-xs font-bold leading-relaxed text-brand-red-700">
                      {(t as { role?: string }).role}
                    </p>
                  )}
                </div>
              </article>
            ))
          }
        </div>

        <a
          href="/about/teachers"
          class="group mt-6 inline-flex items-center gap-2 text-sm font-bold text-brand-ink-900 transition-colors hover:text-brand-red-600"
        >
          Xem toàn bộ giảng viên
          <span
            class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
            set:html={ICONS.arrow}
          />
        </a>
      </div>
    </section>

    {/* 5 — Cảm nhận học viên */}
    {
      reviews.length > 0 && (
        <section id="cam-nhan" class="scroll-mt-24">
          <div class="container mx-auto px-6">
            <p class="text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-brand-red-600">
              Học viên nói gì
            </p>
            <h2 class="mt-3 text-[1.75rem] font-black leading-tight tracking-tight text-brand-ink-900 md:text-4xl">
              Người học <span class="text-brand-red-600">trước bạn</span>
            </h2>

            <div class="mt-8 grid gap-5 md:grid-cols-3">
              {reviews.map((r) => (
                <figure class="flex flex-col rounded-lg border border-border bg-background p-6">
                  <blockquote class="flex-1 text-sm leading-relaxed text-brand-ink-700">
                    “{r.quote}”
                  </blockquote>
                  <figcaption class="mt-5 border-t border-border pt-4">
                    <p class="text-sm font-black text-brand-ink-900">{r.name}</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">{r.role}</p>
                  </figcaption>
                </figure>
              ))}
            </div>

            <a
              href="/about/reviews"
              class="group mt-6 inline-flex items-center gap-2 text-sm font-bold text-brand-ink-900 transition-colors hover:text-brand-red-600"
            >
              Xem thêm cảm nhận học viên
              <span
                class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
                set:html={ICONS.arrow}
              />
            </a>
          </div>
        </section>
      )
    }

    {/* 6 — Lớp đang mở + đăng ký */}
    <section id="lop-dang-mo" class="scroll-mt-24">
      <div class="container mx-auto px-6">
        <p
          class="text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-brand-red-600"
        >
          Lịch khai giảng
        </p>
        <h2
          class="mt-3 text-[1.75rem] font-black leading-tight tracking-tight text-brand-ink-900 md:text-4xl"
        >
          Lớp <span class="text-brand-red-600">đang nhận đăng ký</span>
        </h2>

        {
          classes.length > 0 ? (
            <div class="mt-8 overflow-x-auto rounded-lg border border-border">
              <table class="w-full min-w-[42rem] border-collapse text-left">
                <thead class="bg-brand-ink-50">
                  <tr class="text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-muted-foreground">
                    <th class="px-5 py-4">Mã lớp</th>
                    <th class="px-5 py-4">Lớp</th>
                    <th class="px-5 py-4">Nhịp học</th>
                    <th class="px-5 py-4">Thời lượng</th>
                    <th class="px-5 py-4">Đầu ra</th>
                    <th class="px-5 py-4" />
                  </tr>
                </thead>
                <tbody>
                  {classes.map((row) => (
                    <tr class="border-t border-border align-top">
                      <td class="px-5 py-4">
                        <span class="rounded-md bg-brand-red-50 px-2.5 py-1 font-mono text-[0.6875rem] font-bold text-brand-red-700">
                          {row.code}
                        </span>
                      </td>
                      <td class="px-5 py-4 text-sm font-bold text-brand-ink-900">
                        {row.className}
                      </td>
                      <td class="px-5 py-4 text-sm leading-relaxed text-muted-foreground">
                        {row.cadence}
                      </td>
                      <td class="px-5 py-4 text-sm leading-relaxed text-muted-foreground">
                        {row.duration}
                      </td>
                      <td class="px-5 py-4 text-sm font-bold text-brand-ink-900">
                        {row.target}
                      </td>
                      <td class="px-5 py-4 text-right">
                        <a
                          href="/register"
                          class="inline-flex shrink-0 rounded-full bg-brand-red-600 px-4 py-2 text-xs font-bold text-white transition-transform hover:-translate-y-0.5"
                        >
                          Đăng ký
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="mt-8 rounded-lg border-2 border-dashed border-border bg-brand-ink-50/60 p-8 text-center">
              <p class="text-base font-black text-brand-ink-900">
                Lớp {course.title.toLowerCase()} mở theo nhu cầu học viên
              </p>
              <p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-muted-foreground">
                Gọi hotline để nhận ngày khai giảng gần nhất và giữ chỗ — trung
                tâm xếp lớp ngay khi đủ học viên cùng trình độ.
              </p>
              <a
                href={`tel:${contact.phonePrimaryRaw}`}
                class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand-red-600 px-6 py-3.5 text-sm font-bold text-white transition-transform hover:-translate-y-0.5"
              >
                <span class="[&>svg]:size-4" set:html={ICONS.phone} />
                Gọi {contact.phonePrimary}
              </a>
            </div>
          )
        }

        <a
          href="/schedule"
          class="group mt-6 inline-flex items-center gap-2 text-sm font-bold text-brand-ink-900 transition-colors hover:text-brand-red-600"
        >
          Xem lịch khai giảng toàn bộ chương trình
          <span
            class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
            set:html={ICONS.arrow}
          />
        </a>
      </div>
    </section>

    {/* 7 — CTA ghi danh sớm */}
    <EnrollCta
      subtitle={`chọn đúng lớp ${course.title}, đúng nhịp học`}
      lines={[
        "Test trình độ đầu vào miễn phí, xếp lớp đúng sức học",
        `Cam kết đầu ra: ${course.goal} — không đạt, học lại miễn phí`,
      ]}
    />

    {/* 8 — Vì sao chọn trung tâm */}
    <section id="cam-ket" class="scroll-mt-24">
      <div class="container mx-auto px-6">
        <div class="rounded-lg border border-border bg-brand-ink-50/60 p-7 md:p-10">
          <p
            class="text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-brand-red-600"
          >
            Cam kết của {site.shortName}
          </p>
          <h2
            class="mt-3 text-[1.75rem] font-black leading-tight tracking-tight text-brand-ink-900 md:text-4xl"
          >
            Học tại đây, bạn được{" "}
            <span class="text-brand-red-600">bảo đảm điều gì</span>
          </h2>

          <div class="mt-8 grid gap-5 md:grid-cols-3">
            {
              commitments.map((c) => (
                <div class="rounded-lg border border-border bg-background p-6">
                  <span
                    class="text-brand-red-600 [&>svg]:size-6"
                    set:html={ICONS[c.icon as keyof typeof ICONS] ?? ICONS.shield}
                  />
                  <h3 class="mt-4 text-base font-black leading-snug text-brand-ink-900">
                    {c.title}
                  </h3>
                  <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                    {c.desc}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* 9 — FAQ */}
    <section id="faq" class="scroll-mt-24">
      <div class="container mx-auto px-6">
        <p
          class="text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-brand-red-600"
        >
          Giải đáp
        </p>
        <h2
          class="mt-3 text-[1.75rem] font-black leading-tight tracking-tight text-brand-ink-900 md:text-4xl"
        >
          Câu hỏi thường gặp về khoá{" "}
          <span class="text-brand-red-600">{course.title.toLowerCase()}</span>
        </h2>

        <div class="mt-8 space-y-3">
          {
            faqs.map((f) => (
              <details class="group rounded-lg border border-border bg-background open:border-brand-ink-300">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 md:px-7">
                  <h3 class="text-sm font-black text-brand-ink-900 md:text-base">
                    {f.question}
                  </h3>
                  <span
                    class="shrink-0 text-brand-ink-400 [&>svg]:size-4 [&>svg]:transition-transform group-open:[&>svg]:rotate-180"
                    set:html={ICONS.chevron}
                  />
                </summary>
                <p class="border-t border-border px-5 py-4 text-sm leading-relaxed text-muted-foreground md:px-7">
                  {f.answer}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* 10 — Khoá học khác */}
    <section id="khoa-khac" class="scroll-mt-24">
      <div class="container mx-auto px-6">
        <h2
          class="text-[1.75rem] font-black leading-tight tracking-tight text-brand-ink-900 md:text-4xl"
        >
          Khóa học <span class="text-brand-red-600">khác</span>
        </h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            others.map((c) => (
              <a
                href={`/courses/programs/${c.slug}`}
                class="group flex flex-col rounded-lg border border-border bg-background p-5 transition-colors hover:border-brand-ink-300"
              >
                <span class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-brand-red-600">
                  {c.goal}
                </span>
                <p class="mt-2 text-base font-black leading-snug text-brand-ink-900">
                  {c.title}
                </p>
                <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                  {c.summary}
                </p>
                <span class="mt-auto flex items-center gap-2 pt-5 text-xs font-bold text-brand-red-600">
                  Xem chi tiết
                  <span
                    class="transition-transform group-hover:translate-x-1 [&>svg]:size-3.5"
                    set:html={ICONS.arrow}
                  />
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <RegisterSection />
  </main>

  {/* Thanh đăng ký dính đáy — chừa chỗ cho nút liên hệ nổi ở góc phải */}
  <div
    id="course-cta-bar"
    data-visible="false"
    class="pointer-events-none fixed inset-x-0 bottom-0 z-30 hidden translate-y-full border-t border-border bg-background/95 backdrop-blur transition-transform duration-300 data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 lg:block print:hidden"
  >
    <div
      class="container mx-auto flex items-center justify-between gap-6 px-6 py-3.5 pr-24"
    >
      <div class="min-w-0">
        <p class="truncate text-sm font-black text-brand-ink-900">
          {course.title}
        </p>
        <p class="mt-0.5 truncate text-xs text-muted-foreground">
          {course.goal} · {course.entry}
        </p>
      </div>

      <div class="flex shrink-0 items-center gap-3">
        <a
          href={`tel:${contact.phonePrimaryRaw}`}
          class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
        >
          <span class="text-brand-red-600 [&>svg]:size-4" set:html={ICONS.phone} />
          {contact.phonePrimary}
        </a>
        <a
          href="/register"
          class="inline-flex items-center gap-2 rounded-full bg-brand-red-600 px-6 py-2.5 text-sm font-bold text-white transition-transform hover:-translate-y-0.5"
        >
          Đăng ký khóa này
        </a>
      </div>
    </div>
  </div>

  <Footer />
  <FloatingContact />

  <script>
    /** Thanh CTA chỉ hiện sau khi người đọc rời khỏi hero — hero đã có CTA sẵn. */
    const bar = document.getElementById("course-cta-bar");
    if (bar) {
      const onScroll = () => {
        bar.dataset.visible = String(window.scrollY > 520);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    }
  </script>
</Layout>
