---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { courses } from "@/data/courses";
import { contact, site } from "@/data/site";
import { ICONS } from "@/lib/icons";
import {
  clampDescription,
  courseSchema,
  faqSchema,
  keywordsFor,
  pickTitle,
  toIsoDuration,
} from "@/lib/seo";

export function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;

const origin = Astro.site?.origin ?? "";
const url = `${origin}${Astro.url.pathname}`;

/**
 * Các trang này có dữ liệu chi tiết nhất trên site (thời lượng, giáo trình, chuẩn
 * đầu ra của từng cấp lớp) nhưng trước đây không phát ra structured data nào. Mỗi
 * cấp lớp trở thành một CourseInstance để Google hiểu khoá có nhiều lớp.
 */
const schemas: Record<string, unknown>[] = [
  {
    ...courseSchema({
      name: course.title,
      description: course.summary,
      url,
      origin,
      provider: { name: site.fullName, address: contact.address },
      workload: course.levels[0]?.duration?.[0],
      level: course.entry,
      credential: course.goal.match(/HSK\s?[1-6]|TOCFL/i)?.[0].replace(/\s+/g, ""),
    }),
    ...(course.levels.length
      ? {
          hasCourseInstance: course.levels.map((level) => {
            const workload = toIsoDuration(level.duration?.[0]);
            return {
              "@type": "CourseInstance",
              name: level.name,
              ...(level.code ? { courseCode: level.code } : {}),
              courseMode: ["Onsite", "Online"],
              ...(workload ? { courseWorkload: workload } : {}),
              location: {
                "@type": "Place",
                name: site.fullName,
                address: contact.address,
              },
            };
          }),
        }
      : {}),
  },
];

// FAQ lấy từ chính dữ liệu khoá học, trả lời đúng ba câu người học hỏi nhiều nhất:
// học bao lâu, đầu vào cần gì, học phí bao nhiêu.
const faqs = [
  ...(course.levels[0]?.duration?.length
    ? [
        {
          question: `Khoá ${course.title} học trong bao lâu?`,
          answer: `${course.levels[0].duration[0]} Khoá gồm ${course.levels.length} lớp theo cấp độ, học viên có thể vào đúng cấp của mình sau khi test trình độ.`,
        },
      ]
    : []),
  {
    question: `Cần trình độ gì để học ${course.title}?`,
    answer: `Đầu vào của khoá: ${course.entry}. Trung tâm test trình độ miễn phí trước khi xếp lớp để bạn không phải học lại phần đã biết.`,
  },
  {
    question: `Học phí khoá ${course.title} bao nhiêu?`,
    answer: `Học phí tuỳ hình thức lớp (lớp nhóm 10–15 học viên, VIP 1 kèm 1, lớp doanh nghiệp) và cấp lớp bạn vào. Gọi ${contact.phonePrimary} hoặc nhắn Zalo để nhận bảng học phí và lịch khai giảng mới nhất.`,
  },
];

schemas.push(faqSchema(faqs));

const blocks = [
  { key: "audience", label: "Đối tượng", icon: ICONS.users },
  { key: "goals", label: "Mục tiêu", icon: ICONS.target },
  { key: "duration", label: "Thời lượng", icon: ICONS.clock },
  { key: "content", label: "Nội dung học", icon: ICONS.book },
  { key: "materials", label: "Giáo trình", icon: ICONS.sparkle },
  { key: "outcomes", label: "Chuẩn đầu ra", icon: ICONS.shield },
] as const;

const others = courses.filter((c) => c.slug !== course.slug).slice(0, 4);
---

<Layout
  title={pickTitle(
    `Khoá ${course.title} tại TPHCM — ${course.goal} | ${site.shortName}`,
    `Khoá ${course.title} tại TPHCM | ${site.shortName}`,
    `${course.title} tại TPHCM | ${site.shortName}`,
    `${course.title} | ${site.shortName}`,
  )}
  description={clampDescription(
    `Khoá ${course.title} tại TP.HCM: ${course.summary} Mục tiêu ${course.goal.toLowerCase()}, đầu vào ${course.entry.toLowerCase()}. Lớp 10–15 học viên, cam kết đầu ra — gọi hotline nhận học phí.`,
  )}
  keywords={keywordsFor(
    `${course.title} TPHCM`,
    `học ${course.title.toLowerCase()}`,
    `học phí ${course.title.toLowerCase()}`,
  )}
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 pb-16 lg:gap-24 lg:pb-24">
    <PageHero
      title={course.title}
      description={course.summary}
      crumbs={[{ label: "Khóa học", href: "/courses" }, { label: course.title }]}
      glyph="课"
    >
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/register"
          class="group inline-flex items-center gap-2 rounded-xl bg-brand-red-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-brand-red-600/25 transition-all hover:-translate-y-0.5 hover:bg-brand-red-700"
        >
          Đăng ký khóa này
          <span
            class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
            set:html={ICONS.arrow}
          />
        </a>
        <a
          href={`tel:${contact.phonePrimaryRaw}`}
          class="inline-flex items-center gap-2 rounded-xl border border-border bg-background/70 px-5 py-3 text-sm font-bold text-foreground backdrop-blur transition-all hover:-translate-y-0.5"
        >
          <span class="text-brand-red-600 [&>svg]:size-4" set:html={ICONS.phone} />
          {contact.phonePrimary}
        </a>
      </div>
    </PageHero>

    <section>
      <div class="container mx-auto px-6">
        <div class="grid gap-5 md:grid-cols-3">
          {
            [
              { label: "Mục tiêu khóa học", value: course.goal },
              { label: "Trình độ đầu vào", value: course.entry },
              {
                label: "Số lớp trong khóa",
                value:
                  course.levels.length > 0
                    ? `${course.levels.length} lớp theo cấp độ`
                    : "Lộ trình theo học viên",
              },
            ].map((item) => (
              <div class="rounded-3xl border border-border/80 bg-card p-6">
                <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-muted-foreground">
                  {item.label}
                </p>
                <p class="mt-2 text-lg font-extrabold text-foreground">
                  {item.value}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section>
      <div class="container mx-auto px-6">
        {
          course.levels.length === 0 ? (
            <div class="rounded-3xl border border-border/80 bg-card p-8 md:p-10">
              <h2 class="text-2xl font-extrabold text-foreground">
                Thông tin khóa học
              </h2>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
                {course.note}
              </p>
              <div class="mt-7 flex flex-wrap gap-3">
                <a
                  href={`tel:${contact.phonePrimaryRaw}`}
                  class="inline-flex items-center gap-2 rounded-xl bg-brand-red-600 px-5 py-3 text-sm font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-brand-red-700"
                >
                  <span class="[&>svg]:size-4" set:html={ICONS.phone} />
                  Gọi {contact.phonePrimary}
                </a>
                <a
                  href={contact.zalo}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-2 rounded-xl border border-border px-5 py-3 text-sm font-bold text-foreground transition-all hover:-translate-y-0.5"
                >
                  Chat Zalo
                </a>
              </div>
            </div>
          ) : (
            <div class="space-y-6">
              {course.levels.map((level, i) => (
                <article class="overflow-hidden rounded-3xl border border-border/80 bg-card">
                  <header class="flex flex-wrap items-center gap-4 border-b border-border/70 bg-brand-red-50/60 px-6 py-5 md:px-8">
                    <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-red-600 text-base font-black text-white">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <div class="min-w-0">
                      <h2 class="text-xl font-extrabold text-foreground">
                        {level.name}
                      </h2>
                      {level.code && (
                        <p class="mt-0.5 font-mono text-xs font-bold text-brand-red-700">
                          Mã lớp: {level.code}
                        </p>
                      )}
                    </div>
                  </header>

                  <div class="grid gap-x-10 gap-y-8 px-6 py-7 md:grid-cols-2 md:px-8">
                    {blocks.map((b) => {
                      const items = level[b.key];
                      if (!items || items.length === 0) return null;
                      return (
                        <section>
                          <h3 class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand-red-700">
                            {b.label}
                          </h3>
                          <ul class="mt-3.5 space-y-2.5">
                            {items.map((it) => (
                              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted-foreground">
                                <span class="mt-[11px] h-px w-3 shrink-0 bg-border" />
                                <span>{it}</span>
                              </li>
                            ))}
                          </ul>
                        </section>
                      );
                    })}
                  </div>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <section>
      <div class="container mx-auto px-6">
        <h2 class="text-2xl font-black text-foreground md:text-3xl">
          Câu hỏi thường gặp về khoá {course.title}
        </h2>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {
            faqs.map((f) => (
              <div class="rounded-3xl border border-border/80 bg-card p-6">
                <h3 class="text-sm font-bold text-foreground">{f.question}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                  {f.answer}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section>
      <div class="container mx-auto px-6">
        <h2 class="text-2xl font-extrabold text-foreground">
          Khóa học khác
        </h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            others.map((c) => (
              <a
                href={`/courses/programs/${c.slug}`}
                class="group rounded-2xl border border-border/80 bg-card p-5 transition-all hover:-translate-y-1"
              >
                <p class="text-sm font-bold text-foreground transition-colors group-hover:text-brand-red-700">
                  {c.title}
                </p>
                <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                  {c.summary}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <RegisterSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
