---
import CatalogDetail from "@/components/CatalogDetail.astro";
import { reviewLevels } from "@/data/catalog";

export function getStaticPaths() {
  return reviewLevels.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;

const related = reviewLevels
  .filter((c) => c.slug !== item.slug)
  .map((c) => ({ label: c.title, href: `/practice/${c.slug}` }));
---

<CatalogDetail
  seoTitle={`${item.title} — từ vựng, ngữ pháp và đề | SaigonHSK`}
  title={item.title}
  summary={item.summary}
  intro={item.intro}
  facts={item.facts}
  content={item.content}
  contentTitle="Cấu trúc phần ôn tập"
  outcomes={item.outcomes}
  glyph="复"
  crumbs={[{ label: "Ôn tập & luyện thi", href: "/practice" }, { label: item.title }]}
  related={related}
  relatedTitle="Cấp độ khác"
/>
