---
import CatalogHub from "@/components/CatalogHub.astro";
import { reviewLevels, examPrepResources, skillTracks, trialClasses } from "@/data/catalog";
---

<CatalogHub
  title="Ôn tập & luyện thi HSK"
  description="Khu tự học của SaigonHSK: ôn lại từng cấp HSK theo bài, luyện đề theo cấp, luyện riêng bốn kỹ năng và đăng ký buổi học thử trải nghiệm."
  metaTitle="Ôn tập & luyện thi HSK online miễn phí"
  keywords="ôn tập tiếng Trung, on tap tieng trung, luyen thi hsk mien phi, tài liệu luyện thi HSK"
  crumbs={[{ label: "Ôn tập & luyện thi" }]}
  glyph="练"
  groups={[
    {
      title: "Ôn tập theo cấp HSK",
      desc: "Mỗi bài gồm từ vựng, ngữ pháp, đề HSK và bài kiểm tra định kỳ.",
      cards: reviewLevels.map((c) => ({
        title: c.title,
        summary: c.summary,
        href: `/practice/${c.slug}`,
      })),
    },
    {
      title: "Tài liệu luyện thi HSK",
      desc: "Bảng từ vựng, ngữ pháp trọng tâm và bộ đề luyện tự học cho từng cấp — khác với lớp luyện thi có giảng viên trong mục Các khoá học.",
      cards: examPrepResources.map((c) => ({
        title: c.title,
        summary: c.summary,
        href: `/practice/exam-prep/${c.slug}`,
      })),
    },
    {
      title: "Luyện 4 kỹ năng",
      desc: "Nghe – Nói – Đọc – Viết, luyện riêng theo từng cấp độ.",
      cards: skillTracks.map((c) => ({
        title: c.title,
        summary: c.summary,
        href: `/practice/skills/${c.slug}`,
      })),
      },
    {
      title: "Học thử miễn phí",
      desc: "Buổi học thử miễn phí kèm test trình độ và tư vấn lộ trình.",
      cards: trialClasses.map((c) => ({
        title: c.title,
        summary: c.summary,
        href: `/trial/${c.slug}`,
      })),
    },
  ]}
/>
