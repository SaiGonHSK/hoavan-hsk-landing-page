---
import CatalogHub from "@/components/CatalogHub.astro";
import { examPrepResources } from "@/data/catalog";
---

<CatalogHub
  title="Tài liệu luyện thi HSK các cấp"
  metaTitle="Tài liệu luyện thi HSK 3, 4, 5, 6 — từ vựng & đề"
  description="Tài liệu ôn thi HSK 3, 4, 5, 6 miễn phí: bảng từ vựng đầy đủ theo chủ đề, tổng hợp ngữ pháp trọng tâm và bộ đề luyện có đáp án để tự ôn trước kỳ thi."
  crumbs={[{ label: "Ôn tập & luyện thi", href: "/practice" }, { label: "Tài liệu luyện thi HSK" }]}
  glyph="考"
  columns={4}
  groups={[
    {
      title: "Chọn cấp độ cần luyện",
      cards: examPrepResources.map((c) => ({
        title: c.title,
        summary: c.summary,
        href: `/practice/exam-prep/${c.slug}`,
      })),
    },
  ]}
/>
